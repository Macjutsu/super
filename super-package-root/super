# Download or validate the previously cached SOFA feeds and cache settings. This is in a separate function to facilitate list caching and multiple run workflows.
# This also sets ${get_sofa_macos_feed_error}, ${get_sofa_safari_feed_error}, and ${get_sofa_safari_feed_error}.
get_sofa_feeds() {
	get_sofa_macos_feed_error="FALSE"
	get_sofa_apple_beta_feed_error="FALSE"
	get_sofa_safari_feed_error="FALSE"
	
	# Check SOFA macOS feed cache via HTTP ETag or download a new macOS feed.
	local sofa_macos_checksum && sofa_macos_checksum=$(get_pref "SOFAMacOSChecksum")
	local sofa_macos_cache_etag && sofa_macos_cache_etag=$(get_pref "SOFAMacOSETag")
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_macos_checksum is: ${sofa_macos_checksum}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_macos_cache_etag is: ${sofa_macos_cache_etag}"
	local sofa_macos_cache_etag_temp && sofa_macos_cache_etag_temp="$(mktemp -p "${SUPER_CACHES_FOLDER}").txt"
	if [[ -n "${sofa_macos_checksum}" ]] && [[ -n "${sofa_macos_cache_etag}" ]] && [[ -f "${SOFA_MACOS_CACHE_JSON}" ]]; then
		local sofa_macos_cache_etag_previous && sofa_macos_cache_etag_previous="$(mktemp -p "${SUPER_CACHES_FOLDER}").txt"
		echo "${sofa_macos_cache_etag}" > "${sofa_macos_cache_etag_previous}"
		log_super "SOFA: Validating macOS feed cache..."
		local curl_response && curl_response=$(curl --user-agent "${SUPER_USER_AGENT}" --write-out "%{http_code}" --max-time "${TIMEOUT_START_SECONDS}" --compressed --location "${sofa_macos_url}" --etag-compare "${sofa_macos_cache_etag_previous}" --etag-save "${sofa_macos_cache_etag_temp}" --output "${SOFA_MACOS_CACHE_JSON}" 2>&1)
		if [[ $(echo "${curl_response}" | tail -n 1 | grep -c '200') -gt 0 ]]; then # If the ETag had not changed then the last line of the ${curl_response} would contain '304'.
			log_super "SOFA: An updated macOS feed was downloaded."
			sofa_macos_cache_etag=$(cat "${sofa_macos_cache_etag_temp}")
		fi
		rm -Rf "${sofa_macos_cache_etag_previous}" > /dev/null 2>&1
	else
		log_super "SOFA: Downloading new macOS feed..."
		local curl_response && curl_response=$(curl --user-agent "${SUPER_USER_AGENT}" --write-out "%{http_code}" --max-time "${TIMEOUT_START_SECONDS}" --compressed --location "${sofa_macos_url}" --etag-save "${sofa_macos_cache_etag_temp}" --output "${SOFA_MACOS_CACHE_JSON}" 2>&1)
		sofa_macos_cache_etag=$(cat "${sofa_macos_cache_etag_temp}")
	fi
	rm -Rf "${sofa_macos_cache_etag_temp}" > /dev/null 2>&1
	
	# Verify the SOFA macOS feed download completed and is valid then save cache settings.
	if [[ $(echo "${curl_response}" | tail -n 1 | grep -c -E "${REGEX_HTTP_OK_STATUS}") -gt 0 ]] && [[ -f "${SOFA_MACOS_CACHE_JSON}" ]] && [[ -n "${sofa_macos_cache_etag}" ]]; then
		if [[ $(jq -r '.UpdateHash // empty' "${SOFA_MACOS_CACHE_JSON}" 2> /dev/null) ]]; then
			set_pref_main "SOFAMacOSChecksum" "$(md5 -q "${SOFA_MACOS_CACHE_JSON}" 2> /dev/null)"
			set_pref_main "SOFAMacOSETag" "${sofa_macos_cache_etag}"
		else
			get_sofa_macos_feed_error="TRUE" && log_super "SOFA Error: The downloaded macOS feed ${SOFA_MACOS_CACHE_JSON} appears to be invalid."
		fi
	elif [[ $(echo "${curl_response}" | grep -c 'Connection timed out') -gt 0 ]]; then
		get_sofa_macos_feed_error="TRUE" && log_super "SOFA Error: The macOS feed failed to verify or download, as indicated by no progress after waiting for ${TIMEOUT_START_SECONDS} seconds:\n${curl_response}"
	else
		get_sofa_macos_feed_error="TRUE" && log_super "SOFA Error: The macOS feed failed to download from: ${sofa_macos_url}:\n${curl_response}"
	fi
	unset curl_response
	if [[ "${get_sofa_macos_feed_error}" == "TRUE" ]]; then
		delete_pref_main "SOFAMacOSChecksum"
		delete_pref_main "SOFAMacOSETag"
		rm -f "${SOFA_MACOS_CACHE_JSON}" 2> /dev/null
	fi
	
	# If needed, check SOFA Apple beta feed cache via HTTP ETag or download a new Apple beta feed.
	if [[ "${system_macos_beta_enrollment}" != "FALSE" ]]; then
		local sofa_apple_beta_checksum && sofa_apple_beta_checksum=$(get_pref "SOFAAppleBetaChecksum")
		local sofa_apple_beta_cache_etag && sofa_apple_beta_cache_etag=$(get_pref "SOFAAppleBetaETag")
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_apple_beta_checksum is: ${sofa_apple_beta_checksum}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_apple_beta_cache_etag is: ${sofa_apple_beta_cache_etag}"
		local sofa_apple_beta_cache_etag_temp && sofa_apple_beta_cache_etag_temp="$(mktemp -p "${SUPER_CACHES_FOLDER}").txt"
		if [[ -n "${sofa_apple_beta_checksum}" ]] && [[ -n "${sofa_apple_beta_cache_etag}" ]] && [[ -f "${SOFA_APPLE_BETA_CACHE_JSON}" ]]; then
			local sofa_apple_beta_cache_etag_previous && sofa_apple_beta_cache_etag_previous="$(mktemp -p "${SUPER_CACHES_FOLDER}").txt"
			echo "${sofa_apple_beta_cache_etag}" > "${sofa_apple_beta_cache_etag_previous}"
			log_super "SOFA: Validating Apple beta feed cache..."
			local curl_response && curl_response=$(curl --user-agent "${SUPER_USER_AGENT}" --write-out "%{http_code}" --max-time "${TIMEOUT_START_SECONDS}" --compressed --location "${sofa_apple_beta_url}" --etag-compare "${sofa_apple_beta_cache_etag_previous}" --etag-save "${sofa_apple_beta_cache_etag_temp}" --output "${SOFA_APPLE_BETA_CACHE_JSON}" 2>&1)
			if [[ $(echo "${curl_response}" | tail -n 1 | grep -c '200') -gt 0 ]]; then # If the ETag had not changed then the last line of the ${curl_response} would contain '304'.
				log_super "SOFA: An updated Apple beta feed was downloaded."
				sofa_apple_beta_cache_etag=$(cat "${sofa_apple_beta_cache_etag_temp}")
			fi
			rm -Rf "${sofa_apple_beta_cache_etag_previous}" > /dev/null 2>&1
		else
			log_super "SOFA: Downloading new Apple beta feed..."
			local curl_response && curl_response=$(curl --user-agent "${SUPER_USER_AGENT}" --write-out "%{http_code}" --max-time "${TIMEOUT_START_SECONDS}" --compressed --location "${sofa_apple_beta_url}" --etag-save "${sofa_apple_beta_cache_etag_temp}" --output "${SOFA_APPLE_BETA_CACHE_JSON}" 2>&1)
			sofa_apple_beta_cache_etag=$(cat "${sofa_apple_beta_cache_etag_temp}")
		fi
		rm -Rf "${sofa_apple_beta_cache_etag_temp}" > /dev/null 2>&1
		
		# Verify the SOFA Apple beta feed download completed and is valid then save cache settings.
		if [[ $(echo "${curl_response}" | tail -n 1 | grep -c -E "${REGEX_HTTP_OK_STATUS}") -gt 0 ]] && [[ -f "${SOFA_APPLE_BETA_CACHE_JSON}" ]] && [[ -n "${sofa_apple_beta_cache_etag}" ]]; then
			if [[ $(jq -r '.UpdateHash // empty' "${SOFA_APPLE_BETA_CACHE_JSON}" 2> /dev/null) ]]; then
				set_pref_main "SOFAAppleBetaChecksum" "$(md5 -q "${SOFA_APPLE_BETA_CACHE_JSON}" 2> /dev/null)"
				set_pref_main "SOFAAppleBetaETag" "${sofa_apple_beta_cache_etag}"
			else
				get_sofa_apple_beta_feed_error="TRUE" && log_super "SOFA Error: The downloaded Apple beta feed ${SOFA_APPLE_BETA_CACHE_JSON} appears to be invalid."
			fi
		elif [[ $(echo "${curl_response}" | grep -c 'Connection timed out') -gt 0 ]]; then
			get_sofa_apple_beta_feed_error="TRUE" && log_super "SOFA Error: The Apple beta feed failed to verify or download, as indicated by no progress after waiting for ${TIMEOUT_START_SECONDS} seconds:\n${curl_response}"
		else
			get_sofa_apple_beta_feed_error="TRUE" && log_super "SOFA Error: The Apple beta feed failed to download from: ${sofa_apple_beta_url}:\n${curl_response}"
		fi
		unset curl_response
		if [[ "${get_sofa_apple_beta_feed_error}" == "TRUE" ]]; then
			delete_pref_main "SOFAAppleBetaChecksum"
			delete_pref_main "SOFAAppleBetaETag"
			rm -f "${SOFA_APPLE_BETA_CACHE_JSON}" 2> /dev/null
		fi
	fi
	
	# Check SOFA Safari feed cache via HTTP ETag or download a new Safari feed.
	local sofa_safari_checksum && sofa_safari_checksum=$(get_pref "SOFASafariChecksum")
	local sofa_safari_cache_etag && sofa_safari_cache_etag=$(get_pref "SOFASafariETag")
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_safari_checksum is: ${sofa_safari_checksum}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_safari_cache_etag is: ${sofa_safari_cache_etag}"
	local sofa_safari_cache_etag_temp && sofa_safari_cache_etag_temp="$(mktemp -p "${SUPER_CACHES_FOLDER}").txt"
	if [[ -n "${sofa_safari_checksum}" ]] && [[ -n "${sofa_safari_cache_etag}" ]] && [[ -f "${SOFA_SAFARI_CACHE_JSON}" ]]; then
