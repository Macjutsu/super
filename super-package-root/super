		[[ "${installer_macos_minor_update_target}" != "FALSE" ]] && local installer_macos_target="${installer_macos_minor_update_target}"
		installer_macos_title=$(echo "${installer_macos_target}" | awk -F ',' '{print $1}' | sed -e 's/.*://g')
		installer_macos_version=$(echo "${installer_macos_target}" | awk -F ',' '{print $2}' | sed -e 's/.*://g')
		installer_macos_build=$(echo "${installer_macos_target}" | awk -F ',' '{print $3}' | sed -e 's/.*://g')
		installer_macos_size=$(echo "${installer_macos_target}" | awk -F ',' '{print $4}' | sed -e 's/.*://g' | awk '{print $1"/1000000000 +1"}' | bc)
		[[ "${installer_macos_major_upgrade_target}" != "FALSE" ]] && log_super "Target: macOS major upgrade installer ${installer_macos_title} ${installer_macos_version}-${installer_macos_build} which is a ${installer_macos_size}GB download."
		[[ "${installer_macos_minor_update_target}" != "FALSE" ]] && log_super "Target: macOS minor update installer ${installer_macos_title} ${installer_macos_version}-${installer_macos_build} which is a ${installer_macos_size}GB download."
	fi
	
	# If (no errors) then set ${macos_major_upgrade_latest} or ${macos_minor_update_latest} and possibly log the latest disallowed major/minor macOS versions and any inefficient macOS targets.
	if [[ "${workflow_check_software_status_error}" == "FALSE" ]]; then
		if [[ ${#sofa_macos_major_upgrades_array[@]} -gt 0 ]]; then
			[[ "${msu_macos_major_upgrade_target}" != "FALSE" ]] && [[ $msu_macos_major_upgrade_target_version_normalized -eq $(echo "${sofa_macos_major_upgrades_array[0]}" | awk -F'.' '{printf "%02d%02d%02d", $1, $2, $3}') ]] && macos_major_upgrade_latest="TRUE"
			[[ "${installer_macos_major_upgrade_target}" != "FALSE" ]] && [[ $installer_macos_major_upgrade_target_version_normalized -eq $(echo "${sofa_macos_major_upgrades_array[0]}" | awk -F'.' '{printf "%02d%02d%02d", $1, $2, $3}') ]] && macos_major_upgrade_latest="TRUE"
			if [[ "${macos_major_upgrade_latest}" == "FALSE" ]]; then
				[[ ${#sofa_macos_major_upgrades_array[@]} -eq 1 ]] && log_super "Status: An available macOS major upgrade is not allowed, $(jq -r --arg macos_version_full "${sofa_macos_major_upgrades_array[0]}" '.OSVersions[].SecurityReleases[] | select(.ProductVersion == $macos_version_full) | "\(.UpdateName) released on \(.ReleaseDate[:-10])" // empty' "${SOFA_MACOS_CACHE_JSON}" 2> /dev/null)."
				[[ ${#sofa_macos_major_upgrades_array[@]} -gt 1 ]] && log_super "Status: Multiple available macOS major upgrades are not allowed, including the latest $(jq -r --arg macos_version_full "${sofa_macos_major_upgrades_array[0]}" '.OSVersions[].SecurityReleases[] | select(.ProductVersion == $macos_version_full) | "\(.UpdateName) released on \(.ReleaseDate[:-10])" // empty' "${SOFA_MACOS_CACHE_JSON}" 2> /dev/null)."
			fi
		elif [[ "${sofa_macos_failover}" == "TRUE" ]]; then
			[[ "${msu_macos_major_upgrade_target}" != "FALSE" ]] && macos_major_upgrade_latest="TRUE"
			[[ "${installer_macos_major_upgrade_target}" != "FALSE" ]] && macos_major_upgrade_latest="TRUE"
		fi
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: macos_major_upgrade_latest is: ${macos_major_upgrade_latest}"
		if [[ ${#sofa_macos_minor_updates_array[@]} -gt 0 ]]; then
			[[ "${msu_macos_minor_update_target}" != "FALSE" ]] && [[ $msu_macos_minor_update_target_version_normalized -eq $(echo "${sofa_macos_minor_updates_array[0]}" | awk -F'.' '{printf "%02d%02d%02d", $1, $2, $3}') ]] && macos_minor_update_latest="TRUE"
			[[ "${installer_macos_minor_update_target}" != "FALSE" ]] && [[ $installer_macos_minor_update_target_version_normalized -eq $(echo "${sofa_macos_minor_updates_array[0]}" | awk -F'.' '{printf "%02d%02d%02d", $1, $2, $3}') ]] && macos_minor_update_latest="TRUE"
			if [[ "${macos_minor_update_latest}" == "FALSE" ]]; then
				[[ ${#sofa_macos_minor_updates_array[@]} -eq 1 ]] && log_super "Status: An available macOS minor udpate is not allowed, $(jq -r --arg macos_version_full "${sofa_macos_minor_updates_array[0]}" '.OSVersions[].SecurityReleases[] | select(.ProductVersion == $macos_version_full) | "\(.UpdateName) released on \(.ReleaseDate[:-10])" // empty' "${SOFA_MACOS_CACHE_JSON}" 2> /dev/null)."
				[[ ${#sofa_macos_minor_updates_array[@]} -gt 1 ]] && log_super "Status: Multiple available macOS minor udpates are not allowed, including the latest $(jq -r --arg macos_version_full "${sofa_macos_minor_updates_array[0]}" '.OSVersions[].SecurityReleases[] | select(.ProductVersion == $macos_version_full) | "\(.UpdateName) released on \(.ReleaseDate[:-10])" // empty' "${SOFA_MACOS_CACHE_JSON}" 2> /dev/null)."
			fi
		elif [[ "${sofa_macos_failover}" == "TRUE" ]]; then
			[[ "${msu_macos_minor_update_target}" != "FALSE" ]] && macos_minor_update_latest="TRUE"
			[[ "${installer_macos_minor_update_target}" != "FALSE" ]] && macos_minor_update_latest="TRUE"
		fi
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: macos_minor_update_latest is: ${macos_minor_update_latest}"
		{ [[ -n "${install_macos_minor_version_target}" ]] && [[ "${msu_macos_minor_update_target}" == "FALSE" ]] && [[ "${installer_macos_minor_update_target}" != "FALSE" ]]; } && log_super "Warning: The --install-macos-minor-version-target=${install_macos_minor_version_target} option is forcing the workflow to target a full macOS installer (as opposed to a more efficient \"over-the-air\" macOS minor update)."
		{ [[ -n "${install_macos_major_version_target}" ]] && [[ "${msu_macos_major_upgrade_target}" == "FALSE" ]] && [[ "${installer_macos_major_upgrade_target}" != "FALSE" ]]; } && log_super "Warning: The --install-macos-major-version-target=${install_macos_major_version_target} option is forcing the workflow to target a full macOS installer (as opposed to a more efficient \"over-the-air\" macOS major upgrade)."
	fi
	
	# If (no errors) then evaluate the ${msu_non_system_array[]} and set ${msu_non_system_targets} and ${msu_safari_target}.
	# If there are ${msu_non_system_targets} then this function will also set ${msu_non_system_labels_array[]} and ${msu_non_system_titles_array[]}.
	if [[ "${workflow_check_software_status_error}" == "FALSE" ]] && [[ ${#msu_non_system_array[@]} -gt 0 ]]; then
		msu_non_system_targets="TRUE"
		msu_non_system_labels_array=()
		msu_non_system_titles_array=()
		for array_index in "${!msu_non_system_array[@]}"; do
			msu_non_system_labels_array+=($(echo "${msu_non_system_array[array_index]}" | awk -F ',' '{print $1}' | sed -e 's/.*://g'))
			msu_non_system_titles_array+=($(echo "${msu_non_system_array[array_index]}" | awk -F ',' '{print $2}' | sed -e 's/.*://g'))
			[[ $(echo "${msu_non_system_array[array_index]}" | grep -c 'Safari') -ge 1 ]] && msu_safari_target=$(echo "${msu_non_system_array[array_index]}" | awk -F ',' '{print $4}' | sed -e 's/Version://')
			log_super "Target: Non-system update $((array_index + 1)) of ${#msu_non_system_array[@]} is: ${msu_non_system_titles_array[array_index]} $(echo "${msu_non_system_array[array_index]}" | awk -F ',' '{print $4}' | sed -e 's/.*://g')"
			[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_non_system_labels_array[${array_index}] is: ${msu_non_system_labels_array[array_index]}"
		done
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_non_system_targets is: ${msu_non_system_targets}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_safari_target is: ${msu_safari_target}"
	
	# Handle ${workflow_check_software_status_error} or complete the workflow.
	IFS="${previous_ifs}"
	if [[ "${workflow_check_software_status_error}" == "TRUE" ]]; then
		if [[ "${workflow_install_now_active}" == "TRUE" ]]; then # Install now workflow mode.
			log_super "Error: Checking for macOS software status workflow failed, install now workflow can not continue."
			log_status "Inactive Error: Checking for macOS software status workflow failed, install now workflow can not continue."
			[[ "${current_user_account_name}" != "FALSE" ]] && notification_install_now_failed & disown
			exit_error
		else # Default super workflow.
			if [[ "${workflow_restart_validate_active}" == "TRUE" ]]; then
				deferral_timer_minutes="${DEFERRAL_TIMER_RESTART_VALIDATION_ERROR_MINUTES}"
				log_super "Error: Checking for macOS software status workflow failed, trying restart validation workflow again in ${deferral_timer_minutes} minutes."
				log_status "Pending: Checking for macOS software status workflow failed, trying restart validation workflow again in ${deferral_timer_minutes} minutes."
			else # Default super workflow.
				deferral_timer_minutes=$deferral_timer_error_minutes
				log_super "Error: Checking for macOS software status workflow failed, trying again in ${deferral_timer_minutes} minutes."
				log_status "Pending: Checking for macOS software status workflow failed, trying again in ${deferral_timer_minutes} minutes."
			fi
			set_auto_launch_deferral
		fi
	else
		set_pref_main "LastSuccessfulCheckDate" "$(date +%Y-%m-%d:%H:%M:%S)"
	fi
}

