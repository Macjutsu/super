	{ [[ -n "${test_display_function_option}" ]] || [[ "${verbose_mode}" == "TRUE" ]]; } && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: display_dialog_banner is: ${display_dialog_banner}"
	if [[ -n "${display_dialog_banner}" ]] && [[ $(echo "${display_dialog_banner}" | grep -c -E "${SWIFT_DIALOG_COLOR_REGEX}") -gt 0 ]]; then
		display_dialog_banner_path="${display_dialog_banner}"
	elif [[ -n "${display_dialog_banner}" ]]; then
