# If there is a real current user then open the S.U.P.E.R.M.A.N. Wiki, otherwise run the show_usage() function.
show_help() {
	log_echo "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - SHOW HELP ****"
	current_user_account_name="FALSE"
	current_user_id="FALSE"
	current_user_account_name=$(scutil <<<"show State:/Users/ConsoleUser" | awk '/Name :/ {$1=$2="";print $0;}' | xargs)
	current_user_id=$(id -u "${current_user_account_name_result}" 2> /dev/null)
	if [[ "${current_user_account_name}" != "FALSE" ]] || [[ "${current_user_id}" != "FALSE" ]]; then
		log_echo "Status: Opening S.U.P.E.R.M.A.N. Wiki for user account: ${current_user_account_name}."
		launchctl asuser "${current_user_id}" sudo -u "${current_user_account_name}" open "https://github.com/Macjutsu/super/wiki" &
	else # No current GUI user.
		log_echo "Warning: Unable to open S.U.P.E.R.M.A.N. Wiki because there is no GUI user."
		show_usage
	fi
	log_echo "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - EXIT SHOW HELP ****"
	exit 0
}

