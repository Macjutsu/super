# Set internal default parameters (constants) that are used throughout the script.
set_internal_defaults() {
	# Path to the super working folder:
	readonly SUPER_FOLDER="/Library/Application Support/super"
	
	# Path to the super symbolic link in default command line binary folder:
	readonly SUPER_LINK="/usr/local/bin/super"
	
	# Path to the super PID file in the default PID file folder:
	readonly SUPER_PID_FILE="/var/run/super.pid"
	
	# Label name for the super LaunchDaemon:
	readonly SUPER_LAUNCH_DAEMON_LABEL="com.macjutsu.super" # No trailing ".plist"
	
	# Path to the main property list file in the default computer preference domain folder:
	readonly SUPER_MAIN_PLIST="/Library/Preferences/com.macjutsu.super" # No trailing ".plist"
	
	# Path to the managed property list file:
	readonly SUPER_MANAGED_PLIST="/Library/Managed Preferences/com.macjutsu.super" # No trailing ".plist"
	
	# Path to the cached items folder:
	readonly SUPER_CACHES_FOLDER="${SUPER_FOLDER}/caches"
	
	# Path to the local cached copy of the SOFA macOS feed:
	readonly SOFA_MACOS_CACHE_JSON="${SUPER_CACHES_FOLDER}/macos_data_feed.json"
	
	# Path to the local cached copy of the SOFA Apple beta feed:
	readonly SOFA_APPLE_BETA_CACHE_JSON="${SUPER_CACHES_FOLDER}/apple_beta_feed.json"
	
	# Path to the local cached copy of the SOFA Safari feed:
	readonly SOFA_SAFARI_CACHE_JSON="${SUPER_CACHES_FOLDER}/safari_data_feed.json"
	
