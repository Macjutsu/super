		set_pref_main "SuperVersion" "${SUPER_VERSION}"
		defaults read "${SUPER_MAIN_PLIST}" > /dev/null 2>&1
		[[ -d "${SUPER_CACHES_FOLDER}" ]] && find "${SUPER_CACHES_FOLDER}" -mindepth 1 -delete > /dev/null 2>&1
