		if [[ $(echo "${curl_response}" | tail -n 1 | grep -c '200') -gt 0 ]]; then # If the ETag had not changed then the last line of the ${curl_response} would contain '304'.
			log_super "SOFA: An updated Safari feed was downloaded."
