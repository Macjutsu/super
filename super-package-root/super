# Given the calling function's name ${FUNCNAME[1]}, using either ${display_config_is_custom_folder} or the super defaults, evaluate and export the display message to the ${display_message_temp_md} file and also set ${display_string_deadline}.
# Note that this function will exit the workflow if an appropriate message can't be found.
set_display_message() {
	local set_display_message_error="FALSE"
	
	# Variations for the message ${display_string_deadline}.
	display_string_deadline="FALSE"
	if [[ "${workflow_scheduled_install_now}" == "TRUE" ]]; then
		[[ $(echo "${FUNCNAME[1]}" | grep -c 'dialog') -gt 0 ]] && display_string_deadline=$(eval echo "${DISPLAY_DIALOG_MESSAGE_DEADLINE_SCHEDULED}")
		[[ $(echo "${FUNCNAME[1]}" | grep -c 'notification') -gt 0 ]] && display_string_deadline=$(eval echo "${DISPLAY_NOTIFICATION_MESSAGE_DEADLINE_SCHEDULED}")
	elif [[ "${deadline_days_status}" == "SOFT" ]] || [[ "${deadline_days_status}" == "HARD" ]] || [[ "${deadline_date_status}" == "SOFT" ]] || [[ "${deadline_date_status}" == "HARD" ]]; then
		[[ $(echo "${FUNCNAME[1]}" | grep -c 'dialog') -gt 0 ]] && display_string_deadline=$(eval echo "${DISPLAY_DIALOG_MESSAGE_DEADLINE_DATE}")
		[[ $(echo "${FUNCNAME[1]}" | grep -c 'notification') -gt 0 ]] && display_string_deadline=$(eval echo "${DISPLAY_NOTIFICATION_MESSAGE_DEADLINE_DATE}")
	elif [[ "${deadline_count_status}" == "SOFT" ]] || [[ "${deadline_count_status}" == "HARD" ]]; then
		[[ $(echo "${FUNCNAME[1]}" | grep -c 'dialog') -gt 0 ]] && display_string_deadline=$(eval echo "${DISPLAY_DIALOG_MESSAGE_DEADLINE_COUNT}")
		[[ $(echo "${FUNCNAME[1]}" | grep -c 'notification') -gt 0 ]] && display_string_deadline=$(eval echo "${DISPLAY_NOTIFICATION_MESSAGE_DEADLINE_COUNT}")
	fi
	{ [[ -n "${test_display_function_option}" ]] || [[ "${verbose_mode}" == "TRUE" ]]; } && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: display_string_deadline is: ${display_string_deadline}"
	{ [[ "${test_display_function_option}" == "dialog_soft_deadline" ]] || [[ "${display_string_deadline}" == "FALSE" ]]; } && local display_message_import_filename="${FUNCNAME[1]}.md"
	[[ "${test_display_function_option}" != "dialog_soft_deadline" ]] && [[ "${display_string_deadline}" != "FALSE" ]] && local display_message_import_filename="${FUNCNAME[1]}_deadline.md"
	{ [[ -n "${test_display_function_option}" ]] || [[ "${verbose_mode}" == "TRUE" ]]; } && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: display_message_import_filename is: ${display_message_import_filename}"
	
	# Given ${display_config_is_custom_folder} and ${display_message_import_filename} try to set an appropriate ${display_message_import_path}.
	if [[ -n "${display_config_is_custom_folder}" ]]; then
		if [[ -f "${display_config_is_custom_folder}/${current_user_locale_identifier}/${display_message_import_filename}" ]]; then
			log_super "Display Status: Setting ${FUNCNAME[1]} message to custom configuration in ${display_config_is_custom_folder} for ${current_user_locale_identifier}."
			local display_message_import_path="${display_config_is_custom_folder}/${current_user_locale_identifier}/${display_message_import_filename}"
		elif [[ -f "${display_config_is_custom_folder}/${FAILOVER_LOCALE_IDENTIFIER}/${display_message_import_filename}" ]]; then
			log_super "Display Warning: Unable to locate a custom ${display_message_import_filename} in ${display_config_is_custom_folder} for ${current_user_locale_identifier}, failing over to ${FAILOVER_LOCALE_IDENTIFIER}."
			local display_message_import_path="${display_config_is_custom_folder}/${FAILOVER_LOCALE_IDENTIFIER}/${display_message_import_filename}"
		else
			log_super "Display Warning: Unable to locate a custom ${display_message_import_filename} in ${display_config_is_custom_folder} for ${current_user_locale_identifier} or ${FAILOVER_LOCALE_IDENTIFIER}, failing over to super defaults."
		fi
	fi
	if [[ -z "${display_message_import_path}" ]]; then
		if [[ -f "${SUPER_DISPLAY_DEFAULTS_FOLDER}/${current_user_locale_identifier}/${display_message_import_filename}" ]]; then
			log_super "Display Status: Setting ${FUNCNAME[1]} message to super defaults for ${current_user_locale_identifier}."
			local display_message_import_path="${SUPER_DISPLAY_DEFAULTS_FOLDER}/${current_user_locale_identifier}/${display_message_import_filename}"
		elif [[ -f "${SUPER_DISPLAY_DEFAULTS_FOLDER}/${FAILOVER_LOCALE_IDENTIFIER}/${display_message_import_filename}" ]]; then
			log_super "Display Warning: Unable to locate a super default ${display_message_import_filename} for ${current_user_locale_identifier}, failing over to ${FAILOVER_LOCALE_IDENTIFIER}."
			local display_message_import_path="${SUPER_DISPLAY_DEFAULTS_FOLDER}/${FAILOVER_LOCALE_IDENTIFIER}/${display_message_import_filename}"
		else
			set_display_message_error="TRUE" && log_super "Display Error: Unable to locate the super default ${display_message_import_filename}. Reinstall super to resolve this issue."
		fi
	fi
	{ [[ -n "${test_display_function_option}" ]] || [[ "${verbose_mode}" == "TRUE" ]]; } && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: display_message_import_path is: ${display_message_import_path}"
	{ [[ -n "${test_display_function_option}" ]] || [[ "${verbose_mode}" == "TRUE" ]]; } && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: display_message_import_path content is:\n$(cat "${display_message_import_path}" 2> /dev/null)\n"
	
	# Assuming there was no error and we have a ${display_message_import_path}, this heredoc will evaluate for variables and export to the ${display_message_temp_md} file.
	display_message_temp_md="$(mktemp -p "${SUPER_CACHES_FOLDER}").md"
	if [[ "${set_display_message_error}" == "FALSE" ]]; then
eval "cat << EOMD
$(< "${display_message_import_path}")
EOMD" > "${display_message_temp_md}"
	else # Show a last resort error message.
cat << EOMD >"${display_message_temp_md}"
## :${current_user_appearance_accent_color_hex}[Display Configuration Failed]

The update workflow can not continue due to display configuration errors.
EOMD
	fi
	chmod a+r "${display_message_temp_md}" > /dev/null 2>&1
	
	# If needed, given the ${set_display_message_error} condition, create the last-resort error notification and exit or restart.
	if [[ "${set_display_message_error}" == "TRUE" ]]; then
		dialog_json=$(jq -n --arg display_button_1 "${DISPLAY_STRING_OK}" '{ "button1text": $display_button_1 }')
		[[ "${display_icon_is_custom}" == "FALSE" ]] && dialog_json=$(echo "${dialog_json}" | jq --arg display_icon "SF=exclamationmark.arrow.trianglehead.2.clockwise.rotate.90,colour=${current_user_appearance_accent_color},weight=regular" --arg display_icon_alpha "${DISPLAY_ICON_ALPHA}" '. + { "icon": $display_icon, "iconalpha": $display_icon_alpha }')
		[[ "${display_icon_is_custom}" == "TRUE" ]] && dialog_json=$(echo "${dialog_json}" | jq --arg display_icon "${display_icon_path}:dark=${display_icon_dark_path}" --arg display_icon_alpha "${DISPLAY_ICON_ALPHA}" '. + { "icon": $display_icon, "iconalpha": $display_icon_alpha }')
		open_notification_swift_dialog & disown -a
		sleep 1
		if [[ "${workflow_install_now_active}" == "TRUE" ]]; then
			log_super "Error: Display conifguration errors, install now workflow can not continue."
			log_status "Inactive Error: Display conifguration errors, install now workflow can not continue."
			exit_error
		else
			deferral_timer_minutes=$deferral_timer_error_minutes
			log_super "Error: Display conifguration errors, trying again in ${deferral_timer_minutes} minutes."
			log_status "Pending: Display conifguration errors, trying again in ${deferral_timer_minutes} minutes."
			set_auto_launch_deferral
		fi
	fi
}

