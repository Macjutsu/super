# Display a dialog informing the user there is insufficient storage for a macOS update/upgrade.
dialog_insufficient_storage() {
	dialog_insufficient_storage_error="FALSE"
	if [[ -z "${test_display_function_option}" ]]; then
		log_super "Warning: Current available storage is at ${storage_available_gigabytes} GBs which is below the ${storage_required_gigabytes} GBs that is required for macOS update/upgrade workflow."
	else
		storage_available_gigabytes=$(( STORAGE_REQUIRED_UPGRADE_DEFAULT_GB - 10 ))
		storage_required_gigabytes=$STORAGE_REQUIRED_UPGRADE_DEFAULT_GB
	fi
	
	# Display dialog parameter and message Markdown configuration, then create the initial ${dialog_json}.
	[[ "${set_display_config_ready}" != "TRUE" ]] && set_display_config
	[[ "${workflow_target}" != "FALSE" ]] && [[ "${set_display_workflow_target_ready}" != "TRUE" ]] && set_display_workflow_target
	set_display_message
	[[ "${display_help_message}" == "TRUE" ]] && [[ "${set_display_help_message_ready}" != "TRUE" ]] && set_display_help_message
	dialog_json=$(jq -n '{ "button1text": "none" }')
	dialog_json=$(echo "${dialog_json}" | jq --arg display_icon "${display_icon_path}:dark=${display_icon_dark_path}" --arg display_icon_alpha "${DISPLAY_ICON_ALPHA}" '. + { "icon": $display_icon, "iconalpha": $display_icon_alpha }')
	unset dialog_timeout_seconds
	[[ -n $dialog_timeout_insufficient_storage_seconds ]] && dialog_timeout_seconds=$dialog_timeout_insufficient_storage_seconds
	{ [[ -z $dialog_timeout_insufficient_storage_seconds ]] && [[ -n $dialog_timeout_default_seconds ]]; } && dialog_timeout_seconds=$dialog_timeout_default_seconds
	[[ "${display_hide_background_status}" == "TRUE" ]] && display_hide_background_status="TEMPOFF"
	{ [[ "${display_silently_status}" != "TRUE" ]] && [[ $(echo "${display_silently}" | grep -c 'ERROR') -gt 0 ]]; } && display_silently_status="TEMP"
	{ [[ -n "${test_display_function_option}" ]] || [[ "${verbose_mode}" == "TRUE" ]]; } && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: dialog_json is:\n${dialog_json}"
	
	# Open the Storage settings (if not testing a display function) and then start the open_dialog_swift_dialog() function.
	if [[ -z "${test_display_function_option}" ]]; then
		log_super "Status: Opening the Storage pane of the System Settings.app."
		launchctl asuser "${current_user_id}" sudo -u "${current_user_account_name}" open "x-apple.systempreferences:com.apple.settings.Storage" & disown
		open_dialog_swift_dialog &
	else
		open_dialog_swift_dialog
	fi
	
	# (If not testing a display function) Handle waiting for available storage along with the ${dialog_timeout_seconds} option.
	if [[ -z "${test_display_function_option}" ]]; then
		[[ -n "${dialog_timeout_seconds}" ]] && local dialog_insufficient_storage_check_timeout="${dialog_timeout_seconds}"
		[[ -z "${dialog_timeout_seconds}" ]] && local dialog_insufficient_storage_check_timeout=1
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: STORAGE_REQUIRED_RECHECK_SECONDS is: ${STORAGE_REQUIRED_RECHECK_SECONDS}"
		while [[ $dialog_insufficient_storage_check_timeout -ge 0 ]]; do
			sleep "${STORAGE_REQUIRED_RECHECK_SECONDS}"
			check_storage_available
			if [[ "${check_storage_available_error}" == "FALSE" ]]; then
				if [[ "${storage_ready}" == "TRUE" ]]; then
					log_super "Status: Current available storage is now at ${storage_available_gigabytes} GBs, the macOS update/upgrade workflow can continue."
					echo "quit:" >> "${SWIFT_DIALOG_COMMAND_FILE}" && sleep 0.1
					log_metrics "Display Insufficient Storage Success: Workflow Elapsed Time" "WorkflowTargetTimestamp"
					break
				fi
			else # "${check_storage_available_error}" == "FALSE"
				dialog_insufficient_storage_error="TRUE"
				break
			fi
			[[ -n "${dialog_timeout_seconds}" ]] && dialog_insufficient_storage_check_timeout=$((dialog_insufficient_storage_check_timeout - STORAGE_REQUIRED_RECHECK_SECONDS))
		done
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: dialog_insufficient_storage_error is: ${dialog_insufficient_storage_error}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: storage_ready is: ${storage_ready}"
		
		# If there still is not sufficient storage, then error.
		if [[ "${dialog_insufficient_storage_error}" == "FALSE" ]] && [[ "${storage_ready}" == "FALSE" ]]; then
			[[ -n "${dialog_timeout_seconds}" ]] && log_super "Error: Waiting for user to make more storage available timed out after ${dialog_timeout_seconds} seconds."
			dialog_insufficient_storage_error="TRUE"
			log_metrics "Display Insufficient Storage Timeout: Workflow Elapsed Time" "WorkflowTargetTimestamp"
		fi
	fi
	
	# Reset temporary display dialog items.
	[[ "${display_hide_background_status}" == "TEMPOFF" ]] && display_hide_background_status="TRUE"
	[[ "${display_silently_status}" == "TEMP" ]] && unset display_silently_status
	find "${SUPER_CACHES_FOLDER}" -maxdepth 1 -type f -name "tmp*" -delete > /dev/null 2>&1
	unset display_message_temp_md
}

# Display a dialog informing the user they need to plug the computer into AC power.
