			delete_pref_main "DeferralTimerFocus"
			delete_pref_main "DeferralTimerError"
			delete_pref_main "DeferralTimerWorkflowRelaunch"
		fi
		if [[ "${scheduled_install_delete_all_option}" == "TRUE" ]]; then
			log_super_audit "Status: Deleting all scheduled installation options in main preferences."
