# Output various configuration status to standard out.
show_sofa_macos_feed_status() {
	if [[ "${config_status_option}" != "TRUE" ]]; then
		log_echo "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - SOFA STATUS ****"
		verbose_mode="FALSE"
	fi
	
	log_super "\n**** Config Status: SOFA macOS feed information:"
	if [[ -f "${SOFA_MACOS_CACHE_JSON}" ]]; then
		if [[ $(jq -r '.UpdateHash // empty' "${SOFA_MACOS_CACHE_JSON}" 2> /dev/null) ]]; then
			log_super "SOFA macOS: Local cache at ${SOFA_MACOS_CACHE_JSON} appears to be valid."
			log_super "SOFA macOS: UpdateHash: $(jq -r '.UpdateHash // empty' "${SOFA_MACOS_CACHE_JSON}" 2> /dev/null)"
			log_super "SOFA macOS: LastCheck: $(jq -r '.LastCheck // empty' "${SOFA_MACOS_CACHE_JSON}" 2> /dev/null)"
			log_super "SOFA macOS: Latest macOS releases:\n$(jq -r '.OSVersions[] | "\(.Latest.ReleaseDate[:-10]): \(.Latest.UpdateName)-\(.Latest.Build)" // empty' "${SOFA_MACOS_CACHE_JSON}" 2> /dev/null)"
		else
			log_super "SOFA macOS Error: The SOFA macOS cache at ${SOFA_MACOS_CACHE_JSON} appears to be invalid."
		fi
	else
		log_super "SOFA macOS: No SOFA macOS cache."
	fi
	
	log_super "\n**** Config Status: SOFA Safari feed information:"
	if [[ -f "${SOFA_SAFARI_CACHE_JSON}" ]]; then
		if [[ $(jq -r '.UpdateHash // empty' "${SOFA_SAFARI_CACHE_JSON}" 2> /dev/null) ]]; then
			log_super "SOFA Safari: Local cache at ${SOFA_SAFARI_CACHE_JSON} appears to be valid."
			log_super "SOFA Safari: UpdateHash: $(jq -r '.UpdateHash // empty' "${SOFA_SAFARI_CACHE_JSON}" 2> /dev/null)"
			log_super "SOFA Safari: Latest Safari releases:\n$(jq -r '.AppVersions[] | "\(.Latest.ReleaseDate[:-10]): \(.Latest.UpdateName)" // empty' "${SOFA_SAFARI_CACHE_JSON}" 2> /dev/null)"
		else
			log_super "SOFA Safari Error: The SOFA Safari cache at ${SOFA_SAFARI_CACHE_JSON} appears to be invalid."
		fi
	else
		log_super "SOFA Safari: No SOFA Safari cache."
	fi
	
	log_super "\n**** Config Status: SOFA Apple beta feed information:"
	if [[ -f "${SOFA_APPLE_BETA_CACHE_JSON}" ]]; then
		if [[ $(jq -r '.UpdateHash // empty' "${SOFA_APPLE_BETA_CACHE_JSON}" 2> /dev/null) ]]; then
			log_super "SOFA Apple beta: Local cache at ${SOFA_APPLE_BETA_CACHE_JSON} appears to be valid."
			log_super "SOFA Apple beta: UpdateHash: $(jq -r '.UpdateHash // empty' "${SOFA_APPLE_BETA_CACHE_JSON}" 2> /dev/null)"
			log_super "SOFA Apple beta: Latest Apple beta releases:\n$(jq -r '.AppVersions[] | "\(.Latest.ReleaseDate[:-10]): \(.Latest.UpdateName)" // empty' "${SOFA_APPLE_BETA_CACHE_JSON}" 2> /dev/null)"
		else
			log_super "SOFA Apple beta Error: The SOFA Apple beta cache at ${SOFA_APPLE_BETA_CACHE_JSON} appears to be invalid."
		fi
	else
		log_super "SOFA Apple beta: No SOFA Apple beta cache."
	fi
	
	if [[ "${config_status_option}" != "TRUE" ]]; then
		log_super ""
		log_echo "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - EXIT SOFA STATUS ****"
		exit 0
	fi
}

# Output various configuration status to standard out.
show_config_status() {
	log_echo "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - CONFIGURATION STATUS ****"
	verbose_mode="FALSE"
	log_super "\n**** Config Status: General system information:"
	check_system
	
	log_super "\n**** Config Status: Current active GUI user information:"
	check_current_user
	
	log_super "\n**** Config Status: super runtime information:"
	log_super "Status: super version: ${SUPER_VERSION}"
	log_super "Status: super date: ${SUPER_DATE}"
	log_super "Status: super user agent: ${SUPER_USER_AGENT}"
	local super_previous_pid && super_previous_pid=$(pgrep -F "${SUPER_PID_FILE}" 2> /dev/null)
	[[ $(launchctl print "system/${SUPER_LAUNCH_DAEMON_LABEL}" 2>&1 | grep -c "system/${SUPER_LAUNCH_DAEMON_LABEL}") -gt 0 ]] && local super_launch_daemon_active="TRUE"
	if [[ -n "${super_previous_pid}" ]]; then
		[[ "${super_launch_daemon_active}" == "TRUE" ]] && log_super "Status: The super workflow is RUNNING and LaunchDaemon system/${SUPER_LAUNCH_DAEMON_LABEL} is ENABLED."
		[[ "${super_launch_daemon_active}" != "TRUE" ]] && log_super "Status: The super workflow is RUNNING and LaunchDaemon system/${SUPER_LAUNCH_DAEMON_LABEL} is NOT ENABLED."
	elif [[ "${super_launch_daemon_active}" == "TRUE" ]]; then
		local next_auto_launch && next_auto_launch=$(/usr/libexec/PlistBuddy -c "Print :NextAutoLaunch" "${SUPER_MAIN_PLIST}.plist" 2> /dev/null)
		[[ "${next_auto_launch}" != "FALSE" ]] && log_super "Status: LaunchDaemon system/${SUPER_LAUNCH_DAEMON_LABEL} is ENABLED and the super workflow is scheduled to automatically relaunch at ${next_auto_launch}."
		[[ "${next_auto_launch}" == "FALSE" ]] && log_super "Status: LaunchDaemon system/${SUPER_LAUNCH_DAEMON_LABEL} is ENABLED but the super workflow is NOT scheduled to automatically relaunch."
	else
		log_super "Status: LaunchDaemon system/${SUPER_LAUNCH_DAEMON_LABEL} is NOT ENABLED."
	fi
	swift_dialog_app=$(readlink "${SWIFT_DIALOG_BINARY}" 2> /dev/null | sed -e 's/\/Contents.*//')
	if [[ ! -d "${swift_dialog_app}" ]] || [[ ! -f "${SWIFT_DIALOG_BINARY}" ]]; then
		[[ ! -d "${swift_dialog_app}" ]] && log_super "Error: No swiftDialog application in the expected location at ${swift_dialog_app}."
		[[ ! -f "${SWIFT_DIALOG_BINARY}" ]] &&  log_super "Error: No swiftDialog binary in the expected location at ${SWIFT_DIALOG_BINARY}."
	else
		check_swift_dialog
	fi
	if [[ ! -f "${MIST_CLI_BINARY}" ]]; then
		log_super "Status: No mist-cli binary in the expected location at ${MIST_CLI_BINARY}."
	else
		check_mist_cli
	fi
	[[ -f "${JAMF_PRO_BINARY}" ]] && check_jamf_pro_binary
	
	if [[ -d "${SUPER_FOLDER}" ]]; then
		log_super "\n**** Config Status: Contents of the super working folder located at ${SUPER_FOLDER}:"
		ls -lah "${SUPER_FOLDER}" | tail -n +4
	else
		log_super "\n**** Config Error: No super working folder in the expected location at ${SUPER_FOLDER}."
	fi
	
	if [[ -d "${SUPER_CACHES_FOLDER}" ]]; then
		log_super "\n**** Config Status: Contents of the super caches folder located at ${SUPER_CACHES_FOLDER}:"
		ls -lah "${SUPER_CACHES_FOLDER}" | tail -n +4
	else
		log_super "\n**** Config Error: No super caches folder in the expected location at ${SUPER_CACHES_FOLDER}."
	fi
	
	if [[ -d "${SUPER_CONFIG_FOLDER}" ]]; then
		log_super "\n**** Config Status: Contents of the super config folder located at ${SUPER_CONFIG_FOLDER}:"
		ls -lah "${SUPER_CONFIG_FOLDER}" | tail -n +4
	else
		log_super "\n**** Config Error: No super config folder in the expected location at ${SUPER_CONFIG_FOLDER}."
	fi
	
	if [[ -d "${SUPER_ALTERNATE_CONFIGS_FOLDER}" ]]; then
		log_super "\n**** Config Status: Contents of the super alternate configs folder located at ${SUPER_ALTERNATE_CONFIGS_FOLDER}:"
		ls -lah "${SUPER_ALTERNATE_CONFIGS_FOLDER}" | tail -n +4
	else
		log_super "\n**** Config Error: No super alternate config folder in the expected location at ${SUPER_ALTERNATE_CONFIGS_FOLDER}."
	fi
	
	if [[ -d "${SUPER_DISPLAY_FOLDER}" ]]; then
		log_super "\n**** Config Status: Contents of the super display folder located at ${SUPER_DISPLAY_FOLDER}:"
		ls -lah "${SUPER_DISPLAY_FOLDER}" | tail -n +4
	else
		log_super "\n**** Config Error: No super display folder in the expected location at ${SUPER_DISPLAY_FOLDER}."
	fi
	
	if [[ -d "${SUPER_LOGS_FOLDER}" ]]; then
		log_super "\n**** Config Status: Contents of the super logs folder located at ${SUPER_LOGS_FOLDER}:"
		ls -lah "${SUPER_LOGS_FOLDER}" | tail -n +4
	else
		log_super "\n**** Config Error: No super log folder in the expected location at ${SUPER_LOGS_FOLDER}."
	fi
	
	alternate_temporary_plist=$(get_pref "AlternateTemporaryPlist")
	config_temp_override=$(get_pref_managed "ConfigTempOverride")
	[[ -z "${config_temp_override}" ]] && config_temp_override="FALSE"
	if [[ -f "${SUPER_MANAGED_PLIST}.plist" ]]; then
		[[ "${config_temp_override}" == "FALSE" ]] || { [[ "${config_temp_override}" == "TRUE" ]] && [[ -z "${alternate_temporary_plist}" ]]; } && log_super "\n**** Config Status: Key/value pairs of the CONFIGURATION PROFILE MANAGED super settings file located at ${SUPER_MANAGED_PLIST}.plist:"
		[[ "${config_temp_override}" == "FALSE" ]] || { [[ "${config_temp_override}" == "TRUE" ]] && [[ -z "${alternate_temporary_plist}" ]]; } && defaults read "${SUPER_MANAGED_PLIST}" | tail -n +2 | sed -e 's/    //g' -e 's/;//g' -e '$d'
	else
		log_super "\n**** Config Status: No CONFIGURATION PROFILE MANAGED super settings file in the expected location at ${SUPER_MANAGED_PLIST}.plist."
	fi
	
	if [[ -n "${alternate_temporary_plist}" ]]; then
		if [[ -f "${alternate_temporary_plist}.plist" ]]; then
			{ [[ -f "${SUPER_MANAGED_PLIST}.plist" ]] && [[ "${config_temp_override}" == "TRUE" ]]; } && log_super "\n**** Config Status: The temporary workflow configuration will override conflicting settings in the managed workflow configuration."
			{ [[ -f "${SUPER_MANAGED_PLIST}.plist" ]] && [[ "${config_temp_override}" == "FALSE" ]]; } && log_super "\n**** Config Status: The managed workflow configuration will override conflicting settings in the temporary workflow configuration. You can reverse this behavior via the <key>ConfigTempOverride</key> <true/> managed preference setting."
			log_super "\n**** Config Status: Key/value pairs of the ALTERNATE TEMPORARY super settings file located at ${alternate_temporary_plist}.plist:"
			defaults read "${alternate_temporary_plist}" | tail -n +2 | sed -e 's/    //g' -e 's/;//g' -e '$d'
			log_super "$(get_config_code_signature "${alternate_temporary_plist}.plist")"
			{ [[ -f "${SUPER_MANAGED_PLIST}.plist" ]] && [[ "${config_temp_override}" == "TRUE" ]]; } && log_super "\n**** Config Status: Key/value pairs of the CONFIGURATION PROFILE MANAGED super settings file located at ${SUPER_MANAGED_PLIST}.plist:"
			{ [[ -f "${SUPER_MANAGED_PLIST}.plist" ]] && [[ "${config_temp_override}" == "TRUE" ]]; } && defaults read "${SUPER_MANAGED_PLIST}" | tail -n +2 | sed -e 's/    //g' -e 's/;//g' -e '$d'
		else
			log_super "\n**** Config Error: No ALTERNATE TEMPORARY super settings file in the expected location at ${alternate_temporary_plist}.plist."
		fi
	else
		log_super "\n**** Config Status: No ALTERNATE TEMPORARY super settings file."
	fi
	
	alternate_default_plist=$(get_pref "AlternateDefaultPlist")
	if [[ -n "${alternate_default_plist}" ]]; then
		if [[ -f "${alternate_default_plist}.plist" ]]; then
			log_super "\n**** Config Status: Key/value pairs of the ALTERNATE DEFAULT super settings file located at ${alternate_default_plist}.plist:"
			defaults read "${alternate_default_plist}" | tail -n +2 | sed -e 's/    //g' -e 's/;//g' -e '$d'
			log_super "$(get_config_code_signature "${alternate_default_plist}.plist")"
		else
			log_super "\n**** Config Error: No ALTERNATE DEFAULT super settings file in the expected location at ${alternate_default_plist}.plist."
		fi
	else
		log_super "\n**** Config Status: No ALTERNATE DEFAULT super settings file."
	fi
	
	if [[ -f "${SUPER_MAIN_PLIST}.plist" ]]; then
		log_super "\n**** Config Status: Key/value pairs of the MAIN super settings file located at ${SUPER_MAIN_PLIST}.plist:"
		defaults read "${SUPER_MAIN_PLIST}" | tail -n +2 | sed -e 's/    //g' -e 's/;//g' -e '$d'
	else
		log_super "\n**** Config Error: No MAIN super settings file in the expected location at ${SUPER_MAIN_PLIST}.plist."
	fi
	
	if [[ $(ls "${SUPER_ALTERNATE_CONFIGS_FOLDER}") ]]; then
		for super_inactive_alt_plist in "${SUPER_ALTERNATE_CONFIGS_FOLDER:?}"/*.plist; do
			if [[ "${super_inactive_alt_plist}" != "${alternate_temporary_plist}.plist" ]] && [[ "${super_inactive_alt_plist}" != "${alternate_default_plist}.plist" ]]; then
				log_super "\n**** Config Status: Key/value pairs of the INACTIVE super settings file located at ${super_inactive_alt_plist}:"
				defaults read "${super_inactive_alt_plist}" | tail -n +2 | sed -e 's/    //g' -e 's/;//g' -e '$d'
				log_super "$(get_config_code_signature "${super_inactive_alt_plist}")"
			fi
		done
	fi
	
	log_super "\n**** Config Status: Local cached macos update/upgrade information:"
	check_msu_macos_download
	[[ "${msu_macos_downloaded_version}" == "FALSE" ]] && log_super "Status: Mac softwareupdate system cache is empty (no downloaded macOS update/upgrade)."
	[[ "${msu_macos_downloaded_version}" != "FALSE" ]] && log_super "Status: Mac softwareupdate system cache is macOS ${msu_macos_downloaded_version}-${msu_macos_downloaded_build}."
	local previous_ifs="${IFS}" && IFS=$'\n'
	local installer_macos_local_paths_array && installer_macos_local_paths_array=($(mdfind kind:app -name "Install macOS" 2> /dev/null))
	if [[ -n "${installer_macos_local_paths_array[*]}" ]]; then
		for installer_macos_path in "${installer_macos_local_paths_array[@]}"; do
			if [[ $(echo "${installer_macos_path}" | grep -c '/Volumes/') -gt 0 ]] || { [[ $(echo "${installer_macos_path}" | grep -c '/Users/') -gt 0 ]] && [[ $(echo "${installer_macos_path}" | grep -c '/Users/.*/Applications/') -eq 0 ]] && [[ $(echo "${installer_macos_path}" | grep -c '/Users/.*/Desktop/') -eq 0 ]] && [[ $(echo "${installer_macos_path}" | grep -c '/Users/.*/Downloads/') -eq 0 ]]; }; then
				log_super "Status: Found archived (can not be targeted for installation) macOS installer at: ${installer_macos_path}"
			else
				log_super "Status: Found cached macOS installer at: ${installer_macos_path}"
			fi
		done
	else
		log_super "Status: No cached macOS installers."
	fi
	IFS="${previous_ifs}"
	
	show_sofa_macos_feed_status
	
	if [[ -f "${MSU_DDM_STATE_PLIST}.plist" ]]; then
		log_super "\n**** Config Status: Contents of the DECLARATIVE STATE software update settings file located at ${MSU_DDM_STATE_PLIST}.plist:"
		defaults read "${MSU_DDM_STATE_PLIST}"
	else
		log_super "\n**** Config Status: No DECLARATIVE STATE software update settings file file in the expected location at ${MSU_DDM_STATE_PLIST}.plist."
	fi
	
	if [[ -f "${MSU_MANAGED_PLIST}.plist" ]]; then
		[[ $system_macos_version_major -ge 27 ]] && log_super "\n**** Config Error: Detected an unsupported (on macOS 27 and later) LEGACY CONFIGURATION PROFILE MANAGED software update settings file located at ${MSU_MANAGED_PLIST}.plist:"
		[[ $system_macos_version_major -lt 27 ]] && log_super "\n**** Config Status: Contents of the LEGACY CONFIGURATION PROFILE MANAGED software update settings file located at ${MSU_MANAGED_PLIST}.plist:"
		defaults read "${MSU_MANAGED_PLIST}"
	elif [[ $system_macos_version_major -lt 27 ]]; then
		log_super "\n**** Config Status: No LEGACY CONFIGURATION PROFILE MANAGED software update settings file file in the expected location at ${MSU_MANAGED_PLIST}.plist."
	fi
	
	if [[ -f "${MSU_APPLICATION_ACCESS_MANAGED_PLIST}.plist" ]]; then
		[[ $system_macos_version_major -ge 27 ]] && log_super "\n**** Config Error: Detected an unsupported (on macOS 27 and later) LEGACY CONFIGURATION PROFILE MANAGED DEFFERAL settings file located at ${MSU_APPLICATION_ACCESS_MANAGED_PLIST}.plist:"
		[[ $system_macos_version_major -lt 27 ]] && log_super "\n**** Config Status: Contents of the LEGACY CONFIGURATION PROFILE MANAGED DEFFERAL settings file located at ${MSU_APPLICATION_ACCESS_MANAGED_PLIST}.plist:"
		defaults read "${MSU_APPLICATION_ACCESS_MANAGED_PLIST}"
	elif [[ $system_macos_version_major -lt 27 ]]; then
		log_super "\n**** Config Status: No LEGACY CONFIGURATION PROFILE MANAGED DEFFERAL update settings file file in the expected location at ${MSU_APPLICATION_ACCESS_MANAGED_PLIST}.plist."
	fi
	
	if [[ -f "${MSU_LOCAL_PLIST}.plist" ]]; then
		log_super "\n**** Config Status: Contents of the LOCAL software update settings file located at ${MSU_LOCAL_PLIST}.plist:"
		defaults read "${MSU_LOCAL_PLIST}"
	else
		log_super "\n**** Config Error: No LOCAL software update settings file file in the expected location at ${MSU_LOCAL_PLIST}.plist."
	fi
	
	local system_profiler_install_history_json && system_profiler_install_history_json=$(system_profiler SPInstallHistoryDataType -json 2> /dev/null)
	if [[ $(echo "${system_profiler_install_history_json}" | grep -c '_name') -ge 1 ]]; then
		log_super "\n**** Config Status: Installation history of macOS system updates:"
		log_super "${system_profiler_install_history_json}" | grep -e '_name' -e 'install_date' | awk -F '"' '{print $4}' | tr '\n' ',' | sed -e 's/Z,/\n/g' -e 's/,/\t/g' | grep -e 'macOS'
		log_super "\n**** Config Status: Installation history of macOS security updates:"
		log_super "${system_profiler_install_history_json}" | grep -e '_name' -e 'install_date' | awk -F '"' '{print $4}' | tr '\n' ',' | sed -e 's/Z,/\n/g' -e 's/,/\t\t/g' -e 's/MRTConfigData/MRTConfigData\t/g' | grep -e 'XProtect' -e 'MRTConfigData'
	else
		log_super "\n**** Config Error: The system_profiler command did not return a valid installation history list."
	fi
	
	log_super ""
	log_echo "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - EXIT CONFIGURATION STATUS ****"
	exit 0
}

