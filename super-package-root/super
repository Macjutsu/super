		dialog_json=$(jq -n --arg display_button_1 "${display_string_defer_button}" --arg display_button_2 "${dialog_now_button}" --arg display_button_info "${dialog_schedule_button}" '{ "button1text": $display_button_1, "button2text": $display_button_2, "infobuttontext": $display_button_info }')
	else
