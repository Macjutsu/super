	local power_required_charger_connected="FALSE"
	dialog_power_required_error="FALSE"
	if [[ -z "${test_display_function_option}" ]]; then
		log_super "Warning: Current battery level is at ${power_battery_percent}% which is below the minimum required level of ${power_required_battery_percent}%."
	else
		power_battery_percent=$(( POWER_REQUIRED_BATTERY_PERCENT - 10 ))
		power_required_battery_percent=$POWER_REQUIRED_BATTERY_PERCENT
	fi
	
	# Display dialog parameter and message Markdown configuration, then create the initial ${dialog_json}.
	[[ "${set_display_config_ready}" != "TRUE" ]] && set_display_config
	[[ "${workflow_target}" != "FALSE" ]] && [[ "${set_display_workflow_target_ready}" != "TRUE" ]] && set_display_workflow_target
	set_display_message
	[[ "${display_help_message}" == "TRUE" ]] && [[ "${set_display_help_message_ready}" != "TRUE" ]] && set_display_help_message
	dialog_json=$(jq -n '{ "button1text": "none" }')
	dialog_json=$(echo "${dialog_json}" | jq --arg display_icon "${display_icon_path}:dark=${display_icon_dark_path}" --arg display_icon_alpha "${DISPLAY_ICON_ALPHA}" '. + { "icon": $display_icon, "iconalpha": $display_icon_alpha }')
	unset dialog_timeout_seconds
	[[ -n $dialog_timeout_power_required_seconds ]] && dialog_timeout_seconds=$dialog_timeout_power_required_seconds
	{ [[ -z $dialog_timeout_power_required_seconds ]] && [[ -n $dialog_timeout_default_seconds ]]; } && dialog_timeout_seconds=$dialog_timeout_default_seconds
	{ [[ "${display_hide_background_status}" != "TRUE" ]] && [[ $(echo "${display_hide_background}" | grep -c 'ERROR') -gt 0 ]]; } && display_hide_background_status="TEMP"
	{ [[ "${display_silently_status}" != "TRUE" ]] && [[ $(echo "${display_silently}" | grep -c 'ERROR') -gt 0 ]]; } && display_silently_status="TEMP"
	{ [[ -n "${test_display_function_option}" ]] || [[ "${verbose_mode}" == "TRUE" ]]; } && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: dialog_json is:\n${dialog_json}"
	[[ -z "${test_display_function_option}" ]] && open_dialog_swift_dialog &
	[[ -n "${test_display_function_option}" ]] && open_dialog_swift_dialog
	
	# (If not testing a display function) Handle waiting for AC power along with the ${dialog_timeout_seconds} option.
	if [[ -z "${test_display_function_option}" ]]; then
		[[ -n "${dialog_timeout_seconds}" ]] && local dialog_power_required_check_timeout="${dialog_timeout_seconds}"
		[[ -z "${dialog_timeout_seconds}" ]] && local dialog_power_required_check_timeout=1
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: POWER_REQUIRED_RECHECK_SECONDS is: ${POWER_REQUIRED_RECHECK_SECONDS}"
		while [[ $dialog_power_required_check_timeout -ge 0 ]]; do
			sleep "${POWER_REQUIRED_RECHECK_SECONDS}"
			[[ $(pmset -g ps | grep -ic 'AC Power') -ne 0 ]] && power_required_charger_connected="TRUE"
			[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: power_required_charger_connected: ${power_required_charger_connected}"
			if [[ "${power_required_charger_connected}" == "TRUE" ]]; then
				log_super "Status: AC power detected, the macOS update/upgrade workflow can continue."
				echo "quit:" >> "${SWIFT_DIALOG_COMMAND_FILE}" && sleep 0.1
				log_metrics "Display Power Required Success: Workflow Elapsed Time" "WorkflowTargetTimestamp"
				break
			fi
			[[ -n "${dialog_timeout_seconds}" ]] && dialog_power_required_check_timeout=$((dialog_power_required_check_timeout - POWER_REQUIRED_RECHECK_SECONDS))
		done
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: power_required_charger_connected is: ${power_required_charger_connected}"
		
		# If there still is no AC power, then exit.
		if [[ "${power_required_charger_connected}" == "FALSE" ]]; then
			[[ -n "${dialog_timeout_seconds}" ]] && log_super "Error: Waiting for user to connect AC power timed out after ${dialog_timeout_seconds} seconds."
			dialog_power_required_error="TRUE"
			log_metrics "Display Power Required Timeout: Workflow Elapsed Time" "WorkflowTargetTimestamp"
		fi
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: dialog_power_required_error is: ${dialog_power_required_error}"
	fi
	
	# Reset temporary display dialog items.
	[[ "${display_hide_background_status}" == "TEMP" ]] && unset display_hide_background_status
	[[ "${display_silently_status}" == "TEMP" ]] && unset display_silently_status
	find "${SUPER_CACHES_FOLDER}" -maxdepth 1 -type f -name "tmp*" -delete > /dev/null 2>&1
	unset display_message_temp_md
}

