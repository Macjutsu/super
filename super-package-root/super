# Install only non-system macOS software updates via the softwareupdate command, and also save responses to ${SUPER_LOG} and ${MSU_WORKFLOW_LOG}.
install_non_system_msu() {
	install_msu_non_system_error="TRUE"
	log_super "softwareupdate: Starting non-system macOS software updates installation workflow, check ${MSU_WORKFLOW_LOG} for more detail."
	log_status "Running: softwareupdate: Starting non-system macOS software updates installation workflow."
	log_msu "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - INSTALL NON-SYSTEM UPDATES VIA SOFTWAREUPDATE START ****"
	local previous_ifs="${IFS}" && IFS=$' '
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_non_system_labels_array is:\n${msu_non_system_labels_array[*]}"
	
	# The update process is backgrounded and is watched via a while loop later on.
	if [[ "${current_user_account_name}" == "FALSE" ]]; then
		sudo -i softwareupdate --install "${msu_non_system_labels_array[@]}" --force --agree-to-license >> "${MSU_WORKFLOW_LOG}" 2>&1 &
		local install_msu_pid="$!"
	else # Local user is logged in.
		launchctl asuser "${current_user_id}" sudo -u "${current_user_account_name}" softwareupdate --install "${msu_non_system_labels_array[@]}" --force --agree-to-license >> "${MSU_WORKFLOW_LOG}" 2>&1 &
		local install_msu_pid="$!"
	fi
	
	# Watch ${MSU_WORKFLOW_LOG} while waiting for the softwareupdate installation workflow to complete.
	# Note this while read loop has a timeout based on ${TIMEOUT_START_SECONDS} then changes to ${TIMEOUT_NON_SYSTEM_MSU_SECONDS}.
	local install_msu_non_system_start_timeout="TRUE"
	local install_msu_non_system_start_error="TRUE"
	local install_msu_non_system_timeout_error="TRUE"
	local install_msu_non_system_timeout_seconds="${TIMEOUT_START_SECONDS}"
	local install_msu_non_system_installed_titles_array=()
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: install_msu_non_system_timeout_seconds is: ${install_msu_non_system_timeout_seconds}"
	while read -t "${install_msu_non_system_timeout_seconds}" -r log_line; do
		# log_super "Debug Mode: Function ${FUNCNAME[0]}: log_line is:\n${log_line}"
		if [[ $(echo "${log_line}" | grep -c "Can’t connect") -gt 0 ]] || [[ $(echo "${log_line}" | grep -c "Couldn't communicate") -gt 0 ]] || [[ $(echo "${log_line}" | grep -c 'No such update') -gt 0 ]] || [[ $(echo "${log_line}" | grep -c 'No updates are available') -gt 0 ]]; then
			install_msu_non_system_start_timeout="FALSE"
			break
		elif [[ $(echo "${log_line}" | grep -c 'Downloading') -gt 0 ]]; then
			msu_macos_title_downloaded=$(echo "${log_line}" | sed -e 's/://' | awk -F 'Downloading ' '{print $2;}')
			log_super "softwareupdate: ${msu_macos_title_downloaded} is downloading..."
			log_msu "**** TIMESTAMP ****"
			install_msu_non_system_timeout_seconds="${TIMEOUT_NON_SYSTEM_MSU_SECONDS}"
			[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: install_msu_non_system_timeout_seconds is: ${install_msu_non_system_timeout_seconds}"
			install_msu_non_system_start_timeout="FALSE"
			install_msu_non_system_start_error="FALSE"
		elif [[ $(echo "${log_line}" | grep -c 'Downloaded') -gt 0 ]]; then
			msu_macos_title_downloaded=$(echo "${log_line}" | sed -e 's/://' | awk -F 'Downloaded ' '{print $2;}')
			log_super "softwareupdate: ${msu_macos_title_downloaded} download complete."
			install_msu_non_system_timeout_seconds="${TIMEOUT_NON_SYSTEM_MSU_SECONDS}"
			log_msu "**** TIMESTAMP ****"
			[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: install_msu_non_system_timeout_seconds is: ${install_msu_non_system_timeout_seconds}"
			install_msu_non_system_start_timeout="FALSE"
			install_msu_non_system_start_error="FALSE"
		elif [[ $(echo "${log_line}" | grep -c 'Done with') -gt 0 ]]; then
			local install_msu_non_system_installed_title && install_msu_non_system_installed_title=$(echo "${log_line}" | sed -e 's/://' | awk -F 'Done with ' '{print $2;}')
			log_super "softwareupdate: ${install_msu_non_system_installed_title} installed."
			install_msu_non_system_installed_titles_array+=("${install_msu_non_system_installed_title}")
			log_msu "**** TIMESTAMP ****"
			install_msu_non_system_start_timeout="FALSE"
			install_msu_non_system_start_error="FALSE"
		elif [[ $(echo "${log_line}" | grep -c 'Done.') -gt 0 ]]; then
			log_msu "**** TIMESTAMP ****"
			install_msu_non_system_timeout_error="FALSE"
			break
		fi
	done < <(tail -n1 -F "${MSU_WORKFLOW_LOG}")
	
	# If the softwareupdate installation workflow completed, then validate and collect information.
	if [[ "${install_msu_non_system_start_timeout}" == "FALSE" ]] && [[ "${install_msu_non_system_start_error}" == "FALSE" ]] && [[ "${install_msu_non_system_timeout_error}" == "FALSE" ]]; then
		local previous_ifs="${IFS}" && IFS=$'\n'
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_non_system_titles_array is:\n${msu_non_system_titles_array[*]}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: install_msu_non_system_installed_titles_array is:\n${install_msu_non_system_installed_titles_array[*]}"
		if [[ ! $(echo -e "${msu_non_system_titles_array[*]}\n${install_msu_non_system_installed_titles_array[*]}" | sort | uniq -u) ]]; then
			log_msu "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - INSTALL NON-SYSTEM UPDATES VIA SOFTWAREUPDATE COMPLETED ****"
			install_msu_non_system_error="FALSE"
		else # The expected ${msu_non_system_titles_array} did not match the ${install_msu_non_system_installed_titles_array}.
			log_msu "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - INSTALL NON-SYSTEM UPDATES VIA SOFTWAREUPDATE INCOMPLETE ****"
			log_msu "Error: Installation of non-system macOS software updates did not complete."
			log_super "Error: Installation of non-system macOS software updates did not complete."
		fi
	else # The softwareupdate installation workflow failed.
		log_msu "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - INSTALL NON-SYSTEM UPDATES VIA SOFTWAREUPDATE FAILED ****"
		if [[ "${install_msu_non_system_start_timeout}" == "TRUE" ]]; then
			log_msu "Error: Installation of non-system macOS software updates failed to start after waiting for ${install_msu_non_system_timeout_seconds} seconds."
			log_super "Error: Installation of non-system macOS software updates failed to start after waiting for ${install_msu_non_system_timeout_seconds} seconds."
		elif [[ "${install_msu_non_system_start_error}" == "TRUE" ]]; then
			log_msu "Error: Unable to reach macOS software update server."
			log_super "Error: Unable to reach macOS software update server."
		elif [[ "${install_msu_non_system_timeout_error}" == "TRUE" ]]; then
			log_msu "Error: Installation of non-system macOS software updates failed, as indicated by no progress after waiting for ${install_msu_non_system_timeout_seconds} seconds."
			log_super "Error: Installation of non-system macOS software updates failed, as indicated by no progress after waiting for ${install_msu_non_system_timeout_seconds} seconds."
		fi
		kill -9 "${install_msu_pid}" > /dev/null 2>&1
		kick_softwareupdated
	fi
	IFS="${previous_ifs}"
}

# Install only a Safari update via the softwareupdate command, and also save responses to ${SUPER_LOG} and ${MSU_WORKFLOW_LOG}.
install_safari_update_msu() {
