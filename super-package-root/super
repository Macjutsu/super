		[[ "${verbose_mode}" == "TRUE" ]] && set_pref_main "VerboseMode" "TRUE"
	
		# Restore any saved preferences from backup.
		[[ "${auth_ask_user_to_save_password_backup}" == "TRUE" ]] && set_pref_main "AuthAskUserToSavePassword" "TRUE"
		[[ "${auth_local_account_backup}" == "TRUE" ]] && set_pref_main "AuthLocalAccount" "TRUE"
