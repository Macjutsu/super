# Check Jamf Pro binary for for validity and set ${jamf_pro_binary_valid}, ${jamf_pro_version_number_full}, and ${jamf_pro_version_normalized}.
check_jamf_pro_binary() {
	jamf_pro_binary_valid="FALSE"
	local codesign_result && codesign_result=$(codesign --verify --verbose "${JAMF_PRO_BINARY}" 2>&1)
	if [[ $(echo "${codesign_result}" | grep -c 'valid on disk') -gt 0 ]]; then
		jamf_pro_binary_valid="TRUE"
		jamf_pro_version_number_full=$("${JAMF_PRO_BINARY}" -version | sed -e 's/version=//' -e 's/-.*//')
		jamf_pro_version_normalized=$(echo "${jamf_pro_version_number_full}" | awk -F'.' '{printf "%02d%02d%02d", $1, $2, $3}') # Expected output: 112001
		[[ "${config_status_option}" == "TRUE" ]] && log_super "Status: Jamf Pro version: ${jamf_pro_version_number_full}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: jamf_pro_version_normalized is: ${jamf_pro_version_normalized}"
	else
		log_super "Error: Jamf Pro binary located at ${JAMF_PRO_BINARY} has invalid signature:\n${codesign_result}"
	fi
}

# Validate connectivity to Jamf Pro service and set ${jamf_management_url}.
check_jamf_pro_service() {
	check_jamf_pro_service_error="FALSE"
	local jamf_result && jamf_result=$("${JAMF_PRO_BINARY}" checkJSSConnection -retry 1 2> /dev/null)
	if [[ $(echo "${jamf_result}" | grep -c 'available') -gt 0 ]]; then
