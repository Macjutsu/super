################################################################################

# Append input to stout and log located at ${SUPER_LOG}, unless not runing as root, or ${SUPER_LOG} doesn't exist, or any {*_status_option} is enabled, then just echo to stdout.
log_super() {
	if [[ "${sofa_status_option}" != "TRUE" ]] && [[ "${config_status_option}" != "TRUE" ]]; then
		[[ "${running_as_root}" == "TRUE" ]] && echo -e "$(date +"%a %b %d %T") $(hostname -s) $(basename "$0")[$$]: $*" | tee -a "${SUPER_LOG}"
		[[ "${running_as_root}" == "FALSE" ]] && echo -e "$(date +"%a %b %d %T") $(hostname -s) $(basename "$0")[$$]: Not Logged: $*"
	else # A {*_status_option} is enabled, so only echo out without additional date and process details.
		echo -e "$*"
	fi
}

# Append input to stout and logs located at ${SUPER_LOG} and ${SUPER_AUDIT_LOG}.
log_super_audit() {
	echo -e "$(date +"%a %b %d %T") $(hostname -s) $(basename "$0")[$$]: $*" | tee -a "${SUPER_LOG}" "${SUPER_AUDIT_LOG}" 
}

# Append input to stout only. (Primarily used for when any {*_status_option} is enabled or when showing credentials in verbose mode testing.)
log_echo() {
	echo -e "$(date +"%a %b %d %T") $(hostname -s) $(basename "$0")[$$]: Not Logged: $*"
}

# Send input to stout only replacing the current line, so as not to save save interactive progress updates to the ${SUPER_LOG}.
log_echo_replace_line() {
	echo -ne "$(date +"%a %b %d %T") $(hostname -s) $(basename "$0")[$$]: Not Logged: $*\r"
}

# Append input to the log located at ${SUPER_METRICS_LOG} including an elapsed time based on the log text ${1} and timestamp ${2}. The timestamp can be either an integer of seconds, or a variable of a timestamp, or a property list key containing a timestamp.
log_metrics() {
	if [[ "${2}" =~ ^[0-9]+$ ]]; then
		local log_metrics_elapsed_seconds="${2}"
	else # ${2} is not an integer.
		[[ ! "${2}" =~ ^[[:upper:]] ]] && local log_metrics_timestamp="${2}"
		[[ "${2}" =~ ^[[:upper:]] ]] && local log_metrics_timestamp && log_metrics_timestamp=$(get_pref "${2}")
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: log_metrics_timestamp is: ${log_metrics_timestamp}"
		[[ -n "${log_metrics_timestamp}" ]] && local log_metrics_elapsed_seconds && log_metrics_elapsed_seconds=$(( $(date +%s) - $(date -j -f %Y-%m-%d:%H:%M:%S "${log_metrics_timestamp}" +%s) ))
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: log_metrics_elapsed_seconds is: ${log_metrics_elapsed_seconds}"
	if [[ -n "${log_metrics_elapsed_seconds}" ]]; then
		{ [[ -n "${workflow_target}" ]] && [[ "${workflow_target}" != "FALSE" ]]; } && echo -e "$(date +"%a %b %d %T") $(hostname -s) $(basename "$0")[$$]: ${workflow_target}: ${1} (DHMS): $(printf "%02d" $(( log_metrics_elapsed_seconds / 86400))):$(printf "%02d" $(( log_metrics_elapsed_seconds / 3600 % 24 ))):$(printf "%02d" $(( log_metrics_elapsed_seconds / 60 % 60 ))):$(printf "%02d" $(( log_metrics_elapsed_seconds %60 )))" >> "${SUPER_METRICS_LOG}"
		{ [[ -z "${workflow_target}" ]] || [[ "${workflow_target}" == "FALSE" ]]; } && echo -e "$(date +"%a %b %d %T") $(hostname -s) $(basename "$0")[$$]: No Target: ${1} (DHMS): $(printf "%02d" $(( log_metrics_elapsed_seconds / 86400))):$(printf "%02d" $(( log_metrics_elapsed_seconds / 3600 % 24 ))):$(printf "%02d" $(( log_metrics_elapsed_seconds / 60 % 60 ))):$(printf "%02d" $(( log_metrics_elapsed_seconds %60 )))" >> "${SUPER_METRICS_LOG}"
	else
		{ [[ -n "${workflow_target}" ]] && [[ "${workflow_target}" != "FALSE" ]]; } && echo -e "$(date +"%a %b %d %T") $(hostname -s) $(basename "$0")[$$]: ${workflow_target}: ${1}" >> "${SUPER_METRICS_LOG}"
		{ [[ -z "${workflow_target}" ]] || [[ "${workflow_target}" == "FALSE" ]]; } && echo -e "$(date +"%a %b %d %T") $(hostname -s) $(basename "$0")[$$]: No Target: ${1}" >> "${SUPER_METRICS_LOG}"
	fi
}

# Update the SuperStatus key in the ${SUPER_MAIN_PLIST}.
log_status() {
	set_pref_main "SuperStatus" "$(date +"%a %b %d %T"): $*"
}

# Append input to a log located at ${MSU_WORKFLOW_LOG}.
log_msu() {
	echo -e "\n$(date +"%a %b %d %T") $(hostname -s) $(basename "$0")[$$]: $*" >> "${MSU_WORKFLOW_LOG}"
}

# Append input to a log located at ${INSTALLER_WORKFLOW_LOG}.
log_installer() {
	echo -e "$(date +"%a %b %d %T") $(hostname -s) $(basename "$0")[$$]: $*" >> "${INSTALLER_WORKFLOW_LOG}"
}

# Archive all legacy log files to the ${SUPER_LOGS_ARCHIVE_FOLDER}, and if needed, archive larger current logs.
archive_logs() {
	# First, archive any legacy super logs.
	if [[ -f "${SUPER_FOLDER}/super.log" ]]; then
		local log_archive_legacy_name && log_archive_legacy_name=$(date +%Y-%m-%d.%H-%M-%S.legacy)
		log_super "Status: Archiving legacy super logs to ${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_legacy_name}.zip."
		mkdir -p "${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_legacy_name}"
		mv "${SUPER_FOLDER}/super.log" "${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_legacy_name}/super.log"
		[[ -f "${SUPER_FOLDER}/asuList.log" ]] && rm -f "${SUPER_FOLDER}/asuList.log" 2> /dev/null
		[[ -f "${SUPER_FOLDER}/installerList.log" ]] && rm -f "${SUPER_FOLDER}/installerList.log" 2> /dev/null
		[[ -f "${SUPER_FOLDER}/asu.log" ]] && mv "${SUPER_FOLDER}/asu.log" "${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_legacy_name}/asu.log"
		[[ -f "${SUPER_FOLDER}/installer.log" ]] && mv "${SUPER_FOLDER}/installer.log" "${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_legacy_name}/installer.log"
		[[ -f "${SUPER_FOLDER}/mdmCommand.log" ]] && mv "${SUPER_FOLDER}/mdmCommand.log" "${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_legacy_name}/mdmCommand.log"
		[[ -f "${SUPER_FOLDER}/mdmCommandDebug.log" ]] && mv "${SUPER_FOLDER}/mdmCommandDebug.log" "${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_legacy_name}/mdmCommandDebug.log"
		[[ -f "${SUPER_FOLDER}/mdmWorkflow.log" ]] && mv "${SUPER_FOLDER}/mdmWorkflow.log" "${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_legacy_name}/mdmWorkflow.log"
		[[ -f "${SUPER_FOLDER}/mdmWorkflowDebug.log" ]] && mv "${SUPER_FOLDER}/mdmWorkflowDebug.log" "${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_legacy_name}/mdmWorkflowDebug.log"
		zip -r -j "${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_legacy_name}.zip" "${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_legacy_name}" > /dev/null 2>&1
		rm -rf "${SUPER_LOGS_ARCHIVE_FOLDER:?}/${log_archive_legacy_name}" 2> /dev/null
		chown -R root:wheel "${SUPER_LOGS_ARCHIVE_FOLDER}"
		chmod -R a+r "${SUPER_LOGS_ARCHIVE_FOLDER}"
	fi
	
	# Check to see if any log file is larger than $SUPER_LOG_ARCHIVE_SIZE_KB.
	local archive_logs_needed="FALSE"
	[[ $(ls -l "${SUPER_LOG}" 2> /dev/null | awk '{print int($5/1000)}') -gt $SUPER_LOG_ARCHIVE_SIZE_KB ]] && archive_logs_needed="TRUE"
	[[ $(ls -l "${SUPER_AUDIT_LOG}" 2> /dev/null | awk '{print int($5/1000)}') -gt $SUPER_LOG_ARCHIVE_SIZE_KB ]] && archive_logs_needed="TRUE"
	[[ $(ls -l "${SUPER_METRICS_LOG}" 2> /dev/null | awk '{print int($5/1000)}') -gt $SUPER_LOG_ARCHIVE_SIZE_KB ]] && archive_logs_needed="TRUE"
	[[ $(ls -l "${MSU_WORKFLOW_LOG}" 2> /dev/null | awk '{print int($5/1000)}') -gt $SUPER_LOG_ARCHIVE_SIZE_KB ]] && archive_logs_needed="TRUE"
	[[ $(ls -l "${INSTALLER_WORKFLOW_LOG}" 2> /dev/null | awk '{print int($5/1000)}') -gt $SUPER_LOG_ARCHIVE_SIZE_KB ]] && archive_logs_needed="TRUE"
	
	# A super log has become to large, archival is required.
	if [[ "${archive_logs_needed}" == "TRUE" ]]; then
		local log_archive_name && log_archive_name=$(date +%Y-%m-%d.%H-%M-%S)
		log_super "Status: A super log is larger than ${SUPER_LOG_ARCHIVE_SIZE_KB} KB, archiving super logs to ${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_name}.zip."
		log_super "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - LOGS ARCHIVAL ****"
		mkdir -p "${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_name}"
		mv "${SUPER_LOG}" "${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_name}/$(basename "${SUPER_LOG}")"
		log_super "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - LOGS ARCHIVAL ****"
		log_super "Status: A super log was larger than ${SUPER_LOG_ARCHIVE_SIZE_KB} KB, previous super logs archived to ${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_name}.zip."
		[[ -f "${SUPER_AUDIT_LOG}" ]] && mv "${SUPER_AUDIT_LOG}" "${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_name}/$(basename "${SUPER_AUDIT_LOG}")"
		[[ -f "${SUPER_METRICS_LOG}" ]] && mv "${SUPER_METRICS_LOG}" "${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_name}/$(basename "${SUPER_METRICS_LOG}")"
		[[ -f "${MSU_WORKFLOW_LOG}" ]] && mv "${MSU_WORKFLOW_LOG}" "${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_name}/$(basename "${MSU_WORKFLOW_LOG}")"
		[[ -f "${INSTALLER_WORKFLOW_LOG}" ]] && mv "${INSTALLER_WORKFLOW_LOG}" "${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_name}/$(basename "${INSTALLER_WORKFLOW_LOG}")"
		zip -r -j "${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_name}.zip" "${SUPER_LOGS_ARCHIVE_FOLDER}/${log_archive_name}" > /dev/null 2>&1
		rm -rf "${SUPER_LOGS_ARCHIVE_FOLDER:?}/${log_archive_name}" 2> /dev/null
		chown -R root:wheel "${SUPER_LOGS_ARCHIVE_FOLDER}"
		chmod -R a+r "${SUPER_LOGS_ARCHIVE_FOLDER}"
	fi
	
	# This is a fail-safe to remove any excessively large files from the ${SUPER_LOGS_ARCHIVE_FOLDER}.
	for log_archive_file in "${SUPER_LOGS_ARCHIVE_FOLDER}"/*; do
		if [[ $(ls -l "${log_archive_file}" 2> /dev/null | awk '{print int($5/1000)}') -gt $((SUPER_LOG_ARCHIVE_SIZE_KB * 10)) ]]; then
			log_super "Warning: A file in the super log archive folder was larger than $((SUPER_LOG_ARCHIVE_SIZE_KB * 10)) KB, deleting file to save space: ${log_archive_file}"
			rm -rf "${log_archive_file:?}" 2> /dev/null
		fi
	done
}

# MARK: *** Local System Validation ***
################################################################################

# Collect parameters for detailed system information setting a variety of parameters including ${system_mac_model_*}, ${system_macos_version_*}, ${system_locale_identifier}, ${system_macos_beta_enrollment}, and ${system_last_startup}.
check_system() {
	check_system_error="FALSE"
	
	# Check for basic hardware information.
	system_profiler_hardware_json=$(system_profiler SPHardwareDataType -json 2> /dev/null)
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: system_profiler_hardware_json is:\n${system_profiler_hardware_json}"
	system_mac_model_name=$(echo "${system_profiler_hardware_json}" | jq -r '.SPHardwareDataType[0].machine_name // empty' 2> /dev/null) # Expected output: MacBook Pro
	[[ $(echo "${system_mac_model_name}" | grep -c 'Virtual') -gt 0 ]] && system_mac_model_name="${VIRTUAL_SYSTEM_MAC_MODEL_NAME}"
	[[ $(echo "${system_mac_model_name}" | grep -c 'Book') -gt 0 ]] && system_mac_model_portable="TRUE" # Expected output: TRUE
	system_mac_model_id=$(echo "${system_profiler_hardware_json}" | jq -r '.SPHardwareDataType[0].machine_model // empty' 2> /dev/null) # Expected output: Mac16,5
	if [[ $(echo "${system_mac_model_id}" | grep -c 'Virtual') -gt 0 ]]; then
		system_mac_model_id="${VIRTUAL_SYSTEM_MAC_MODEL_ID}"
		log_super "Warning: This system is running on a virtual machine so the hardware details are simluated."
	fi
	[[ "${system_mac_model_portable}" == "TRUE" ]] && log_super "Status: Mac portable model (id): ${system_mac_model_name} (${system_mac_model_id})"
	[[ "${system_mac_model_portable}" != "TRUE" ]] && log_super "Status: Mac desktop model (id): ${system_mac_model_name} (${system_mac_model_id})"
	
	# Check for last system startup.
	kernel_boot_epoch=$(sysctl -n kern.boottime | awk -F 'sec = |, usec' '{print $2}') # Expected outputs: seconds since epoch
	if [[ "${kernel_boot_epoch}" =~ ${REGEX_ANY_WHOLE_NUMBER} ]]; then
		system_last_startup=$(date -r "${kernel_boot_epoch}" +%Y-%m-%d:%H:%M:%S) # Expected output: 2023-08-25:13:25:45
	else
		log_super "Error: Unrecognized kernel boot epoch time: ${kernel_boot_epoch}"
		check_system_error="TRUE"
	fi
	if [[ "${system_last_startup}" =~ ${REGEX_DATE_HOURS_MINUTES_SECONDS} ]]; then
		log_super "Status: Last macOS startup: ${system_last_startup}"
	else
		log_super "Error: Unrecognized last startup date and time: ${system_last_startup}"
		check_system_error="TRUE"
	fi
	
	# Check for macOS version information.
	system_macos_version_minor=$(sw_vers -productVersion | cut -d'.' -f2) # Expected output: 6, 1
	system_macos_version_patch=$(sw_vers -productVersion | cut -d'.' -f3) # Expected output: 6, 1
	system_macos_version_normalized=$(sw_vers -productVersion | awk -F'.' '{printf "%02d%02d%02d", $1, $2, $3}') # Expected output: 100502, 140701, 260100
	system_macos_version_extra=$(sw_vers -productVersionExtra | cut -d'.' -f2) # Expected output: (a), (b), (c)
	system_macos_build=$(sw_vers -buildVersion) # Expected output: 22D68
	if [[ -n $system_macos_version_patch ]]; then # macOS version has a patch number.
		[[ -n "${system_macos_version_extra}" ]] && system_macos_version_full="macOS ${system_macos_version_major}.${system_macos_version_minor}.${system_macos_version_patch} ${system_macos_version_extra}-${system_macos_build}"
		[[ -z "${system_macos_version_extra}" ]] && system_macos_version_full="macOS ${system_macos_version_major}.${system_macos_version_minor}.${system_macos_version_patch}-${system_macos_build}"
	else # macOS version does not have a patch number.
		[[ -n "${system_macos_version_extra}" ]] && system_macos_version_full="macOS ${system_macos_version_major}.${system_macos_version_minor} ${system_macos_version_extra}-${system_macos_build}"
		[[ -z "${system_macos_version_extra}" ]] && system_macos_version_full="macOS ${system_macos_version_major}.${system_macos_version_minor}-${system_macos_build}"
	fi
	log_super "Status: macOS version-build: ${system_macos_version_full}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: system_macos_version_normalized is: ${system_macos_version_normalized}"
	
	# Check for macOS beta status.
	local seedutil_result && seedutil_result=$(/System/Library/PrivateFrameworks/Seeding.framework/Versions/A/Resources/seedutil current 2>&1)
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: seedutil_result is:\n${seedutil_result}"
	if [[ $(echo "${seedutil_result}" | awk '/Currently enrolled in/{print $4}') == "(null)" ]]; then
		system_macos_beta_enrollment="FALSE"
	elif [[ $(echo "${seedutil_result}" | awk '/Currently enrolled in/{print $4}') =~ .*Seed ]]; then
		system_macos_beta_enrollment="$(echo "${seedutil_result}" | awk '/Currently enrolled in/{print $4}')" # Expected output: PublicSeed, etc.
		log_super "Status: Enrolled in macOS beta: ${system_macos_beta_enrollment}"
	else
		log_super "Error: Unable to determine macOS beta seed enrollment status."
		check_system_error="TRUE"
	fi
	
	# Check the curent Safari.app version.
	local defaults_result && defaults_result=$(defaults read "${APP_SAFARI_PATH}/Contents/Info.plist" "CFBundleShortVersionString" 2>&1)
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: defaults_result is: ${defaults_result}"
	if [[ -n "${defaults_result}" ]]; then
		system_safari_version="${defaults_result}"
		system_safari_version_normalized=$(echo "${system_safari_version}" | awk -F'.' '{printf "%02d%02d%02d", $1, $2, $3}') # Expected output: 260200
		log_super "Status: Safari version: ${system_safari_version}"
	else
		log_super "Error: Unable to determine Safari version."
		check_system_error="TRUE"
	fi
	
	# Check for system management status.
	local profiles_result && profiles_result=$(profiles status -type enrollment 2>&1)
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: profiles_result:\n${profiles_result}"
	system_management_service="FALSE"
	system_management_ade="FALSE"
	if [[ $(echo "${profiles_result}" | grep -c 'MDM server') -gt 0 ]]; then
		system_management_service="https://$(echo "${profiles_result}" | grep '^MDM server' | awk -F '/' '{print $3;}')"
		local curl_response && curl_response=$(curl --user-agent "${SUPER_USER_AGENT}" --silent --head --location "${system_management_service}" | head -1)
		if [[ $(echo "${curl_response}" | tail -n 1 | grep -c -E "${REGEX_HTTP_OK_STATUS}") -gt 0 ]]; then
			log_super "Status: Management service: ${system_management_service}"
		else
			log_super "Warning: Management service unavailable: ${system_management_service}"
			log_super "Warning: Management service HTTP status: ${curl_response}"
		fi
		[[ $(echo "${profiles_result}" | grep 'Enrolled via DEP:' | grep -c 'Yes') -gt 0 ]] && system_management_ade="TRUE"
		[[ "${config_status_option}" == "TRUE" ]] && [[ "${system_management_ade}" == "FALSE" ]] && log_super "Status: Enrollment method: Manual"
		[[ "${config_status_option}" == "TRUE" ]] && [[ "${system_management_ade}" == "TRUE" ]] && log_super "Status: Enrollment method: Automatic"
	else
		log_super "Warning: No management service."
	fi
	
	# Check for system password policies.
	system_password_policies="FALSE"
	[[ $(system_profiler SPConfigurationProfileDataType 2> /dev/null | grep -c 'passwordpolicy') -gt 0 ]] && system_password_policies="TRUE"
	[[ "${config_status_option}" == "TRUE" ]] && log_super "Status: System password policies: ${system_password_policies}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_id_result is: ${current_user_id_result}"
	
	# Check for system locale identifier.
	system_locale_identifier=$(defaults read .GlobalPreferences AppleLocale 2> /dev/null) # Expected output: en_US
	if [[ -z "${system_locale_identifier}" ]]; then
		system_locale_identifier="${FAILOVER_LOCALE_IDENTIFIER}"
		log_super "Warning: Unable to determine system language and region, using failover: ${system_locale_identifier}"
	fi
	[[ "${config_status_option}" == "TRUE" ]] && log_super "Status: System language and region: ${system_locale_identifier}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_id_result is: ${current_user_id_result}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: check_system_error is: ${check_system_error}"
}

# Set various ${current_user_*} parameters to the currently logged in GUI user or "FALSE" if there is none or a system account. Also logs relevant information.
check_current_user() {
	[[ -z "${current_user_account_name}" ]] && current_user_account_name="FALSE"
	[[ -z "${current_user_id}" ]] && current_user_id="FALSE"
	[[ -z "${current_user_guid}" ]] && current_user_guid="FALSE"
	local current_user_account_name_result && current_user_account_name_result=$(scutil <<<"show State:/Users/ConsoleUser" | awk '/Name :/ {$1=$2="";print $0;}' | xargs)
	local current_user_id_result && current_user_id_result=$(id -u "${current_user_account_name_result}" 2> /dev/null)
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_account_name is: ${current_user_account_name}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_id is: ${current_user_id}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_account_name_result is: ${current_user_account_name_result}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_id_result is: ${current_user_id_result}"
	
	# If this function was already run earlier then check to see if ${current_user_account_name} and ${current_user_id} are the same as before, if so then it's not necessary to continue this function.
	if [[ "${current_user_account_name}" != "FALSE" ]] && [[ "${current_user_id}" != "FALSE" ]] && [[ "${current_user_account_name}" == "${current_user_account_name_result}" ]] && [[ "${current_user_id}" == "${current_user_id_result}" ]]; then
		return 0
	fi
	
	# Make sure we have a "normal" logged in user.
	if [[ -z "${current_user_account_name_result}" ]]; then
		log_super "Status: No user currently logged in."
	elif [[ "${current_user_account_name_result}" == "root" ]] || [[ "${current_user_account_name_result}" == "_mbsetupuser" ]] || [[ "${current_user_account_name_result}" == "loginwindow" ]]; then
		log_super "Status: Current user is a system account: ${current_user_account_name_result}"
	else # Normal locally logged in user.
		current_user_account_name="${current_user_account_name_result}"
		current_user_id=$(id -u "${current_user_account_name}" 2> /dev/null)
		current_user_guid=$(dscl /Search read "/Users/${current_user_account_name}" GeneratedUID 2> /dev/null | awk '{print $2;}')
		log_super "Status: Current user account (id): ${current_user_account_name} (${current_user_id})"
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_account_name is: ${current_user_account_name}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_id is: ${current_user_id}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_guid is: ${current_user_guid}"
	
	# Only collect user details if it's a "normal" GUI user.
	if [[ "${current_user_account_name}" != "FALSE" ]] && [[ "${current_user_id}" != "FALSE" ]] && [[ "${current_user_guid}" != "FALSE" ]]; then
		current_user_real_name=$(dscl /Search read "/Users/${current_user_account_name}" RealName 2> /dev/null | tail -1 | sed -e 's/^RealName: //g' -e 's/^ //g')
		current_user_home_folder=$(dscl /Search read "/Users/${current_user_account_name}" NFSHomeDirectory 2> /dev/null | awk '{print $2;}')
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_real_name is: ${current_user_real_name}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_home_folder is: ${current_user_home_folder}"
		current_user_is_admin="FALSE"
		current_user_has_secure_token="FALSE"
		current_user_is_volume_owner="FALSE"
		current_user_password_policies="FALSE"
		[[ $(groups "${current_user_account_name}" 2> /dev/null | grep -c 'admin') -gt 0 ]] && current_user_is_admin="TRUE"
		[[ $(dscl /Search read "/Users/${current_user_account_name}" AuthenticationAuthority 2> /dev/null | grep -c 'SecureToken') -gt 0 ]] && current_user_has_secure_token="TRUE"
		[[ $(diskutil apfs listcryptousers / 2> /dev/null | grep -c "${current_user_guid}") -gt 0 ]] && current_user_is_volume_owner="TRUE"
		[[ $(dscl /Search read "/Users/${current_user_account_name}" accountPolicyData 2> /dev/null | grep -c '<key>policies</key>') -gt 0 ]] && current_user_password_policies="TRUE"
		current_user_locale_identifier=$(launchctl asuser "${current_user_id}" sudo -u "${current_user_account_name}" defaults read "${current_user_home_folder}/Library/Preferences/.GlobalPreferences" AppleLocale 2> /dev/null) # Expected output: en_US
		if [[ -z "${current_user_locale_identifier}" ]]; then
			current_user_locale_identifier="${FAILOVER_LOCALE_IDENTIFIER}"
			log_super "Warning: Unable to determine current user language and region, using failover: ${current_user_locale_identifier}"
		fi
		local current_user_appearance_mode_result && current_user_appearance_mode_result=$(launchctl asuser "${current_user_id}" sudo -u "${current_user_account_name}" osascript -l 'JavaScript' -e "ObjC.import('AppKit'); $.NSAppearance.currentDrawingAppearance.bestMatchFromAppearancesWithNames(['NSAppearanceNameAqua', 'NSAppearanceNameDarkAqua']).js;" 2> /dev/null)
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_appearance_mode_result is: ${current_user_appearance_mode_result}"
		if [[ "${current_user_appearance_mode_result}" == "NSAppearanceNameAqua" ]]; then
			current_user_appearance_mode="LIGHT"
		elif [[ "${current_user_appearance_mode_result}" == "NSAppearanceNameDarkAqua" ]]; then
			current_user_appearance_mode="DARK"
		else
			current_user_appearance_mode="LIGHT"
			log_super "Warning: Unable to determine current user accent color, using failover light mode."
		fi
		local current_user_appearance_accent_color_result && current_user_appearance_accent_color_result=$(launchctl asuser "${current_user_id}" sudo -u "${current_user_account_name}" osascript -l JavaScript -e 'ObjC.import("AppKit"); $.NSColor.controlAccentColor.accessibilityName.js' 2> /dev/null)
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_appearance_accent_color_result is: ${current_user_appearance_accent_color_result}"
		# https://developer.apple.com/design/human-interface-guidelines/color#Specifications
		# The conversion from Apple's documentation (in RGB) to the results in swiftDialog's Markdown render (in HEX) are best judgement based on visual testing using an Apple display.
		if [[ -z "${current_user_appearance_accent_color_result}" ]]; then
			current_user_appearance_accent_color="blue"
			[[ "${current_user_appearance_mode}" == "LIGHT" ]] && current_user_appearance_accent_color_hex="1E6EF4" # System Blue increased contrast (light).
			[[ "${current_user_appearance_mode}" == "DARK" ]] && current_user_appearance_accent_color_hex="0091FF" # System Blue (dark).
			log_super "Warning: Unable to determine current user accent color, using failover System Blue."
		else
			case $current_user_appearance_accent_color_result in
				'azure')
					current_user_appearance_accent_color="blue"
					[[ "${current_user_appearance_mode}" == "LIGHT" ]] && current_user_appearance_accent_color_hex="1E6EF4" # System Blue increased contrast (light).
					[[ "${current_user_appearance_mode}" == "DARK" ]] && current_user_appearance_accent_color_hex="0091FF" # System Blue (dark).
					;;
				'dark magenta')
					current_user_appearance_accent_color="purple"
					[[ "${current_user_appearance_mode}" == "LIGHT" ]] && current_user_appearance_accent_color_hex="B02FC2" # System Purple increased contrast (light).
					[[ "${current_user_appearance_mode}" == "DARK" ]] && current_user_appearance_accent_color_hex="DB34F2" # System Purple (dark).
					;;
				'pink')
					current_user_appearance_accent_color="pink"
					[[ "${current_user_appearance_mode}" == "DARK" ]] && current_user_appearance_accent_color_hex="FF8AC4" # System Pink increased contrast (dark).
					[[ "${current_user_appearance_mode}" == "DARK" ]] && current_user_appearance_accent_color_hex="FF8AC4" # System Pink increased contrast (dark).
					;;
				'red')
					current_user_appearance_accent_color="red"
					[[ "${current_user_appearance_mode}" == "LIGHT" ]] && current_user_appearance_accent_color_hex="E9152D" # System Red increased contrast (light).
					[[ "${current_user_appearance_mode}" == "DARK" ]] && current_user_appearance_accent_color_hex="FF6165" # System Red increased contrast (dark).
					;;
				'orange')
					current_user_appearance_accent_color="orange"
					[[ "${current_user_appearance_mode}" == "LIGHT" ]] && current_user_appearance_accent_color_hex="FF8D28" # System Orange (light).
					[[ "${current_user_appearance_mode}" == "DARK" ]] && current_user_appearance_accent_color_hex="FF9230" # System Orange (dark).
					;;
				'amber')
					current_user_appearance_accent_color="yellow"
					[[ "${current_user_appearance_mode}" == "LIGHT" ]] && current_user_appearance_accent_color_hex="FFCC00" # System Yellow (light).
					[[ "${current_user_appearance_mode}" == "DARK" ]] && current_user_appearance_accent_color_hex="FFD600" # System Yellow (dark).
					;;
				'green')
					current_user_appearance_accent_color="green"
					[[ "${current_user_appearance_mode}" == "LIGHT" ]] && current_user_appearance_accent_color_hex="34C759" # System Green (light).
					[[ "${current_user_appearance_mode}" == "DARK" ]] && current_user_appearance_accent_color_hex="30D158" # System Green (dark).
					;;
				'gray')
					current_user_appearance_accent_color="gray"
					[[ "${current_user_appearance_mode}" == "LIGHT" ]] && current_user_appearance_accent_color_hex="8E8E93" # System Gray (light).
					[[ "${current_user_appearance_mode}" == "DARK" ]] && current_user_appearance_accent_color_hex="AEAEB2" # System Gray increased contrast (dark).
					;;
				*)
					current_user_appearance_accent_color="blue"
					[[ "${current_user_appearance_mode}" == "LIGHT" ]] && current_user_appearance_accent_color_hex="1E6EF4" # System Blue increased contrast (light).
					[[ "${current_user_appearance_mode}" == "DARK" ]] && current_user_appearance_accent_color_hex="0091FF" # System Blue (dark).
					;;
			esac
		fi
		current_user_alert_sound=$(launchctl asuser "${current_user_id}" sudo -u "${current_user_account_name}" defaults read "${current_user_home_folder}/Library/Preferences/.GlobalPreferences" com.apple.sound.beep.sound 2> /dev/null) # Expected output: en_US
		if [[ -z "${current_user_alert_sound}" ]]; then
			current_user_alert_sound="${FAILOVER_ALERT_SOUND}"
			log_super "Warning: Unable to determine current user alert sound, using failover: ${current_user_alert_sound}"
		fi
		[[ "${config_status_option}" == "TRUE" ]] && log_super "Status: Current user is admnistrator: ${current_user_is_admin}"
		[[ "${config_status_option}" == "TRUE" ]] && log_super "Status: Current user has a secure token: ${current_user_has_secure_token}"
		[[ "${config_status_option}" == "TRUE" ]] && log_super "Status: Current user is a system volume owner: ${current_user_is_volume_owner}"
		[[ "${config_status_option}" == "TRUE" ]] && log_super "Status: Current user password policies: ${current_user_password_policies}"
		[[ "${config_status_option}" == "TRUE" ]] && log_super "Status: Current user language and region: ${current_user_locale_identifier}"
		[[ "${config_status_option}" == "TRUE" ]] && log_super "Status: Current user appearance mode: ${current_user_appearance_mode}"
		[[ "${config_status_option}" == "TRUE" ]] && log_super "Status: Current user appearance accent color (HEX): ${current_user_appearance_accent_color} (${current_user_appearance_accent_color_hex})"
		[[ "${config_status_option}" == "TRUE" ]] && log_super "Status: Current user alert sound: ${current_user_alert_sound}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_is_admin is: ${current_user_is_admin}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_has_secure_token is: ${current_user_has_secure_token}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_is_volume_owner is: ${current_user_is_volume_owner}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_password_policies is: ${current_user_password_policies}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_locale_identifier is: ${current_user_locale_identifier}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_appearance_mode is: ${current_user_appearance_mode}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_appearance_accent_color_hex is: ${current_user_appearance_accent_color_hex}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: current_user_alert_sound is: ${current_user_alert_sound}"
	fi
}

# Validate that the account ${auth_local_account} and ${auth_local_password} are valid credentials to a volume owner. If not set ${auth_error_local}.
check_auth_local_account() {
	auth_error_local="FALSE"
	local auth_local_guid && auth_local_guid=$(dscl /Search read "/Users/${auth_local_account}" GeneratedUID 2> /dev/null | awk '{print $2;}')
	if [[ -n "${auth_local_guid}" ]]; then
		if [[ ! $(diskutil apfs listcryptousers / | grep -c "${auth_local_guid}") -gt 0 ]]; then
			log_super "Auth Error: The account \"${auth_local_account}\" is not a system volume owner."
			auth_error_local="TRUE"
		fi
		if [[ $(dscl /Local/Default -authonly "${auth_local_account}" "${auth_local_password}" 2>&1 | grep -c 'eDSAuthFailed') -gt 0 ]]; then
			log_super "Auth Error: The password for account \"${auth_local_account}\" is not valid."
			auth_error_local="TRUE"
		fi
	else
		log_super "Auth Error: Could not retrieve GUID for account \"${auth_local_account}\". Verify that account exists locally."
		auth_error_local="TRUE"
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_echo "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: auth_local_account: ${auth_local_account}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_echo "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: auth_local_password: ${auth_local_password}"
}

# Collect the available storage and set ${storage_ready} accordingly. This also sets ${storage_available_gigabytes} and ${storage_required_gigabytes}.
check_storage_available() {
	check_storage_available_error="FALSE"
	storage_ready="FALSE"
	{ [[ -z "${current_user_account_name}" ]] || [[ "${current_user_account_name}" == "FALSE" ]]; } && check_current_user
	[[ "${current_user_account_name}" != "FALSE" ]] && storage_available_gigabytes=$(osascript -l 'JavaScript' -e "ObjC.import('Foundation'); var freeSpaceBytesRef=Ref(); $.NSURL.fileURLWithPath('/').getResourceValueForKeyError(freeSpaceBytesRef, 'NSURLVolumeAvailableCapacityForImportantUsageKey', null); Math.round(ObjC.unwrap(freeSpaceBytesRef[0]) / 1000000000)")
	[[ "${current_user_account_name}" == "FALSE" ]] && storage_available_gigabytes=$(( $(system_profiler SPStorageDataType -json 2> /dev/null | jq -r '.SPStorageDataType[] | select(.mount_point == "/System/Volumes/Data") | .free_space_in_bytes // empty' 2> /dev/null) / 1000000000 ))
	if [[ -z "${storage_available_gigabytes}" ]] || [[ "${storage_available_gigabytes}" == "0" ]] || [[ ! "${storage_available_gigabytes}" =~ ${REGEX_ANY_WHOLE_NUMBER} ]]; then
		log_super "Warning: Initial attempt to determine available storage returned an unexpected value of ${storage_available_gigabytes}, attempting fallback method..."
		[[ "${current_user_account_name}" != "FALSE" ]] && storage_available_gigabytes=$(osascript -l 'JavaScript' -e "ObjC.import('Foundation'); var freeSpaceBytesRef=Ref(); $.NSURL.fileURLWithPath('/').getResourceValueForKeyError(freeSpaceBytesRef, 'NSURLVolumeAvailableCapacityKey', null); Math.round(ObjC.unwrap(freeSpaceBytesRef[0]) / 1000000000)")
		if [[ -z "${storage_available_gigabytes}" ]] || [[ "${storage_available_gigabytes}" == "0" ]] || [[ ! "${storage_available_gigabytes}" =~ ${REGEX_ANY_WHOLE_NUMBER} ]]; then
			log_super "Warning: Further attempts to determine available storage returned an unexpected value of ${storage_available_gigabytes}, attempting final fallback method..."
			storage_available_gigabytes=$(df -g / | tail -1 | awk '{print $4}')
		fi
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: storage_available_gigabytes: ${storage_available_gigabytes}"
	if [[ -z "${storage_available_gigabytes}" ]] || [[ "${storage_available_gigabytes}" == "0" ]] || [[ ! "${storage_available_gigabytes}" =~ ${REGEX_ANY_WHOLE_NUMBER} ]]; then
		log_super "Error: Unable to determine available storage."
		check_storage_available_error="TRUE"
	elif [[ "${installer_macos_major_upgrade_target}" != "FALSE" ]] || [[ "${installer_macos_minor_update_target}" != "FALSE" ]] || [[ "${msu_macos_major_upgrade_target}" != "FALSE" ]] || [[ "${msu_macos_minor_update_target}" != "FALSE" ]]; then
		{ [[ -z "${test_storage_update_option}" ]] && [[ $msu_macos_size -lt 5 ]]; } && storage_required_update_gb=$((msu_macos_size * 2))
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: installer_macos_download_required: ${installer_macos_download_required}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: installer_macos_size: ${installer_macos_size}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_macos_download_required: ${msu_macos_download_required}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_macos_size: ${msu_macos_size}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: storage_required_upgrade_gb: ${storage_required_upgrade_gb}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: storage_required_update_gb: ${storage_required_update_gb}"
		if [[ "${installer_macos_major_upgrade_target}" != "FALSE" ]] || [[ "${installer_macos_minor_update_target}" != "FALSE" ]]; then # Target is a macOS installer.
			if [[ "${installer_macos_download_required}" == "TRUE" ]]; then
				storage_required_gigabytes=$((storage_required_upgrade_gb + installer_macos_size))
			else # Download calculation is not required.
				storage_required_gigabytes="${storage_required_upgrade_gb}"
			fi
		fi
		if [[ "${msu_macos_major_upgrade_target}" != "FALSE" ]]; then # Target is a macOS major upgrade via MSU.
			if [[ "${msu_macos_download_required}" == "TRUE" ]]; then
				storage_required_gigabytes=$((storage_required_upgrade_gb + msu_macos_size))
			else # Download calculation is not required.
				storage_required_gigabytes="${storage_required_upgrade_gb}"
			fi
		fi
		if [[ "${msu_macos_minor_update_target}" != "FALSE" ]]; then # Target is a macOS minor update.
			if [[ "${msu_macos_download_required}" == "TRUE" ]]; then
				storage_required_gigabytes=$((storage_required_update_gb + msu_macos_size))
			else # Download calculation is not required.
				storage_required_gigabytes="${storage_required_update_gb}"
			fi
		fi
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: storage_required_gigabytes: ${storage_required_gigabytes}"
		[[ $storage_available_gigabytes -ge $storage_required_gigabytes ]] && storage_ready="TRUE"
	else # No macOS update/upgrade is available.
		storage_ready="TRUE"
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: check_storage_available_error: ${check_storage_available_error}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: storage_ready: ${storage_ready}"
}

# Validate if current system power is adequate for performing a macOS update/upgrade and set ${power_ready} accordingly. Desktops, obviously, always return that they are ready.
check_power_required() {
	local power_required_charger_connected="FALSE"
	check_power_required_error="FALSE"
	power_ready="FALSE"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: system_mac_model_portable: ${system_mac_model_portable}"
	if [[ "${system_mac_model_portable}" == "TRUE" ]]; then
		[[ $(pmset -g ps | grep -ic 'AC Power') -ne 0 ]] && power_required_charger_connected="TRUE"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: power_required_charger_connected: ${power_required_charger_connected}"
		if [[ "${power_required_charger_connected}" == "TRUE" ]]; then
			power_ready="TRUE"
		else # Not plugged into AC power.
			power_battery_percent=$(pmset -g ps | grep '%' | awk '{print $3;}' | sed -e 's/%;//g')
			[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: power_battery_percent: ${power_battery_percent}"
			if [[ -z "${power_battery_percent}" ]] || [[ ! "${power_battery_percent}" =~ ${REGEX_ANY_WHOLE_NUMBER} ]]; then
				log_super "Error: Unable to determine battery power level."
				check_power_required_error="TRUE"
			else # Battery level is a real number.
				[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: power_required_battery_percent: ${power_required_battery_percent}"
				[[ $power_battery_percent -gt $power_required_battery_percent ]] && power_ready="TRUE"
			fi
		fi
	else # Mac desktop.
		power_ready="TRUE"
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: check_power_required_error: ${check_power_required_error}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: power_ready: ${power_ready}"
}

