	else
		log_super "SOFA: Downloading new Safari feed..."
		local curl_response && curl_response=$(curl --user-agent "${SUPER_USER_AGENT}" --write-out "%{http_code}" --max-time "${TIMEOUT_START_SECONDS}" --compressed --location "${sofa_safari_url}" --etag-save "${sofa_safari_cache_etag_temp}" --output "${SOFA_SAFARI_CACHE_JSON}" 2>&1)
		sofa_safari_cache_etag=$(cat "${sofa_safari_cache_etag_temp}")
	fi
	rm -Rf "${sofa_safari_cache_etag_temp}" > /dev/null 2>&1
	
	# Verify the SOFA Safari feed download completed and is valid then save cache settings.
	if [[ $(echo "${curl_response}" | tail -n 1 | grep -c -E "${REGEX_HTTP_OK_STATUS}") -gt 0 ]] && [[ -f "${SOFA_SAFARI_CACHE_JSON}" ]] && [[ -n "${sofa_safari_cache_etag}" ]]; then
		if [[ $(jq -r '.UpdateHash // empty' "${SOFA_SAFARI_CACHE_JSON}" 2> /dev/null) ]]; then
			set_pref_main "SOFASafariChecksum" "$(md5 -q "${SOFA_SAFARI_CACHE_JSON}" 2> /dev/null)"
			set_pref_main "SOFASafariETag" "${sofa_safari_cache_etag}"
		else
			get_sofa_safari_feed_error="TRUE" && log_super "SOFA Error: The downloaded Safari feed ${SOFA_SAFARI_CACHE_JSON} appears to be invalid."
		fi
	elif [[ $(echo "${curl_response}" | grep -c 'Connection timed out') -gt 0 ]]; then
		get_sofa_safari_feed_error="TRUE" && log_super "SOFA Error: The Safari feed failed to verify or download, as indicated by no progress after waiting for ${TIMEOUT_START_SECONDS} seconds:\n${curl_response}"
	else
		get_sofa_safari_feed_error="TRUE" && log_super "SOFA Error: The Safari feed failed to download from: ${sofa_safari_url}:\n${curl_response}"
	fi
	unset curl_response
	if [[ "${get_sofa_safari_feed_error}" == "TRUE" ]]; then
		delete_pref_main "SOFASafariChecksum"
		delete_pref_main "SOFASafariETag"
		rm -f "${SOFA_SAFARI_CACHE_JSON}" 2> /dev/null
	fi
	find "${SUPER_CACHES_FOLDER}" -maxdepth 1 -type f -name "tmp*" -delete > /dev/null 2>&1
}

# Check for updates via the softwareupdate command to create the ${MSU_LIST_LOG} and set the ${msu_list} parameter. This is in a separate function to facilitate list caching and multiple run workflows.
# This also sets ${get_msu_list_error} and ${get_msu_list_timeout}.
get_msu_list() {
	msu_list="FALSE"
	
	if [[ -z "${MSU_LIST_DEBUG_LOG}" ]]; then # Background the softwareupdate checking process and send to ${MSU_LIST_LOG}.
		local get_msu_list_log="${MSU_LIST_LOG}"
		log_super "softwareupdate: Waiting for available updates listing..."
		sudo -u root softwareupdate --list > "${get_msu_list_log}" 2>&1 &
		local get_msu_list_pid="$!"
	else # Use static debug msu-list.log from ${MSU_LIST_DEBUG_LOG}.
		[[ ! -f "${MSU_LIST_DEBUG_LOG}" ]] && log_super "Error: Unable to locate debug msu-list.log at: ${MSU_LIST_DEBUG_LOG}"
		[[ ! -f "${MSU_LIST_DEBUG_LOG}" ]] && exit_error
		local get_msu_list_log="${MSU_LIST_DEBUG_LOG}"
		log_super "softwareupdate: Debug mode using static updates listing from: ${get_msu_list_log}"
	fi
	
	# Watch ${get_msu_list_log} while waiting for the softwareupdate list process to complete. Note this while read loop has a timeout based on ${TIMEOUT_START_SECONDS}.
	if [[ -z "${MSU_LIST_DEBUG_LOG}" ]]; then
		get_msu_list_error="TRUE"
		get_msu_list_timeout="TRUE"
		local get_msu_list_timeout_seconds="${TIMEOUT_START_SECONDS}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: get_msu_list_timeout is: ${get_msu_list_timeout}"
		while read -t "${get_msu_list_timeout_seconds}" -r log_line; do
			# log_super "Debug Mode: Function ${FUNCNAME[0]}: log_line is:\n${log_line}"
			if [[ $(echo "${log_line}" | grep -c "Can’t connect") -gt 0 ]] || [[ $(echo "${log_line}" | grep -c "Couldn't communicate") -gt 0 ]]; then
				break
			elif [[ $(echo "${log_line}" | grep -c 'Software Update found') -gt 0 ]]; then
				get_msu_list_error="FALSE"
				get_msu_list_timeout="FALSE"
				wait "${get_msu_list_pid}"
				break
			elif [[ $(echo "${log_line}" | grep -c 'No new software available.') -gt 0 ]]; then
				get_msu_list_error="FALSE"
				get_msu_list_timeout="FALSE"
				wait "${get_msu_list_pid}"
				break
			fi
		done < <(tail -n1 -F "${get_msu_list_log}")
	else
		get_msu_list_error="FALSE"
		get_msu_list_timeout="FALSE"
	fi
	
	# If the softwareupdate list completed, then collect information.
	if [[ "${get_msu_list_error}" == "FALSE" ]] && [[ "${get_msu_list_timeout}" == "FALSE" ]]; then
		msu_list=$(<"${get_msu_list_log}")
		[[ -z "${MSU_LIST_DEBUG_LOG}" ]] && set_pref_main "MSUListChecksum" "$(md5 -q "${get_msu_list_log}" 2> /dev/null)"
	else # softwareupdate list failures.
		[[ "${get_msu_list_error}" == "TRUE" ]] && log_super "softwareupdate Error: macOS software update listing failed, check ${get_msu_list_log} for more detail."
		[[ "${get_msu_list_timeout}" == "TRUE" ]] && log_super "softwareupdate Error: macOS software update listing failed to complete, as indicated by no progress after waiting for ${get_msu_list_timeout_seconds} seconds."
		kill -9 "${get_msu_list_pid}" > /dev/null 2>&1
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: get_msu_list_error is: ${get_msu_list_error}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: get_msu_list_timeout is: ${get_msu_list_timeout}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_list is:\n${msu_list}"
}

# Check for full macOS installers via the mist-cli command to create the ${MACOS_INSTALLERS_LIST_LOG} and set the ${macos_installers_list} parameter. This is in a separate function to facilitate list caching and multiple run workflows.
# This also sets ${get_macos_installers_list_error} and ${get_macos_installers_list_timeout}.
get_macos_installers_list() {
	macos_installers_list="FALSE"
	
	if [[ -z "${MACOS_INSTALLERS_LIST_DEBUG_LOG}" ]]; then # Background the mist-cli list process and send to ${MACOS_INSTALLERS_LIST_LOG}.
		local get_macos_installers_list_log="${MACOS_INSTALLERS_LIST_LOG}"
		if [[ "${system_macos_beta_enrollment}" == "FALSE" ]]; then
			"${MIST_CLI_BINARY}" list installer --output-type csv --no-ansi --compatible >"${get_macos_installers_list_log}" 2>&1 &
			local get_macos_installers_list_pid="$!"
		else # macOS beta workflow.
			"${MIST_CLI_BINARY}" list installer --output-type csv --no-ansi --compatible --include-betas >"${get_macos_installers_list_log}" 2>&1 &
			local get_macos_installers_list_pid="$!"
		fi
	else # Use static debug macos-installers-list.log from ${MACOS_INSTALLERS_LIST_DEBUG_LOG}.
		[[ ! -f "${MACOS_INSTALLERS_LIST_DEBUG_LOG}" ]] && log_super "Error: Unable to locate debug macos-installers-list.log at: ${MACOS_INSTALLERS_LIST_DEBUG_LOG}"
		[[ ! -f "${MACOS_INSTALLERS_LIST_DEBUG_LOG}" ]] && exit_error
		local get_macos_installers_list_log="${MACOS_INSTALLERS_LIST_DEBUG_LOG}"
		log_super "mist-cli: Debug mode using static updates listing from: ${get_macos_installers_list_log}"
	fi
	
	# Watch ${get_macos_installers_list_log} while waiting for the mist-cli list process to complete. Note this while read loop has a timeout based on ${TIMEOUT_START_SECONDS}.
	if [[ -z "${MACOS_INSTALLERS_LIST_DEBUG_LOG}" ]]; then
		get_macos_installers_list_error="TRUE"
		get_macos_installers_list_timeout="TRUE"
		local get_macos_installers_list_timeout_seconds="${TIMEOUT_START_SECONDS}"
		while read -t "${get_macos_installers_list_timeout_seconds}" -r log_line; do
			# log_super "Debug Mode: Function ${FUNCNAME[0]}: log_line is:\n${log_line}"
			if [[ $(echo "${log_line}" | grep -c 'SEARCH') -gt 0 ]]; then
				log_super "mist-cli: Waiting for macOS installers listing..."
			elif [[ $(echo "${log_line}" | grep -c 'Found 0') -gt 0 ]]; then
				get_macos_installers_list_timeout="FALSE"
				wait "${get_macos_installers_list_pid}"
				break
			elif [[ $(echo "${log_line}" | grep -c 'Found') -gt 0 ]]; then
				get_macos_installers_list_error="FALSE"
				get_macos_installers_list_timeout="FALSE"
				wait "${get_macos_installers_list_pid}"
				break
			fi
		done < <(tail -n1 -F "${get_macos_installers_list_log}")
	else
		get_macos_installers_list_error="FALSE"
		get_macos_installers_list_timeout="FALSE"
	fi
	
	# If the mist-cli list completed, then collect information.
	if [[ "${get_macos_installers_list_error}" == "FALSE" ]] && [[ "${get_macos_installers_list_timeout}" == "FALSE" ]]; then
		macos_installers_list=$(sed -e '1,/^Identifier/d' -e '/^$/d' < "${get_macos_installers_list_log}")
		[[ -z "${MACOS_INSTALLERS_LIST_DEBUG_LOG}" ]] && set_pref_main "MacOSInstallersListChecksum" "$(md5 -q "${get_macos_installers_list_log}" 2> /dev/null)"
	else
		[[ "${get_macos_installers_list_error}" == "TRUE" ]] && log_super "mist-cli Error: macOS installers listing failed, check ${get_macos_installers_list_log} for more detail."
		[[ "${get_macos_installers_list_timeout}" == "TRUE" ]] && log_super "mist-cli Error: macOS installers listing failed to complete, as indicated by no progress after waiting for ${get_macos_installers_list_timeout_seconds} seconds."
		kill -9 "${get_macos_installers_list_pid}" > /dev/null 2>&1
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: get_macos_installers_list_error is: ${get_macos_installers_list_error}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: get_macos_installers_list_timeout is: ${get_macos_installers_list_timeout}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: macos_installers_list is:\n${macos_installers_list}"
}

# This is the main workflow for checking all available macOS software including macOS major upgrades, macOS minor updates, and non-system software.
# This function sets ${msu_macos_major_upgrade_target}, ${installer_macos_major_upgrade_target}, ${msu_macos_minor_update_target}, ${installer_macos_minor_update_target}, ${msu_non_system_targets}, and ${msu_safari_target}.
# If there is a ${msu_macos_major_upgrade_target} or a ${msu_macos_minor_update_target} then this also sets ${msu_macos_label}, ${msu_macos_title}, ${msu_macos_version}, ${msu_macos_build}, and ${msu_macos_size}.
# If there is a ${installer_macos_major_upgrade_target} or ${installer_macos_minor_update_target}, then this also sets ${installer_macos_title}, ${installer_macos_version}, ${installer_macos_build}, and ${installer_macos_size}.
# If there is ${msu_non_system_targets} then this also sets ${msu_safari_target}, ${msu_non_system_labels_array[]} and ${msu_non_system_titles_array[]}.
workflow_check_software_status() {
	log_status "Running: Check for software update status workflow."
	sofa_macos_failover="FALSE"
	sofa_safari_failover="FALSE"
	msu_macos_major_upgrade_target="FALSE"
	installer_macos_major_upgrade_target="FALSE"
	macos_major_upgrade_latest="FALSE"
	msu_macos_minor_update_target="FALSE"
	installer_macos_minor_update_target="FALSE"
	macos_minor_update_latest="FALSE"
	msu_non_system_targets="FALSE"
	msu_safari_target="FALSE"
	local workflow_check_software_status_error="FALSE"
	
	# First check software update settings and caches to see if a full check can be avoided.
	check_msu_settings
	{ [[ -n "${MACOS_INSTALLERS_LIST_DEBUG_LOG}" ]] || [[ -n "${MSU_LIST_DEBUG_LOG}" ]]; } && check_software_status_required="TRUE"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: check_software_status_required is: ${check_software_status_required}"
	[[ "${check_software_status_required}" != "TRUE" ]] && check_software_update_status_cached
	[[ "${check_software_status_required}" == "TRUE" ]] && reset_software_update_status
	
	# Always with verifying/downloading SOFA feeds caches.
	get_sofa_feeds
	if [[ "${get_sofa_macos_feed_error}" == "TRUE" ]] || [[ "${get_sofa_safari_feed_error}" == "TRUE" ]] || [[ "${get_sofa_apple_beta_feed_error}" == "TRUE" ]]; then
		log_super "Warning: Re-starting SOFA feeds download and validation..."
		sleep 10
		get_sofa_feeds
	fi
	if [[ "${get_sofa_macos_feed_error}" == "TRUE" ]] || [[ "${get_sofa_safari_feed_error}" == "TRUE" ]] || [[ "${get_sofa_apple_beta_feed_error}" == "TRUE" ]]; then
		[[ "${get_sofa_macos_feed_error}" == "TRUE" ]] && [[ "${system_macos_beta_enrollment}" == "FALSE" ]] && sofa_macos_failover="TRUE" && log_super "Error: Downloading and validating the SOFA macOS feed did not complete after multiple attempts."
		[[ "${get_sofa_apple_beta_feed_error}" == "TRUE" ]] && [[ "${system_macos_beta_enrollment}" != "FALSE" ]] && sofa_macos_failover="TRUE" && log_super "Error: Downloading and validating the SOFA Apple beta feed did not complete after multiple attempts."
		[[ "${get_sofa_safari_feed_error}" == "TRUE" ]] && sofa_safari_failover="TRUE" && log_super "Error: Downloading and validating the SOFA Safari feed did not complete after multiple attempts."
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: get_sofa_macos_feed_error is: ${get_sofa_macos_feed_error}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: system_macos_beta_enrollment is: ${system_macos_beta_enrollment}"
	
	# If (no errors) parse SOFA macOS (non-beta) feed to resolve all possible supported macOS versions and set ${sofa_macos_major_upgrades_array[]}, ${sofa_macos_minor_updates_array[]}, and possibly ${sofa_macos_failover}.
	local previous_ifs="${IFS}" && IFS=$'\n'
	if [[ "${get_sofa_macos_feed_error}" == "FALSE" ]] && [[ "${system_macos_beta_enrollment}" == "FALSE" ]]; then
		local sofa_macos_supported_versions_major_array && sofa_macos_supported_versions_major_array=($(jq -r --arg system_mac_model_id "${system_mac_model_id}" '.Models[$system_mac_model_id].OSVersions[] // empty' "${SOFA_MACOS_CACHE_JSON}" 2> /dev/null))
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_macos_supported_versions_major_array is:\n${sofa_macos_supported_versions_major_array[*]}"
		if [[ ${#sofa_macos_supported_versions_major_array[@]} -gt 0 ]]; then
			if [[ $(echo "${sofa_macos_supported_versions_major_array[*]}" | grep -c "${system_macos_version_major}") -ge 1 ]]; then
				local sofa_macos_major_upgrades_array=()
				local sofa_macos_minor_all_versions_array=()
				local sofa_macos_minor_updates_array=()
				for sofa_macos_version in "${sofa_macos_supported_versions_major_array[@]}"; do
					if [[ $system_macos_version_major -lt $sofa_macos_version ]]; then
						sofa_macos_major_upgrades_array+=($(jq -r --arg macos_version_major "${sofa_macos_version}" '.OSVersions[] | select(.OSVersion | contains($macos_version_major)) | .SecurityReleases[].ProductVersion // empty' "${SOFA_MACOS_CACHE_JSON}" 2> /dev/null))
					elif [[ $system_macos_version_major -eq $sofa_macos_version ]]; then
						sofa_macos_minor_all_versions_array+=($(jq -r --arg macos_version_major "${sofa_macos_version}" '.OSVersions[] | select(.OSVersion | contains($macos_version_major)) | .SecurityReleases[].ProductVersion // empty' "${SOFA_MACOS_CACHE_JSON}" 2> /dev/null))
					fi
				done
				if [[ ${#sofa_macos_minor_all_versions_array[@]} -gt 0 ]]; then
					for sofa_macos_version in "${sofa_macos_minor_all_versions_array[@]}"; do
						[[ $system_macos_version_normalized -lt $(echo "${sofa_macos_version}" | awk -F'.' '{printf "%02d%02d%02d", $1, $2, $3}') ]] && sofa_macos_minor_updates_array+=("${sofa_macos_version}")
					done
					unset sofa_macos_minor_all_versions_array
				fi
			else
				sofa_macos_failover="TRUE" && log_super "SOFA Warning: Unable to find update listings for macOS ${system_macos_version_major} in macOS feed. Detailed macOS update/upgrade information (including release date) is not possible."
			fi
		else
			sofa_macos_failover="TRUE" && log_super "SOFA Warning: Unable to find supported macOS versions for Mac model ${system_mac_model_id} in macOS feed. Detailed macOS update/upgrade information (including release date) is not possible."
		fi
	fi
	
	# FIXME: This is unlikely to work given the current state of the SOFA Apple betas feed.
	# If (no errors) parse SOFA Apple beta feed to resolve all possible supported macOS versions and set ${sofa_macos_major_upgrades_array[]}, ${sofa_macos_minor_updates_array[]}, and possibly ${sofa_macos_failover}.
	if [[ "${get_sofa_apple_beta_feed_error}" == "FALSE" ]] && [[ "${system_macos_beta_enrollment}" != "FALSE" ]]; then
		local sofa_macos_supported_versions_major_array && sofa_macos_supported_versions_major_array=($(jq -r --arg system_mac_model_id "${system_mac_model_id}" '.Models[$system_mac_model_id].OSVersions[] // empty' "${SOFA_APPLE_BETA_CACHE_JSON}" 2> /dev/null))
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_macos_supported_versions_major_array is:\n${sofa_macos_supported_versions_major_array[*]}"
		if [[ ${#sofa_macos_supported_versions_major_array[@]} -gt 0 ]]; then
			if [[ $(echo "${sofa_macos_supported_versions_major_array[*]}" | grep -c "${system_macos_version_major}") -ge 1 ]]; then
				local sofa_macos_major_upgrades_array=()
				local sofa_macos_minor_all_versions_array=()
				local sofa_macos_minor_updates_array=()
				for sofa_macos_version in "${sofa_macos_supported_versions_major_array[@]}"; do
					if [[ $system_macos_version_major -lt $sofa_macos_version ]]; then
						sofa_macos_major_upgrades_array+=($(jq -r --arg macos_version_major "${sofa_macos_version}" '.OSVersions[] | select(.OSVersion | contains($macos_version_major)) | .SecurityReleases[].ProductVersion // empty' "${SOFA_APPLE_BETA_CACHE_JSON}" 2> /dev/null))
					elif [[ $system_macos_version_major -eq $sofa_macos_version ]]; then
						sofa_macos_minor_all_versions_array+=($(jq -r --arg macos_version_major "${sofa_macos_version}" '.OSVersions[] | select(.OSVersion | contains($macos_version_major)) | .SecurityReleases[].ProductVersion // empty' "${SOFA_APPLE_BETA_CACHE_JSON}" 2> /dev/null))
					fi
				done
				if [[ ${#sofa_macos_minor_all_versions_array[@]} -gt 0 ]]; then
					for sofa_macos_version in "${sofa_macos_minor_all_versions_array[@]}"; do
						[[ $system_macos_version_normalized -lt $(echo "${sofa_macos_version}" | awk -F'.' '{printf "%02d%02d%02d", $1, $2, $3}') ]] && sofa_macos_minor_updates_array+=("${sofa_macos_version}")
					done
					unset sofa_macos_minor_all_versions_array
				fi
			else
				sofa_macos_failover="TRUE" && log_super "SOFA Warning: Unable to find update listings for macOS ${system_macos_version_major} in Apple beta feed. Detailed macOS update/upgrade information (including release date) is not possible."
			fi
		else
			sofa_macos_failover="TRUE" && log_super "SOFA Warning: Unable to find supported macOS versions for Mac model ${system_mac_model_id} in Apple beta feed. Detailed macOS update/upgrade information (including release date) is not possible."
		fi
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_macos_major_upgrades_array is:\n${sofa_macos_major_upgrades_array[*]}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_macos_minor_updates_array is:\n${sofa_macos_minor_updates_array[*]}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_macos_failover is: ${sofa_macos_failover}"
	
	# If (no errors) parse SOFA Safari feed to resolve all possible Safari versions and set ${sofa_safari_updates_array[]} and possibly ${sofa_safari_failover}.
	if [[ "${get_sofa_safari_feed_error}" == "FALSE" ]] && [[ "${system_macos_beta_enrollment}" == "FALSE" ]]; then
		local sofa_safari_versions_array && sofa_safari_versions_array=($(jq -r --arg safari_version "Safari ${system_safari_version//\.*/}" '.AppVersions[] | select(.AppVersion == $safari_version) | .SecurityReleases[].ProductVersion // empty' "${SOFA_SAFARI_CACHE_JSON}" 2> /dev/null))
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_safari_versions_array is:\n${sofa_safari_versions_array[*]}"
		if [[ ${#sofa_safari_versions_array[@]} -gt 0 ]]; then
			local sofa_safari_updates_array=()
			for sofa_safari_version in "${sofa_safari_versions_array[@]}"; do
				[[ $system_safari_version_normalized -lt $(echo "${sofa_safari_version}" | awk -F'.' '{printf "%02d%02d%02d", $1, $2, $3}') ]] && sofa_safari_updates_array+=("${sofa_safari_version}")
			done
		else
			sofa_safari_failover="TRUE" && log_super "SOFA Warning: Unable to find update listings for Safari ${system_safari_version//\.*/} in Safari feed. Detailed Safari update information (including release date) is not possible."
		fi
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_safari_updates_array is:\n${sofa_safari_updates_array[*]}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_safari_failover is: ${sofa_safari_failover}"
	
	# If (no errors) there are available items then collect the ${msu_list} and parse to create ${msu_macos_major_upgrade}, ${msu_macos_minor_update}, and ${msu_non_system_array[]}.
	if [[ "${workflow_check_software_status_error}" == "FALSE" ]]; then
		# If required collecte a new ${msu_list}.
		if [[ "${check_software_status_required}" == "TRUE" ]] || [[ "${msu_list}" == "FALSE" ]] || [[ -z "${msu_list}" ]]; then
			get_msu_list
			
			# Error handling if softwareupdate is misbehaving.
			if [[ "${get_msu_list_error}" == "TRUE" ]] || [[ "${get_msu_list_timeout}" == "TRUE" ]]; then
				log_super "softwareupdate Warning: Re-starting softwareupdate available updates listing..."
				kick_softwareupdated
				sleep 10
				get_msu_list
			fi
			if [[ "${get_msu_list_error}" == "TRUE" ]] || [[ "${get_msu_list_timeout}" == "TRUE" ]]; then
				log_super "softwareupdate Error: Checking for softwareupdate available updates listing did not complete after multiple attempts."
				workflow_check_software_status_error="TRUE"
			fi
		fi
		
		# If there is a ${msu_list} then parse items to appropriate variables.
		if [[ "${workflow_check_software_status_error}" == "FALSE" ]]; then
			if [[ "${msu_list}" == "FALSE" ]] || [[ $(echo "${msu_list}" | grep -c 'No new software available.') -gt 0 ]]; then
				log_super "softwareupdate: Checking for macOS software update listing did not return any available updates."
