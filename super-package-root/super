# This function checks the validity of software updates/upgrade caches.
check_software_update_status_cached() {
	check_software_status_required="FALSE"
	macos_installers_list="FALSE"
	msu_list="FALSE"
	
	# Check how long ago the last successful macOS software check update was.
	local msu_last_sccessful_check_date && msu_last_sccessful_check_date=$(defaults read "${MSU_LOCAL_PLIST}" LastSuccessfulDate 2> /dev/null)
	[[ -n "${msu_last_sccessful_check_date}" ]] && local msu_last_sccessful_check_epoch && msu_last_sccessful_check_epoch=$(date -j -u -f "%Y-%m-%d %H:%M:%S %z" "${msu_last_sccessful_check_date}" +%s)
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_last_sccessful_check_date is: ${msu_last_sccessful_check_date}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_last_sccessful_check_epoch is: ${msu_last_sccessful_check_epoch}"
	local super_last_sccessful_check_date && super_last_sccessful_check_date=$(get_pref "LastSuccessfulCheckDate")
	[[ -n "${super_last_sccessful_check_date}" ]] && local super_last_sccessful_check_epoch && super_last_sccessful_check_epoch=$(date -j -u -f "%Y-%m-%d:%H:%M:%S" "${super_last_sccessful_check_date}" +%s)
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: super_last_sccessful_check_date is: ${super_last_sccessful_check_date}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: super_last_sccessful_check_epoch is: ${super_last_sccessful_check_epoch}"
	if [[ $msu_last_sccessful_check_epoch -lt $((workflow_time_epoch - (SOFTWARE_STATUS_CACHE_AGE_MINUTES * 60))) ]] && [[ $super_last_sccessful_check_epoch -lt $((workflow_time_epoch - (SOFTWARE_STATUS_CACHE_AGE_MINUTES * 60))) ]]; then
		log_super "Status: Last macOS software status check was more than $((SOFTWARE_STATUS_CACHE_AGE_MINUTES / 60)) hours ago, full software status check required."
		check_software_status_required="TRUE"
		return 0
	fi
	local system_last_startup_epoch && system_last_startup_epoch=$(date -j -u -f "%Y-%m-%d:%H:%M:%S" "${system_last_startup}" +%s)
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: system_last_startup_epoch is: ${system_last_startup_epoch}"
	if [[ $super_last_sccessful_check_epoch -lt $system_last_startup_epoch ]]; then
		log_super "Status: Last macOS software status check was before last system startup time, full software status check required."
		check_software_status_required="TRUE"
		return 0
	fi
	
	# Check the SOFA macOS feed cache.
	local sofa_macos_checksum && sofa_macos_checksum=$(get_pref "SOFAMacOSChecksum")
	local sofa_macos_cache_etag && sofa_macos_cache_etag=$(get_pref "SOFAMacOSETag")
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_macos_checksum is: ${sofa_macos_checksum}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_macos_cache_etag is: ${sofa_macos_cache_etag}"
	if [[ -z "${sofa_macos_checksum}" ]] || [[ -z "${sofa_macos_cache_etag}" ]] || [[ ! -f "${SOFA_MACOS_CACHE_JSON}" ]] || [[ "${sofa_macos_checksum}" != "$(md5 -q "${SOFA_MACOS_CACHE_JSON}" 2> /dev/null)" ]]; then
		log_super "Status: The SOFA macOS cache is not valid, full software status check required."
		check_software_status_required="TRUE"
		return 0
	fi
	
	# If needed, check the SOFA Apple beta feed cache.
	if [[ "${system_macos_beta_enrollment}" != "FALSE" ]]; then
		local sofa_apple_beta_checksum && sofa_apple_beta_checksum=$(get_pref "SOFAAppleBetaChecksum")
		local sofa_apple_beta_cache_etag && sofa_apple_beta_cache_etag=$(get_pref "SOFAAppleBetaETag")
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_apple_beta_checksum is: ${sofa_apple_beta_checksum}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_apple_beta_cache_etag is: ${sofa_apple_beta_cache_etag}"
		if [[ -z "${sofa_apple_beta_checksum}" ]] || [[ -z "${sofa_apple_beta_cache_etag}" ]] || [[ ! -f "${SOFA_APPLE_BETA_CACHE_JSON}" ]] || [[ "${sofa_apple_beta_checksum}" != "$(md5 -q "${SOFA_APPLE_BETA_CACHE_JSON}" 2> /dev/null)" ]]; then
			log_super "Status: The SOFA Apple beta cache is not valid, full software status check required."
			check_software_status_required="TRUE"
			return 0
		fi
	fi
	
	# Check the SOFA Safari feed cache.
	local sofa_safari_checksum && sofa_safari_checksum=$(get_pref "SOFASafariChecksum")
	local sofa_safari_cache_etag && sofa_safari_cache_etag=$(get_pref "SOFASafariETag")
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_safari_checksum is: ${sofa_safari_checksum}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: sofa_safari_cache_etag is: ${sofa_safari_cache_etag}"
	if [[ -z "${sofa_safari_checksum}" ]] || [[ -z "${sofa_safari_cache_etag}" ]] || [[ ! -f "${SOFA_SAFARI_CACHE_JSON}" ]] || [[ "${sofa_safari_checksum}" != "$(md5 -q "${SOFA_SAFARI_CACHE_JSON}" 2> /dev/null)" ]]; then
		log_super "Status: The SOFA Safari cache is not valid, full software status check required."
		check_software_status_required="TRUE"
		return 0
	fi
	
	# Check the macOS software update list cache.
	local msu_list_checksum_cache && msu_list_checksum_cache=$(get_pref "MSUListChecksum")
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_list_checksum_cache is: ${msu_list_checksum_cache}"
	if [[ -n "${msu_list_checksum_cache}" ]]; then
		if [[ "${msu_list_checksum_cache}" == "$(md5 -q "${MSU_LIST_LOG}" 2> /dev/null)" ]]; then
			msu_list=$(<"${MSU_LIST_LOG}")
		else
			log_super "Status: The ${MSU_LIST_LOG} has changed since last super workflow run, full software status check required."
			check_software_status_required="TRUE"
			return 0
		fi
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_list is:\n${msu_list}"
	
	# Check the macOS installers list cache.
	local macos_installers_list_checksum_cache && macos_installers_list_checksum_cache=$(get_pref "MacOSInstallersListChecksum")
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: macos_installers_list_checksum_cache is: ${macos_installers_list_checksum_cache}"
	if [[ -n "${macos_installers_list_checksum_cache}" ]]; then
		if [[ "${macos_installers_list_checksum_cache}" == "$(md5 -q "${MACOS_INSTALLERS_LIST_LOG}" 2> /dev/null)" ]]; then
			macos_installers_list=$(sed -e '1,/^Identifier/d' -e '/^$/d' < "${MACOS_INSTALLERS_LIST_LOG}")
		else
			log_super "Status: The ${MACOS_INSTALLERS_LIST_LOG} has changed since last super workflow run, full software status check required."
			check_software_status_required="TRUE"
			return 0
		fi
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: macos_installers_list is:\n${macos_installers_list}"
}

# Check for software update settings to set all ${msu_setting_*} parameters and report non-ideal configurations.
check_msu_settings() {
	msu_setting_automatic_check="TRUE"
	msu_setting_automatic_download="TRUE"
	msu_setting_automatic_macos_updates="TRUE"
	msu_setting_automatic_security_updates="TRUE"
	msu_setting_allow_standard_user_macos_updates="TRUE"
	msu_setting_show_notifications="TRUE"
	msu_setting_enable_macos_bsi_updates="TRUE"
	msu_setting_enable_macos_bsi_rollback="TRUE"
	msu_setting_defferal_macos_major_upgrades=""
	msu_setting_defferal_macos_minor_updates=""
	msu_setting_defferal_non_system_updates=""
	
	# Gather declarative software update state settings and set ${msu_ddm_state_json}.
	msu_ddm_state_json=$(plutil -convert json -o - "${MSU_DDM_STATE_PLIST}.plist" | jq -r '.' 2> /dev/null)
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_ddm_state_json is:\n${msu_ddm_state_json}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: MSU_MANAGED_PLIST is:\n$(defaults read "${MSU_MANAGED_PLIST}" 2>&1)"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: MSU_LOCAL_PLIST is:\n$(defaults read "${MSU_LOCAL_PLIST}" 2>&1)"
	if [[ $system_macos_version_major -ge 27 ]] && [[ -f "${MSU_MANAGED_PLIST}.plist" ]]; then
		log_super "Warning: Detected legacy configuration profile software udpate settings. This configuration method is not supported on macOS 27 or later."
	elif [[ $system_macos_version_major -ge 26 ]] && [[ -f "${MSU_MANAGED_PLIST}.plist" ]]; then
		log_super "Warning: Detected legacy configuration profile software udpate settings. This configuration method is deprecated on macOS 26 and will not be supported in macOS 27 or later."
	fi
	
	# Check for for automatic software update managed declarations as they supersede legacy configuration profile and local settings.
	[[ -n "${msu_ddm_state_json}" ]] && local msu_setting_automatic_download_declarative && msu_setting_automatic_download_declarative=$(echo "${msu_ddm_state_json}" | jq -r '.SUCorePersistedStatePolicyFields.SUCoreDDMDeclarationGlobalSettings.automaticallyDownload // empty' 2> /dev/null)
	[[ -n "${msu_setting_automatic_download_declarative}" ]] && [[ "${msu_setting_automatic_download_declarative}" == "0" ]] && msu_setting_automatic_download="FALSE"
	
	[[ -n "${msu_ddm_state_json}" ]] && local msu_setting_automatic_macos_updates_declarative && msu_setting_automatic_macos_updates_declarative=$(echo "${msu_ddm_state_json}" | jq -r '.SUCorePersistedStatePolicyFields.SUCoreDDMDeclarationGlobalSettings.automaticallyInstallOSUpdates // empty' 2> /dev/null)
	[[ -n "${msu_setting_automatic_macos_updates_declarative}" ]] && [[ "${msu_setting_automatic_macos_updates_declarative}" == "0" ]] && msu_setting_automatic_macos_updates="FALSE"
	
	[[ -n "${msu_ddm_state_json}" ]] && local msu_setting_automatic_security_updates_declarative && msu_setting_automatic_security_updates_declarative=$(echo "${msu_ddm_state_json}" | jq -r '.SUCorePersistedStatePolicyFields.SUCoreDDMDeclarationGlobalSettings.automaticallyInstallSystemAndSecurityUpdates // empty' 2> /dev/null)
	[[ -n "${msu_setting_automatic_security_updates_declarative}" ]] && [[ "${msu_setting_automatic_security_updates_declarative}" == "0" ]] && msu_setting_automatic_security_updates="FALSE"
	
	# Resolve ${msu_setting_automatic_check} given any managed declaration, legacy configuration profile, or local setting.
	[[ "${msu_setting_automatic_download_declarative}" == "0" ]] && [[ "${msu_setting_automatic_macos_updates_declarative}" == "0" ]] && [[ "${msu_setting_automatic_security_updates_declarative}" == "0" ]] && msu_setting_automatic_check="FALSE"
	if [[ "${msu_setting_automatic_check}" == "TRUE" ]] && [[ "${msu_setting_automatic_download_declarative}" != "1" ]] && [[ "${msu_setting_automatic_macos_updates_declarative}" != "1" ]] && [[ "${msu_setting_automatic_security_updates_declarative}" != "1" ]]; then
		[[ $system_macos_version_major -lt 27 ]] && local msu_setting_automatic_check_managed && msu_setting_automatic_check_managed=$(defaults read "${MSU_MANAGED_PLIST}" AutomaticCheckEnabled 2> /dev/null)
		[[ -n "${msu_setting_automatic_check_managed}" ]] && [[ "${msu_setting_automatic_check_managed}" == "0" ]] && msu_setting_automatic_check="FALSE"
		[[ -z "${msu_setting_automatic_check_managed}" ]] && msu_setting_automatic_check_local=$(defaults read "${MSU_LOCAL_PLIST}" AutomaticCheckEnabled 2> /dev/null)
		[[ -n "${msu_setting_automatic_check_local}" ]] && [[ "${msu_setting_automatic_check_local}" == "0" ]] && msu_setting_automatic_check="FALSE"
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_setting_automatic_check is: ${msu_setting_automatic_check}"
	
	# If automatic software update is enabled then resolve remaining ${msu_setting_automatic_*} parameters given any managed declarations, legacy configuration profile, or local settings.
	if [[ "${msu_setting_automatic_check}" == "TRUE" ]]; then
		[[ $system_macos_version_major -lt 27 ]] && [[ -z "${msu_setting_automatic_download_declarative}" ]] && local msu_setting_automatic_download_managed && msu_setting_automatic_download_managed=$(defaults read "${MSU_MANAGED_PLIST}" AutomaticDownload 2> /dev/null)
		[[ -n "${msu_setting_automatic_download_managed}" ]] && [[ "${msu_setting_automatic_download_managed}" == "0" ]] && msu_setting_automatic_download="FALSE"
		[[ -z "${msu_setting_automatic_download_declarative}" ]] && [[ -z "${msu_setting_automatic_download_managed}" ]] && local msu_setting_automatic_download_local && msu_setting_automatic_download_local=$(defaults read "${MSU_LOCAL_PLIST}" AutomaticDownload 2> /dev/null)
		[[ "${msu_setting_automatic_download_local}" == "0" ]] && msu_setting_automatic_download="FALSE"
		
		[[ $system_macos_version_major -lt 27 ]] && [[ -z "${msu_setting_automatic_macos_updates_declarative}" ]] && local msu_setting_automatic_macos_updates_managed && msu_setting_automatic_macos_updates_managed=$(defaults read "${MSU_MANAGED_PLIST}" AutomaticallyInstallMacOSUpdates 2> /dev/null)
		[[ -n "${msu_setting_automatic_macos_updates_managed}" ]] && [[ "${msu_setting_automatic_macos_updates_managed}" == "0" ]] && msu_setting_automatic_macos_updates="FALSE"
		[[ -z "${msu_setting_automatic_macos_updates_declarative}" ]] && [[ -z "${msu_setting_automatic_macos_updates_managed}" ]] && local msu_setting_automatic_macos_updates_local && msu_setting_automatic_macos_updates_local=$(defaults read "${MSU_LOCAL_PLIST}" AutomaticallyInstallMacOSUpdates 2> /dev/null)
		[[ "${msu_setting_automatic_macos_updates_local}" == "0" ]] && msu_setting_automatic_macos_updates="FALSE"
		
		[[ $system_macos_version_major -lt 27 ]] && [[ -z "${msu_setting_automatic_security_updates_declarative}" ]] && local msu_automatic_config_data_managed && msu_automatic_config_data_managed=$(defaults read "${MSU_MANAGED_PLIST}" ConfigDataInstall 2> /dev/null)
		[[ $system_macos_version_major -lt 27 ]] && [[ -z "${msu_setting_automatic_security_updates_declarative}" ]] && local msu_automatic_critical_update_managed && msu_automatic_critical_update_managed=$(defaults read "${MSU_MANAGED_PLIST}" CriticalUpdateInstall 2> /dev/null)
		{ { [[ -n "${msu_automatic_config_data_managed}" ]] && [[ "${msu_automatic_config_data_managed}" == "0" ]]; } || { [[ -n "${msu_automatic_critical_update_managed}" ]] && [[ "${msu_automatic_critical_update_managed}" == "0" ]]; }; } && msu_setting_automatic_security_updates="FALSE"
		[[ -z "${msu_setting_automatic_security_updates_declarative}" ]] && [[ -z "${msu_automatic_config_data_managed}" ]] && local msu_automatic_config_data_local && msu_automatic_config_data_local=$(defaults read "${MSU_LOCAL_PLIST}" ConfigDataInstall 2> /dev/null)
		[[ -z "${msu_setting_automatic_security_updates_declarative}" ]] && [[ -z "${msu_automatic_critical_update_managed}" ]] && local msu_automatic_critical_update_local && msu_automatic_critical_update_local=$(defaults read "${MSU_LOCAL_PLIST}" CriticalUpdateInstall 2> /dev/null)
		{ { [[ -n "$msu_automatic_config_data_local" ]] && [[ "${msu_automatic_config_data_local}" == "0" ]]; } || { [[ -n "${msu_automatic_critical_update_local}" ]] && [[ "${msu_automatic_critical_update_local}" == "0" ]]; }; } && msu_setting_automatic_security_updates="FALSE"
	else
		msu_setting_automatic_download="FALSE"
		msu_setting_automatic_macos_updates="FALSE"
		msu_setting_automatic_security_updates="FALSE"
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_setting_automatic_download is: ${msu_setting_automatic_download}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_setting_automatic_macos_updates is: ${msu_setting_automatic_macos_updates}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_setting_automatic_security_updates is: ${msu_setting_automatic_security_updates}"
	[[ "${msu_setting_automatic_macos_updates}" == "TRUE" ]] && log_super "Warning: Automatic download and installation of macOS updates is currently enabled, this can result in updates being installed outside of super workflows."
	[[ "${msu_setting_automatic_security_updates}" == "FALSE" ]] && log_super "Warning: Automatic installation of macOS security updates is disabled, this is a significant security risk."
	
	# Resolve additional non-deferral software update settings.
	[[ -n "${msu_ddm_state_json}" ]] && local msu_setting_allow_standard_user_macos_updates_declarative && msu_setting_allow_standard_user_macos_updates_declarative=$(echo "${msu_ddm_state_json}" | jq -r '.SUCorePersistedStatePolicyFields.SUCoreDDMDeclarationGlobalSettings.adminInstallRequired // empty' 2> /dev/null)
	[[ -n "${msu_setting_allow_standard_user_macos_updates_declarative}" ]] && [[ "${msu_setting_allow_standard_user_macos_updates_declarative}" == "1" ]] && msu_setting_allow_standard_user_macos_updates="FALSE"
	[[ $system_macos_version_major -lt 27 ]] && [[ -z "${msu_setting_allow_standard_user_macos_updates_declarative}" ]] && local msu_setting_allow_standard_user_macos_updates_managed && msu_setting_allow_standard_user_macos_updates_managed=$(defaults read "${MSU_MANAGED_PLIST}" "restrict-software-update-require-admin-to-install" 2> /dev/null)
	[[ -n "${msu_setting_allow_standard_user_macos_updates_managed}" ]] && [[ "${msu_setting_allow_standard_user_macos_updates_managed}" == "1" ]] && msu_setting_allow_standard_user_macos_updates="FALSE"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_setting_allow_standard_user_macos_updates is: ${msu_setting_allow_standard_user_macos_updates}"
	
	[[ -n "${msu_ddm_state_json}" ]] && local msu_setting_show_notifications_declarative && msu_setting_show_notifications_declarative=$(echo "${msu_ddm_state_json}" | jq -r '.SUCorePersistedStatePolicyFields.SUCoreDDMDeclarationGlobalSettings.enableGlobalNotifications // empty' 2> /dev/null)
	[[ -n "${msu_setting_show_notifications_declarative}" ]] && [[ "${msu_setting_show_notifications_declarative}" != "true" ]] && msu_setting_show_notifications="FALSE"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_setting_show_notifications is: ${msu_setting_show_notifications}"
	
	[[ -n "${msu_ddm_state_json}" ]] && local msu_setting_enable_macos_bsi_updates_declarative && msu_setting_enable_macos_bsi_updates_declarative=$(echo "${msu_ddm_state_json}" | jq -r '.SUCorePersistedStatePolicyFields.SUCoreDDMDeclarationGlobalSettings.enableRapidSecurityResponse // empty' 2> /dev/null)
	[[ -n "${msu_setting_enable_macos_bsi_updates_declarative}" ]] && [[ "${msu_setting_enable_macos_bsi_updates_declarative}" != "true" ]] && msu_setting_enable_macos_bsi_updates="FALSE"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_setting_enable_macos_bsi_updates is: ${msu_setting_enable_macos_bsi_updates}"
	
	[[ -n "${msu_ddm_state_json}" ]] && local msu_setting_enable_macos_bsi_rollback_declarative && msu_setting_enable_macos_bsi_rollback_declarative=$(echo "${msu_ddm_state_json}" | jq -r '.SUCorePersistedStatePolicyFields.SUCoreDDMDeclarationGlobalSettings.enableRapidSecurityResponseRollback // empty' 2> /dev/null)
	[[ -n "${msu_setting_enable_macos_bsi_rollback_declarative}" ]] && [[ "${msu_setting_enable_macos_bsi_rollback_declarative}" != "true" ]] && msu_setting_enable_macos_bsi_rollback="FALSE"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_setting_enable_macos_bsi_rollback is: ${msu_setting_enable_macos_bsi_rollback}"
	
	# Check for for software update deferral declarations as they supersede legacy configuration profile settings.
	[[ -n "${msu_ddm_state_json}" ]] && local msu_setting_defferal_macos_major_upgrades_declarative && msu_setting_defferal_macos_major_upgrades_declarative=$(echo "${msu_ddm_state_json}" | jq -r '.SUCorePersistedStatePolicyFields.SUCoreDDMDeclarationGlobalSettings.majorOSDeferralPeriod // empty' 2> /dev/null)
	[[ -n "${msu_setting_defferal_macos_major_upgrades_declarative}" ]] && msu_setting_defferal_macos_major_upgrades="${msu_setting_defferal_macos_major_upgrades_declarative}" && log_super "Status: A managed declaration is deferring macOS major upgrades for ${msu_setting_defferal_macos_major_upgrades} days."
	
	[[ -n "${msu_ddm_state_json}" ]] && local msu_setting_defferal_macos_minor_updates_declarative && msu_setting_defferal_macos_minor_updates_declarative=$(echo "${msu_ddm_state_json}" | jq -r '.SUCorePersistedStatePolicyFields.SUCoreDDMDeclarationGlobalSettings.minorOSDeferralPeriod // empty' 2> /dev/null)
	[[ -n "${msu_setting_defferal_macos_minor_updates_declarative}" ]] && msu_setting_defferal_macos_minor_updates="${msu_setting_defferal_macos_minor_updates_declarative}" && log_super "Status: A managed declaration is deferring macOS minor updates for ${msu_setting_defferal_macos_minor_updates} days."
	
	[[ -n "${msu_ddm_state_json}" ]] && local msu_setting_defferal_non_system_updates_declarative && msu_setting_defferal_non_system_updates_declarative=$(echo "${msu_ddm_state_json}" | jq -r '.SUCorePersistedStatePolicyFields.SUCoreDDMDeclarationGlobalSettings.systemUpdatesDeferralPeriod // empty' 2> /dev/null)
	[[ -n "${msu_setting_defferal_non_system_updates_declarative}" ]] && msu_setting_defferal_non_system_updates="${msu_setting_defferal_non_system_updates_declarative}" && log_super "Status: A managed declaration is deferring non-system updates for ${msu_setting_defferal_non_system_updates} days."
	
	# If legacy configuration profile software update deferral settings exist then resolve any ${msu_setting_defferals_*} parameters.
	[[ -f "${MSU_APPLICATION_ACCESS_MANAGED_PLIST}.plist" ]] && local msu_setting_deferral_restrictions_result && msu_setting_deferral_restrictions_result=$(defaults read "${MSU_APPLICATION_ACCESS_MANAGED_PLIST}" 2> /dev/null | grep -E 'enforcedSoftware|forceDelayed' | tr -d ';')
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_setting_deferral_restrictions_result is:\n${msu_setting_deferral_restrictions_result}"
	if [[ -n "${msu_setting_deferral_restrictions_result}" ]]; then
		if [[ $system_macos_version_major -ge 27 ]]; then
			log_super "Warning: Detected legacy configuration profile managed software udpate deferral settings. This configuration method is not supported on macOS 27 or later."
		else
			[[ $system_macos_version_major -ge 26 ]] && log_super "Warning: Detected legacy configuration profile managed software udpate deferral settings. This configuration method is deprecated on macOS 26 and will not be supported in macOS 27 or later."
			if [[ -z "${msu_setting_defferal_macos_major_upgrades_declarative}" ]]; then
				[[ $(echo "${msu_setting_deferral_restrictions_result}" | awk '/forceDelayedMajorSoftwareUpdates/ {print $3}') -gt 0 ]] && msu_setting_defferal_macos_major_upgrades=30
				[[ $(echo "${msu_setting_deferral_restrictions_result}" | awk '/enforcedSoftwareUpdateMajorOSDeferredInstallDelay/ {print $3}') -gt 0 ]] && msu_setting_defferal_macos_major_upgrades=$(echo "${msu_setting_deferral_restrictions_result}" | awk '/enforcedSoftwareUpdateMajorOSDeferredInstallDelay/ {print $3}')
				[[ -n "${msu_setting_defferal_macos_major_upgrades}" ]] && log_super "Status: A legacy configuration profile is deferring macOS major upgrades for ${msu_setting_defferal_macos_major_upgrades} days."
			fi
			if [[ -z "${msu_setting_defferal_macos_minor_updates_declarative}" ]]; then
				[[ $(echo "${msu_setting_deferral_restrictions_result}" | awk '/forceDelayedSoftwareUpdates/ {print $3}') -gt 0 ]] && msu_setting_defferal_macos_minor_updates=30
				[[ $(echo "${msu_setting_deferral_restrictions_result}" | awk '/enforcedSoftwareUpdateDelay/ {print $3}') -gt 0 ]] && msu_setting_defferal_macos_minor_updates=$(echo "${msu_setting_deferral_restrictions_result}" | awk '/enforcedSoftwareUpdateDelay/ {print $3}')
				[[ $(echo "${msu_setting_deferral_restrictions_result}" | awk '/enforcedSoftwareUpdateMinorOSDeferredInstallDelay/ {print $3}') -gt 0 ]] && msu_setting_defferal_macos_minor_updates=$(echo "${msu_setting_deferral_restrictions_result}" | awk '/enforcedSoftwareUpdateMinorOSDeferredInstallDelay/ {print $3}')
				[[ -n "${msu_setting_defferal_macos_minor_updates}" ]] && log_super "Status: A legacy configuration profile is deferring macOS minor updates for ${msu_setting_defferal_macos_minor_updates} days."
			fi
			if [[ -z "${msu_setting_defferal_non_system_updates_declarative}" ]]; then
				[[ $(echo "${msu_setting_deferral_restrictions_result}" | awk '/forceDelayedAppSoftwareUpdates/ {print $3}') -gt 0 ]] && msu_setting_defferal_non_system_updates=30
				[[ $(echo "${msu_setting_deferral_restrictions_result}" | awk '/enforcedSoftwareUpdateDelay/ {print $3}') -gt 0 ]] && msu_setting_defferal_non_system_updates=$(echo "${msu_setting_deferral_restrictions_result}" | awk '/enforcedSoftwareUpdateDelay/ {print $3}')
				[[ $(echo "${msu_setting_deferral_restrictions_result}" | awk '/enforcedSoftwareUpdateNonOSDeferredInstallDelay/ {print $3}') -gt 0 ]] && msu_setting_defferal_non_system_updates=$(echo "${msu_setting_deferral_restrictions_result}" | awk '/enforcedSoftwareUpdateNonOSDeferredInstallDelay/ {print $3}')
				[[ -n "${msu_setting_defferal_non_system_updates}" ]] && log_super "Status: A legacy configuration profile is deferring non-system updates for ${msu_setting_defferal_non_system_updates} days."
			fi
		fi
	fi
	[[ -z "${msu_setting_defferal_macos_major_upgrades}" ]] && msu_setting_defferal_macos_major_upgrades="FALSE"
	[[ -z "${msu_setting_defferal_macos_minor_updates}" ]] && msu_setting_defferal_macos_minor_updates="FALSE"
	[[ -z "${msu_setting_defferal_non_system_updates}" ]] && msu_setting_defferal_non_system_updates="FALSE"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_setting_defferal_macos_major_upgrades is: ${msu_setting_defferal_macos_major_upgrades}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_setting_defferal_macos_minor_updates is: ${msu_setting_defferal_macos_minor_updates}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_setting_defferal_non_system_updates is: ${msu_setting_defferal_non_system_updates}"
}

