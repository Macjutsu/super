# Download a display asset from provided URL ${1} and return either the path to a temporary file or "ERROR" and then the error from attempted download.
get_display_asset() {
	local get_display_asset_clean_path get_display_asset_clean_path="${1%%[?#]*}"
	local get_display_asset_file_extension get_display_asset_file_extension="${get_display_asset_clean_path##*.}"
	local get_display_asset_temp && get_display_asset_temp="$(mktemp -p "${SUPER_CACHES_FOLDER}").${get_display_asset_file_extension}"
	local curl_response && curl_response=$(curl --user-agent "${SUPER_USER_AGENT}" --write-out "%{http_code}" --max-time "${TIMEOUT_START_SECONDS}" --location "${1}" --output "${get_display_asset_temp}" 2>&1)
	if [[ $(echo "${curl_response}" | tail -n 1 | grep -c -E "${REGEX_HTTP_OK_STATUS}") -gt 0 ]] && [[ -f "${get_display_asset_temp}" ]]; then
		echo "${get_display_asset_temp}"
	else
		echo -e "ERROR\n${curl_response}"
	fi
}

# Convert a display asset from provided local path ${1} to a PNG and return either the path to a temporary file or "ERROR" and then the error from attempted download.
convert_display_asset() {
	local convert_display_asset_temp && convert_display_asset_temp="$(mktemp -p "${SUPER_CACHES_FOLDER}").png"
	local sips_result && sips_result=$(sips --setProperty format png "${1}" --out "${convert_display_asset_temp}" 2>&1)
	if [[ $(echo "${sips_result}" | grep -c 'Warning') -eq 0 ]] && [[ $(echo "${sips_result}" | grep -c 'Error') -eq 0 ]] && [[ -f "${convert_display_asset_temp}" ]]; then
		echo "${convert_display_asset_temp}"
	else
		echo -e "ERROR\n${sips_result}"
	fi
}

# Set a variety of custom display assets including ${display_dialog_banner_*}, ${display_background_*}, ${display_icon_*}, ${display_more_info_custom_url_url}, ${display_help_message_path}, and ${display_string_target}.
