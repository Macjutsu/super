				[[ -f "${display_icon_path}" ]] && chmod a+r "${display_icon_path}" 2> /dev/null 2>&1
				[[ -f "${display_icon_path}" ]] && set_pref_main "DisplayIconMacOSCache" "${display_icon_path}"
