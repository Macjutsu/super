	# Kill any previous notifications so new ones can take its place.
	echo "quit:" >> "${SWIFT_DIALOG_COMMAND_FILE}" && sleep 0.1
	killall -9 "dialog" "Dialog" > /dev/null 2>&1
	
	# (If not testing a display function) Start background metrics collection for interactive dialog.
	if [[ -z "${test_display_function_option}" ]]; then
		log_metrics "Open Dialog ${FUNCNAME[1]}: Workflow Elapsed Time" "WorkflowTargetTimestamp"
		local dialog_metrics_counter_fifo && dialog_metrics_counter_fifo="$(mktemp -p "${SUPER_CACHES_FOLDER}").fifo"
		mkfifo "${dialog_metrics_counter_fifo}"
		dialog_metrics_counter "${dialog_metrics_counter_fifo}" &
		local dialog_metrics_counter_pid="$!"
	fi
	
	# Start swift Dialog and wait for for ${display_dialog_result} and ${display_dialog_return}.
	[[ -z $dialog_timeout_seconds ]] && log_super "Display Status: Opening ${FUNCNAME[1]} with no dialog timeout..."
	[[ -n $dialog_timeout_seconds ]] && log_super "Display Status: Opening ${FUNCNAME[1]} with a ${dialog_timeout_seconds} second timeout...."
	[[ -n "${test_display_function_option}" ]] && log_super "Test Display Function Warning: If there are no display buttons, then you must use the COMMAND+S keyboard shortcut to close the test window."
	display_dialog_result=$("${SWIFT_DIALOG_BINARY}" --jsonstring "$(jq -c . <<< "${dialog_json}")")
	display_dialog_return="$?"
	{ [[ -n "${test_display_function_option}" ]] || [[ "${verbose_mode}" == "TRUE" ]]; } && [[ "${FUNCNAME[1]}" != "dialog_user_auth" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: display_dialog_result is:\n${display_dialog_result}"
	{ [[ -n "${test_display_function_option}" ]] || [[ "${verbose_mode}" == "TRUE" ]]; } && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: display_dialog_return is: ${display_dialog_return}"
	
	# (If not testing a display function) Collect and report dialog metrics.
	if [[ -z "${test_display_function_option}" ]]; then
		kill "${dialog_metrics_counter_pid}"
		local dialog_metrics_result && dialog_metrics_result=$(cat "${dialog_metrics_counter_fifo}")
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: dialog_metrics_result is: ${dialog_metrics_result}"
		rm -Rf "${dialog_metrics_counter_fifo}" > /dev/null 2>&1
		log_metrics "Close Dialog ${FUNCNAME[1]}: User Active Elapsed Time" "$(echo "${dialog_metrics_result}" | awk -F ':' '{print $1}')"
		log_metrics "Close Dialog ${FUNCNAME[1]}: User Inactive Elapsed Time" "$(echo "${dialog_metrics_result}" | awk -F ':' '{print $2}')"
		log_metrics "Close Dialog ${FUNCNAME[1]}: Dialog Elapsed Time" "$(echo "${dialog_metrics_result}" | awk -F ':' '{print $3}')"
	fi
}

