# Install any ${install_jamf_policy_triggers}.
run_jamf_pro_policy_triggers() {
	jamf_pro_policy_error="FALSE"
	log_super "Status: Installing Jamf Pro Policy triggers. Use --verbose-mode or check /var/log/jamf.log for more detail..."
	log_status "Running: Installing Jamf Pro Policy triggers."
	local previous_ifs="${IFS}" && IFS=','
	local jamf_pro_policy_triggers_array && read -r -a jamf_pro_policy_triggers_array <<<"${install_jamf_policy_triggers}"
	for jamf_pro_policy_trigger in "${jamf_pro_policy_triggers_array[@]}"; do
		[[ "${current_user_account_name}" != "FALSE" ]] && notification_jamf_pro_policy & disown
		if [[ "${test_mode}" != "TRUE" ]]; then
			log_super "Status: Jamf Pro Policy with Trigger \"${jamf_pro_policy_trigger}\" is starting..."
			if [[ "${verbose_mode}" == "TRUE" ]]; then
				local jamf_result && jamf_result=$("${JAMF_PRO_BINARY}" policy -event "${jamf_pro_policy_trigger}" -verbose 2>&1)
				local jamf_return="$?"
				log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: jamf_result is:\n${jamf_result}"
				log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: jamf_return is: ${jamf_return}"
			else
				"${JAMF_PRO_BINARY}" policy -event "${jamf_pro_policy_trigger}" > /dev/null 2>&1
				local jamf_return="$?"
			fi
			if [[ $jamf_return -ne 0 ]]; then
				log_super "Error: Jamf Pro Policy with Trigger \"${jamf_pro_policy_trigger}\" failed!"
				jamf_pro_policy_error="TRUE"
			else
				log_super_audit "Status: Jamf Pro Policy with Trigger \"${jamf_pro_policy_trigger}\" was successful."
			fi
		else
			log_super "Test Mode: Skipping Jamf Pro Policy with Trigger: ${jamf_pro_policy_trigger}."
			if [[ "${current_user_account_name}" != "FALSE" ]]; then
				log_super "Test Mode: Pausing ${test_mode_timeout_seconds} seconds for the Jamf Pro Policy notification..."
				sleep "${test_mode_timeout_seconds}"
			fi
		fi
	done
	IFS="${previous_ifs}"
	{ [[ "${workflow_target}" == "Jamf Pro Policy Triggers Without Restarting" ]] && [[ "${current_user_account_name}" != "FALSE" ]]; } && echo "quit:" >> "${SWIFT_DIALOG_COMMAND_FILE}" && sleep 0.1
	
	# Wrap-up Jamf Pro Policies workflow.
	if [[ "${jamf_pro_policy_error}" != "TRUE" ]]; then
		log_super_audit "Status: All Jamf Pro Policies completed."
	else # Handle workflow failure options.
		if [[ "${workflow_install_now_active}" == "TRUE" ]]; then # Install now workflow mode.
			log_super "Error: Some Jamf Pro Policies failed, install now workflow can not continue."
			log_status "Inactive Error: Some Jamf Pro Policies failed, install now workflow can not continue."
			[[ "${current_user_account_name}" != "FALSE" ]] && notification_install_now_failed & disown
			exit_error
		else # Default super workflow.
			deferral_timer_minutes=$deferral_timer_error_minutes
			log_super "Error: macOS update/upgrade workflow failed, trying again in ${deferral_timer_minutes} minutes."
			log_status "Pending: macOS update/upgrade workflow failed, trying again in ${deferral_timer_minutes} minutes."
			[[ "${current_user_account_name}" != "FALSE" ]] && notification_failed & disown
			set_auto_launch_deferral
		fi
	fi
}

