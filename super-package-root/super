# Check swiftDialog application for validity and version number.
check_swift_dialog() {
	swift_dialog_valid="FALSE"
	local codesign_result && codesign_result=$(codesign --verify --verbose "${swift_dialog_app}" 2>&1)
	if [[ $(echo "${codesign_result}" | grep -c 'valid on disk') -gt 0 ]]; then
		local version_result && version_result=$("${SWIFT_DIALOG_BINARY}" --version 2> /dev/null | head -1 | awk -F '.' '{print $1"."$2"."$3;}') # Expected output: 3.1.2
		if [[ -n "${version_result}" ]] && [[ "$(printf '%s\n' "${SWIFT_DIALOG_MINIMUM_VERSION}" "${version_result}" | sort -V | head -n 1)" == "${SWIFT_DIALOG_MINIMUM_VERSION}" ]]; then
