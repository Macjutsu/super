# This function checks for a downloaded and prepared softwareupdate macOS update/upgrade cache and sets ${msu_macos_downloaded_version}, ${msu_macos_downloaded_version_extra} and ${msu_macos_downloaded_build} accordingly.
check_msu_macos_download() {
	msu_macos_downloaded_version="FALSE"
	msu_macos_downloaded_version_extra="FALSE"
	msu_macos_downloaded_build="FALSE"
	local update_asset_attributes && update_asset_attributes=$(defaults read /System/Volumes/Update/Update update-asset-attributes 2>&1)
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: update_asset_attributes is:\n${update_asset_attributes}"
	if [[ -n "${update_asset_attributes}" ]] && [[ ! $(echo "${update_asset_attributes}" | grep -c 'does not exist') -gt 0 ]] && [[ ! $(echo "${update_asset_attributes}" | grep -c 'not found') -gt 0 ]]; then
		msu_macos_downloaded_version=$(echo "${update_asset_attributes}" | grep -w 'OSVersion' | awk -F '"' '{print $2;}')
		msu_macos_downloaded_version_extra=$(echo "${update_asset_attributes}" | grep -w 'ProductVersionExtra' | awk -F '"' '{print $2;}')
		[[ -n "${msu_macos_downloaded_version_extra}" ]] && msu_macos_downloaded_version="${msu_macos_downloaded_version} ${msu_macos_downloaded_version_extra}"
		msu_macos_downloaded_build=$(echo "${update_asset_attributes}" | grep -w 'Build' | awk '{print substr($3, 1, length($3)-1)}')
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_macos_downloaded_version is: ${msu_macos_downloaded_version}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_macos_downloaded_version_extra is: ${msu_macos_downloaded_version_extra}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_macos_downloaded_build is: ${msu_macos_downloaded_build}"
}

# Returns the macOS marketing name, version, and build that will be installed given a macOS installer application path ${1}.
get_installer_macos_info() {
	[[ -d "/Volumes/Shared Support" ]] && diskutil unmount force "/Volumes/Shared Support" > /dev/null 2>&1
	if [[ -f "${1}/Contents/SharedSupport/SharedSupport.dmg" ]]; then
		local hidiutil_result && hidiutil_result=$(hdiutil attach -quiet -noverify -nobrowse "${1}/Contents/SharedSupport/SharedSupport.dmg" 2>&1)
		sleep 1
		if [[ -d "/Volumes/Shared Support" ]]; then
			if [[ -f "/Volumes/Shared Support/com_apple_MobileAsset_MacSoftwareUpdate/com_apple_MobileAsset_MacSoftwareUpdate.xml" ]]; then
				local installer_macos_version_downloaded && installer_macos_version_downloaded=$(/usr/libexec/PlistBuddy -c "Print :Assets:0:OSVersion" "/Volumes/Shared Support/com_apple_MobileAsset_MacSoftwareUpdate/com_apple_MobileAsset_MacSoftwareUpdate.xml")
				local installer_macos_build_downloaded && installer_macos_build_downloaded=$(/usr/libexec/PlistBuddy -c "Print :Assets:0:Build" "/Volumes/Shared Support/com_apple_MobileAsset_MacSoftwareUpdate/com_apple_MobileAsset_MacSoftwareUpdate.xml")
				diskutil unmount force "/Volumes/Shared Support" > /dev/null 2>&1
				if [[ -n "${installer_macos_version_downloaded}" ]] && [[ -n "${installer_macos_build_downloaded}" ]]; then
					[[ -d "/Volumes/Shared Support" ]] && diskutil unmount force "/Volumes/Shared Support" > /dev/null 2>&1
					echo "$(basename "${1}" | sed -e 's/Install //g' -e 's/\..*//g') ${installer_macos_version_downloaded}-${installer_macos_build_downloaded}" && return 0
				else
					log_super "Error: Unable to resolve information for macOS installer located at: ${1}"
					[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: installer_macos_version_downloaded is: ${installer_macos_version_downloaded}"
					[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: installer_macos_build_downloaded is: ${installer_macos_build_downloaded}"
				fi
			else
				log_super "Error: Unable to locate macOS installer com_apple_MobileAsset_MacSoftwareUpdate.xml file for validation."
			fi
		else
			log_super "Error: Unable to mount macOS installer SharedSupport.dmg for validation."
			[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: hidiutil_result is:\n${hidiutil_result}"
		fi
	else
		log_super "Error: Unable to locate macOS installer at: ${1}"
	fi
	return 1
}

# This function checks the macOS installer to be used for upgrades matches the ${installer_macos_build} and passes Gatekeeper validation.
check_installer_macos_download() {
	check_installer_macos_error="FALSE"
	log_super "Status: Gatekeeper and version validation of /Applications/Install ${installer_macos_title}.app..."
	
	# First check to see if the downloaded macOS installer build version matches the ${installer_macos_build}.
	if [[ "$(get_installer_macos_info "/Applications/Install ${installer_macos_title}.app")" != "${installer_macos_title} ${installer_macos_version}-${installer_macos_build}" ]]; then
			log_super "Warning: Downloaded macOS installer does not match the target macOS installer."
			check_installer_macos_error="TRUE"
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: check_installer_macos_error is: ${check_installer_macos_error}"
	
	# If there are no errors, then move on to gatekeeper validation.
	if [[ "${check_installer_macos_error}" == "FALSE" ]]; then
		local startosinstall_result && startosinstall_result=$("/Applications/Install ${installer_macos_title}.app/Contents/Resources/startosinstall" --usage 2>&1)
		if [[ $(echo "${startosinstall_result}" | grep -c 'Usage: startosinstall') -eq 0 ]]; then
			log_super "Warning: Downloaded macOS installer failed Gatekeeper validation."
			check_installer_macos_error="TRUE"
			[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: startosinstall_result is:\n${startosinstall_result}"
		fi
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: check_installer_macos_error is: ${check_installer_macos_error}"
}

# Delete any unneeded or incorrect version macOS installers.
delete_unneeded_macos_installers() {
	local previous_ifs="${IFS}" && IFS=$'\n'
	local installer_macos_local_paths_array && installer_macos_local_paths_array=($(mdfind kind:app -name "Install macOS" 2> /dev/null))
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: installer_macos_local_paths_array is:\n${installer_macos_local_paths_array[*]}"
	if [[ -n "${installer_macos_local_paths_array[*]}" ]]; then
		for installer_macos_path in "${installer_macos_local_paths_array[@]}"; do
			if [[ $(echo "${installer_macos_path}" | grep -c '/Volumes/') -gt 0 ]] || { [[ $(echo "${installer_macos_path}" | grep -c '/Users/') -gt 0 ]] && [[ $(echo "${installer_macos_path}" | grep -c '/Users/.*/Applications/') -eq 0 ]] && [[ $(echo "${installer_macos_path}" | grep -c '/Users/.*/Desktop/') -eq 0 ]] && [[ $(echo "${installer_macos_path}" | grep -c '/Users/.*/Downloads/') -eq 0 ]]; }; then
				log_super "Status: Skipping deletion of assumed archived macOS installer at: ${installer_macos_path}"
			else
				if [[ "${installer_macos_major_upgrade_target}" == "FALSE" ]] && [[ "${installer_macos_minor_update_target}" == "FALSE" ]]; then
					if [[ "${test_mode}" == "TRUE" ]]; then # Test mode.
						log_super "Test Mode: macOS upgrades are not allowed, found unnecessary macOS installer at: ${installer_macos_path}"
					else # Normal workflow.
						log_super "Warning: macOS upgrades are not allowed, removing unnecessary macOS installer at: ${installer_macos_path}"
						rm -Rf "${installer_macos_path}" > /dev/null 2>&1
					fi
				elif [[ "${installer_macos_path}" != "/Applications/Install ${installer_macos_title}.app" ]] || [[ "$(get_installer_macos_info "${installer_macos_path}")" != "${installer_macos_title} ${installer_macos_version}-${installer_macos_build}" ]]; then
					if [[ "${test_mode}" == "TRUE" ]]; then # Test mode.
						log_super "Test Mode: Found incorrect version target macOS installer at: ${installer_macos_path}"
					else # Normal workflow.
						log_super "Warning: Removing incorrect version target macOS installer at: ${installer_macos_path}"
						rm -Rf "${installer_macos_path}" > /dev/null 2>&1
					fi
				fi
			fi
		done
	fi
	IFS="${previous_ifs}"
}

# This function determines which macOS updates, upgrades, or installers have been downloaded and validates any previously downloaded macOS updates, upgrades, or installers and sets ${installer_macos_download_required}, ${msu_macos_download_required}, ${msu_macos_download_error}, and ${msu_macos_setting_automatic_download_deferral} accordingly.
workflow_check_download_status() {
	installer_macos_download_required="FALSE"
	msu_macos_download_required="FALSE"
	msu_macos_download_error="FALSE"
	msu_macos_setting_automatic_download_deferral="FALSE"
	msu_macos_setting_automatic_download_ramped="FALSE"
	
	# If a macOS installer is targeted then evaluate any local installers and set ${installer_macos_download_required}.
	if [[ "${installer_macos_major_upgrade_target}" != "FALSE" ]] || [[ "${installer_macos_minor_update_target}" != "FALSE" ]]; then
		local installer_macos_download && installer_macos_download=$(get_pref "MacOSInstallerDownloaded")
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: installer_macos_download is: ${installer_macos_download}"
		if [[ -d "/Applications/Install ${installer_macos_title}.app" ]]; then
			check_installer_macos_download
			if [[ "${check_installer_macos_error}" == "TRUE" ]]; then
				[[ -n "${installer_macos_download}" ]] && log_super "Warning: Previously downloaded macOS installer failed local validations, removing installer: /Applications/Install ${installer_macos_title}.app."
				[[ -z "${installer_macos_download}" ]] && log_super "Warning: Existing macOS installer failed local validations, removing installer: /Applications/Install ${installer_macos_title}.app."
				installer_macos_download_required="TRUE"
				delete_pref_main "MacOSInstallerDownloaded"
				rm -Rf "/Applications/Install ${installer_macos_title}.app" > /dev/null 2>&1
			fi
			set_pref_main "MacOSInstallerDownloaded" "${installer_macos_title} ${installer_macos_version}-${installer_macos_build}"
		else # No local macOS installer.
			[[ -n "${installer_macos_download}" ]] && log_super "Warning: Previously downloaded macOS installer could not be found."
			installer_macos_download_required="TRUE"
			delete_pref_main "MacOSInstallerDownloaded"
		fi
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: installer_macos_download_required is: ${installer_macos_download_required}"
	
	# If a softwareupdate is targeted then evaluate if there is a cached macOS update/upgrade.
	if [[ "${msu_macos_major_upgrade_target}" != "FALSE" ]] || [[ "${msu_macos_minor_update_target}" != "FALSE" ]]; then
		
		check_msu_macos_download
		msu_macos_label_downloaded=$(get_pref "MacOSMSULabelDownloaded")
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_macos_label_downloaded is: ${msu_macos_label_downloaded}"
		[[ $(get_pref "WorkflowDownloadMacOSAuthRequired") == "TRUE" ]] && workflow_download_macos_auth_required="TRUE"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: workflow_download_macos_auth_required is: ${workflow_download_macos_auth_required}"
		
		# If an MSU macOS version is cached then determine if it's valid.
		if [[ "${msu_macos_downloaded_version}" != "FALSE" ]]; then
			if [[ "${msu_macos_downloaded_version}" == "${msu_macos_version}" ]] && [[ -z "${msu_macos_label_downloaded}" ]]; then
				log_metrics "MSU Download Complete: Workflow Elapsed Time" "WorkflowTargetTimestamp"
				msu_macos_label_downloaded="${msu_macos_label}" && set_pref_main "MacOSMSULabelDownloaded" "${msu_macos_label}"
			fi
			if [[ "${msu_macos_downloaded_version}" != "${msu_macos_version}" ]]; then
				log_super "Warning: Previously downloaded macOS update/upgrade version ${msu_macos_downloaded_version} doesn't match workflow target version ${msu_macos_version}."
				msu_macos_download_required="TRUE"
				msu_macos_download_error="TRUE"
				unset msu_macos_label_downloaded
				delete_pref_main "MacOSMSULabelDownloaded"
			fi
		else # No msu download is prepared.
			[[ -n "${msu_macos_label_downloaded}" ]] && log_super "Warning: Previously downloaded macOS update/upgrade is no longer valid."
			msu_macos_download_required="TRUE"
			unset msu_macos_label_downloaded
			delete_pref_main "MacOSMSULabelDownloaded"
		fi
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_macos_download_required is: ${msu_macos_download_required}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_macos_download_error is: ${msu_macos_download_error}"
		
		# If the target is a macOS minor update and it should have been downloaded automatically, then evaluate if the workflow should automatically defer.
		if [[ "${msu_macos_minor_update_target}" != "FALSE" ]]; then
			{ [[ "${msu_setting_automatic_download}" == "TRUE" ]] && [[ "${msu_macos_download_required}" == "TRUE" ]]; } && msu_macos_setting_automatic_download_deferral="TRUE"
			[[ "${msu_macos_setting_automatic_download_deferral}" == "TRUE" ]] && msu_macos_setting_automatic_download_ramped="$(grep "${msu_macos_build}" "/var/log/install.log" | grep "ramped, not downloadable at this time" | tail -1)"
			[[ "${msu_setting_automatic_download}" == "FALSE" ]] && log_super "Warning: Automatic download of macOS updates is disabled, this is not recommended for macOS minor update workflows."
		fi
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_macos_setting_automatic_download_deferral is: ${msu_macos_setting_automatic_download_deferral}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_macos_setting_automatic_download_ramped is: ${msu_macos_setting_automatic_download_ramped}"
	fi
}

# Download macOS update or upgrade via softwareupdate command, and also save responses to ${SUPER_LOG}, ${MSU_WORKFLOW_LOG}, and ${SUPER_MAIN_PLIST}.
download_macos_msu() {
	# If ${test_mode} then it's not necessary to continue this function.
	if [[ "${test_mode}" == "TRUE" ]]; then
		log_super "Test Mode: Skipping the download macOS update/upgrade via MSU workflow."
		if [[ "${workflow_install_now_active}" == "TRUE" ]]; then
			log_super "Test Mode: Pausing ${test_mode_timeout_seconds} seconds for install now download notification..."
			sleep "${test_mode_timeout_seconds}"
		fi
		download_maocs_msu_error="FALSE"
		return 0
	fi
	
	# Start with log and status updates.
	if [[ "${workflow_download_macos_auth_required}" == "TRUE" ]]; then
		log_super "softwareupdate: Starting ${msu_macos_title} authenticated download workflow, check ${MSU_WORKFLOW_LOG} for more detail."
		log_status "Running: softwareupdate: Starting ${msu_macos_title} authenticated download workflow."
		log_msu "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - DOWNLOAD ${msu_macos_title} VIA AUTHENTICATED SOFTWAREUPDATE START ****"
	else
		log_super "softwareupdate: Starting ${msu_macos_title} download workflow, check ${MSU_WORKFLOW_LOG} for more detail."
		log_status "Running: softwareupdate: Starting ${msu_macos_title} download workflow."
		log_msu "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - DOWNLOAD ${msu_macos_title} VIA SOFTWAREUPDATE START ****"
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_macos_label is: ${msu_macos_label}"
	
	# The softwareupdate download process is backgrounded and is watched via a while loop later on.
	if [[ "${workflow_download_macos_auth_required}" == "TRUE" ]]; then # On systems that require authenticated downloads.
		echo "${auth_local_password}" | launchctl asuser "${current_user_id}" sudo -u root softwareupdate --download "${msu_macos_label}" --agree-to-license --user "${auth_local_account}" --stdinpass >> "${MSU_WORKFLOW_LOG}" 2>&1 &
		local download_msu_macos_pid="$!"
	else
		echo ' ' | launchctl asuser "${current_user_id}" sudo -u "${current_user_account_name}" softwareupdate --download "${msu_macos_label}" --agree-to-license --user "${current_user_account_name}" --stdinpass >> "${MSU_WORKFLOW_LOG}" 2>&1 &
		local download_msu_macos_pid="$!"
	fi
	
	# Watch ${MSU_WORKFLOW_LOG} while waiting for the softwareupdate download workflow to complete.
	# Note this while read loop has a timeout based on ${TIMEOUT_START_SECONDS} then changes to ${TIMEOUT_MSU_SYSTEM_SECONDS}.
	local download_msu_macos_start_error="TRUE"
	local download_msu_macos_start_timeout="TRUE"
	local download_msu_macos_timeout_error="TRUE"
	local download_msu_macos_timeout_seconds="${TIMEOUT_START_SECONDS}"
	local download_msu_macos_phase="START"
	local download_msu_macos_complete_perecent=0
	local download_msu_macos_complete_perecent_previous=0
	local download_msu_macos_complete_display
	unset msu_macos_title_downloaded
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_msu_macos_timeout_seconds is: ${download_msu_macos_timeout_seconds}"
	while read -t "${download_msu_macos_timeout_seconds}" -r log_line; do
		# log_super "Debug Mode: Function ${FUNCNAME[0]}: log_line is:\n${log_line}"
		if [[ $(echo "${log_line}" | grep -c "Can’t connect") -gt 0 ]] || [[ $(echo "${log_line}" | grep -c "Couldn't communicate") -gt 0 ]]; then
			download_msu_macos_start_error="CONNECT"
			break
		elif [[ $(echo "${log_line}" | grep -c 'No such update') -gt 0 ]]; then
			download_msu_macos_start_error="NOUPDATE"
			break
		elif [[ $(echo "${log_line}" | grep -c 'Not enough free disk space') -gt 0 ]]; then
			download_msu_macos_start_error="SPACE"
			break
		elif [[ $(echo "${log_line}" | grep -c 'Failed to authenticate') -gt 0 ]]; then
			download_msu_macos_start_error="AUTH"
			break
		elif [[ $(echo "${log_line}" | grep -c 'Failed to download') -gt 0 ]]; then
			download_msu_macos_start_error="FAILED"
			break
		elif [[ $(echo "${log_line}" | grep -c 'Downloading') -gt 0 ]] && [[ "${download_msu_macos_phase}" == "START" ]]; then
			msu_macos_title_downloaded="${log_line/Downloading /}"
			log_super "softwareupdate: ${msu_macos_title_downloaded} is downloading..."
			log_msu "**** TIMESTAMP ****"
			download_msu_macos_phase="DOWNLOADING"
			download_msu_macos_timeout_seconds="${TIMEOUT_MSU_SYSTEM_SECONDS}"
			[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_msu_macos_timeout_seconds is: ${download_msu_macos_timeout_seconds}"
			download_msu_macos_start_error="FALSE"
			download_msu_macos_start_timeout="FALSE"
			[[ $(echo "${msu_macos_title_downloaded}" | grep -c 'macOS') -gt 0 ]] && download_msu_macos_phase="DOWNLOADING"
		elif [[ $(echo "${log_line}" | grep -c 'Downloading') -gt 0 ]] && [[ "${download_msu_macos_phase}" == "DOWNLOADING" ]]; then
			download_msu_macos_complete_perecent=$(echo "${log_line}" | sed -e 's/Downloading: //' -e 's/\.[0-9][0-9]//' | tr -d '\n' | tr -d '\r')
			[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_msu_macos_complete_perecent is: ${download_msu_macos_complete_perecent}"
			if [[ $download_msu_macos_complete_perecent -ge 60 ]]; then
				log_echo_replace_line "${msu_macos_title_downloaded} download progress: 100%\n"
				log_super "softwareupdate: ${msu_macos_title_downloaded} download complete, now preparing..."
				log_msu "**** TIMESTAMP ****"
				download_msu_macos_phase="PREPARING"
			elif [[ $download_msu_macos_complete_perecent -gt $download_msu_macos_complete_perecent_previous ]]; then
				download_msu_macos_complete_display=$( (echo "${download_msu_macos_complete_perecent} * 1.69" | bc) | cut -d '.' -f1)
				log_echo_replace_line "${msu_macos_title_downloaded} download progress: ${download_msu_macos_complete_display}%"
				download_msu_macos_complete_perecent_previous=${download_msu_macos_complete_perecent}
			fi
		elif [[ $(echo "${log_line}" | grep -c 'Downloading') -gt 0 ]] && [[ "${download_msu_macos_phase}" == "PREPARING" ]]; then
			download_msu_macos_complete_perecent=$(echo "${log_line}" | sed -e 's/Downloading: //' -e 's/\.[0-9][0-9]//' | tr -d '\n' | tr -d '\r')
			[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_msu_macos_complete_perecent is: ${download_msu_macos_complete_perecent}"
			if [[ ${download_msu_macos_complete_perecent} -ge 100 ]]; then
				log_echo_replace_line "${msu_macos_title_downloaded} preparing progress: 100%\n"
				log_msu "**** TIMESTAMP ****"
				download_msu_macos_phase="DONE"
				sleep 10
			elif [[ $download_msu_macos_complete_perecent -gt $download_msu_macos_complete_perecent_previous ]]; then
				download_msu_macos_complete_display=$(((download_msu_macos_complete_perecent - 60) * 2))
				log_echo_replace_line "${msu_macos_title_downloaded} preparing progress: ${download_msu_macos_complete_display}%"
				download_msu_macos_complete_perecent_previous=${download_msu_macos_complete_perecent}
			fi
		elif [[ $(echo "${log_line}" | grep -c 'Downloaded') -gt 0 ]] || [[ "${download_msu_macos_phase}" == "DONE" ]]; then
			msu_macos_title_downloaded=$(echo "${log_line}" | sed -e 's/://' -e 's/Downloaded //')
			log_super_audit "softwareupdate: ${msu_macos_title_downloaded} download and preparation complete."
			download_msu_macos_start_error="FALSE"
			download_msu_macos_start_timeout="FALSE"
			download_msu_macos_timeout_error="FALSE"
			break
		fi
	done < <(tail -n1 -F "${MSU_WORKFLOW_LOG}" | tr -u '%' '\n')
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_msu_macos_start_timeout is: ${download_msu_macos_start_timeout}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_msu_macos_start_error is: ${download_msu_macos_start_error}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_msu_macos_timeout_error is: ${download_msu_macos_timeout_error}"
	
	# If the softwareupdate download workflow completed, then validate the prepared macOS update/upgrade.
	if [[ "${download_msu_macos_start_error}" == "FALSE" ]] && [[ "${download_msu_macos_start_timeout}" == "FALSE" ]] && [[ "${download_msu_macos_timeout_error}" == "FALSE" ]]; then	
		local download_msu_macos_title_error="TRUE"
		local download_msu_macos_validation_error="TRUE"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_macos_title is: ${msu_macos_title}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_macos_title_downloaded is: ${msu_macos_title_downloaded}"
		if [[ "${msu_macos_title}" == "${msu_macos_title_downloaded}" ]]; then
			download_msu_macos_title_error="FALSE"
			check_msu_macos_download
			[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_macos_version is: ${msu_macos_version}"
			[[ "${msu_macos_downloaded_version}" == "${msu_macos_version}" ]] && download_msu_macos_validation_error="FALSE"
		fi
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_msu_macos_title_error is: ${download_msu_macos_title_error}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_msu_macos_validation_error is: ${download_msu_macos_validation_error}"
	
	# If the macOS update/upgrade is downloaded and prepared, then collect information.
	if [[ "${download_msu_macos_start_error}" == "FALSE" ]] || [[ "${download_msu_macos_start_timeout}" == "FALSE" ]] || [[ "${download_msu_macos_timeout_error}" == "FALSE" ]] || [[ "${download_msu_macos_title_error}" == "FALSE" ]] || [[ "${download_msu_macos_validation_error}" == "FALSE" ]]; then
		log_msu "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - DOWNLOAD MACOS VIA SOFTWAREUPDATE COMPLETED ****"
		log_metrics "MSU Download Complete: Workflow Elapsed Time" "WorkflowTargetTimestamp"
		download_maocs_msu_error="FALSE"
		msu_macos_download_required="FALSE"
		set_pref_main "MacOSMSULabelDownloaded" "${msu_macos_label}"
	else # Some part of the softwareupdate download workflow failed.
		if [[ "${download_msu_macos_start_error}" == "CONNECT" ]]; then
			log_msu "Error: Unable to reach macOS software update servers."
			log_super "Error: Unable to reach macOS software update servers."
		elif [[ "${download_msu_macos_start_error}" == "NOUPDATE" ]]; then
			log_msu "Error: Unable to find requested macOS update/upgrade via softwareupdate."
			log_super "Error: Unable to find requested macOS update/upgrade via softwareupdate."
		elif [[ "${download_msu_macos_start_error}" == "SPACE" ]]; then
			log_msu "Error: Not enough available storage to download macOS update/upgrade."
			log_super "Error: Not enough available storage to download macOS update/upgrade."
		elif [[ "${download_msu_macos_start_error}" == "AUTH" ]]; then
			log_msu "Error: Download of macOS update/upgrade via softwareupdate failed to authenticate."
			log_super "Error: Download of macOS update/upgrade via softwareupdate failed to authenticate."
			workflow_download_macos_auth_required="TRUE"
			set_pref_main "WorkflowDownloadMacOSAuthRequired" "TRUE"
		elif [[ "${download_msu_macos_start_error}" == "FAILED" ]]; then
			log_msu "Error: Download of macOS update/upgrade via softwareupdate failed to start."
			log_super "Error: Download of macOS update/upgrade via softwareupdate failed to start."
		elif [[ "${download_msu_macos_start_timeout}" == "TRUE" ]]; then
			log_msu "Error: Download of macOS update/upgrade via softwareupdate failed to start after waiting for ${download_msu_macos_timeout_seconds} seconds."
			log_super "Error: Download of macOS update/upgrade via softwareupdate failed to start after waiting for ${download_msu_macos_timeout_seconds} seconds."
		elif [[ "${download_msu_macos_timeout_error}" == "TRUE" ]]; then
			log_msu "Error: Download of macOS update/upgrade via softwareupdate failed to complete, as indicated by no progress after waiting for ${download_msu_macos_timeout_seconds} seconds."
			log_super "Error: Download of macOS update/upgrade via softwareupdate failed to complete, as indicated by no progress after waiting for ${download_msu_macos_timeout_seconds} seconds."
		elif [[ "${download_msu_macos_title_error}" == "TRUE" ]]; then
			log_msu "Error: Download of ${msu_macos_title} did not complete or match requested download title."
			log_super "Error: Download of ${msu_macos_title} ddid not complete or match requested download title."
		else # "${download_msu_macos_validation_error}" == "TRUE"
			if [[ "${msu_macos_major_upgrade_target}" != "FALSE" ]]; then
				log_msu "Error: Downloaded macOS major upgrade version of ${msu_macos_downloaded_version} doesn't match expected version ${msu_macos_version}."
				log_super "Error: Downloaded macOS major upgrade version of ${msu_macos_downloaded_version} doesn't match expected version ${msu_macos_version}."
			else # "${msu_macos_minor_update_target}" != "FALSE"
				log_msu "Error: Downloaded macOS minor update version of ${msu_macos_downloaded_version} doesn't match expected version ${msu_macos_version}."
				log_super "Error: Downloaded macOS mintor update version of ${msu_macos_downloaded_version} doesn't match expected version ${msu_macos_version}."
			fi
		fi
		log_msu "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - DOWNLOAD MACOS VIA SOFTWAREUPDATE FAILED ****"
		download_maocs_msu_error="TRUE"
		msu_macos_download_required="TRUE"
		delete_pref_main "MacOSMSULabelDownloaded"
		kill -9 "${download_msu_macos_pid}" > /dev/null 2>&1
		kick_softwareupdated
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_maocs_msu_error is: ${download_maocs_msu_error}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: msu_macos_download_required is: ${msu_macos_download_required}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: workflow_download_macos_auth_required is: ${workflow_download_macos_auth_required}"
}

# Download macOS installer via ${MIST_CLI_BINARY}, and also save responses to ${SUPER_LOG}, ${INSTALLER_WORKFLOW_LOG}, and ${SUPER_MAIN_PLIST}.
download_macos_installer() {
	# If ${test_mode} then it's not necessary to continue this function.
	if [[ "${test_mode}" == "TRUE" ]]; then
		log_super "Test Mode: Skipping the download macOS update/upgrade via installer workflow."
		if [[ "${workflow_install_now_active}" == "TRUE" ]]; then
			log_super "Test Mode: Pausing ${test_mode_timeout_seconds} seconds for install now download notification..."
			sleep "${test_mode_timeout_seconds}"
		fi
		download_installer_macos_error="FALSE"
		return 0
	fi
	
	# Start with log and status updates.
	log_super "mist_cli: Starting ${installer_macos_title} ${installer_macos_version}-${installer_macos_build} download installer workflow, check ${INSTALLER_WORKFLOW_LOG} for more detail."
	log_status "Running: mist_cli: Starting ${installer_macos_title} ${installer_macos_version}-${installer_macos_build} download installer workflow."
	log_installer "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - DOWNLOAD ${installer_macos_title} ${installer_macos_version}-${installer_macos_build} INSTALLER APP START ****"
	
	# Background the ${MIST_CLI_BINARY} download process and send to ${INSTALLER_WORKFLOW_LOG}.
	if [[ "${system_macos_beta_enrollment}" == "FALSE" ]]; then
		"${MIST_CLI_BINARY}" download installer --force --no-ansi --output-directory "/Applications" --compatible "${installer_macos_build}" application --application-name "Install %NAME%.app" >> "${INSTALLER_WORKFLOW_LOG}" 2>&1 &
		local download_installer_macos_mist_pid="$!"
	else # macOS beta workflow.
		"${MIST_CLI_BINARY}" download installer --force --no-ansi --output-directory "/Applications" --compatible --include-betas "${installer_macos_build}" application --application-name "Install %NAME%.app" >> "${INSTALLER_WORKFLOW_LOG}" 2>&1 &
		local download_installer_macos_mist_pid="$!"
	fi
	
	# Watch ${INSTALLER_WORKFLOW_LOG} while waiting for the mist-cli download process to complete.
	# Note this while read loop has a timeout based on ${TIMEOUT_START_SECONDS} then changes to ${TIMEOUT_INSTALLER_DOWNLOAD_SECONDS}.
	local download_installer_macos_start_error="TRUE"
	local download_installer_macos_start_timeout="TRUE"
	local download_installer_macos_timeout_error="TRUE"
	local download_installer_macos_timeout_seconds="${TIMEOUT_START_SECONDS}"
	local download_installer_macos_phase="START"
	local download_installer_macos_complete_percent=0
	local download_installer_macos_complete_percent_previous=0
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_installer_macos_timeout_seconds is: ${download_installer_macos_timeout_seconds}"
	while read -t "${download_installer_macos_timeout_seconds}" -r log_line; do
		# log_super "Debug Mode: Function ${FUNCNAME[0]}: log_line is:\n${log_line}"
		if [[ $(echo "${log_line}" | grep -c 'No macOS Installer found') -gt 0 ]]; then
			break
		elif [[ $(echo "${log_line}" | grep -c 'DOWNLOAD') -gt 0 ]] && [[ "${download_installer_macos_phase}" != "DOWNLOADING" ]]; then
			log_super "mist_cli: Install ${installer_macos_title}.app is downloading..."
			log_installer "**** TIMESTAMP ****"
			download_installer_macos_timeout_seconds="${TIMEOUT_INSTALLER_DOWNLOAD_SECONDS}"
			[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_installer_macos_timeout_seconds is: ${download_installer_macos_timeout_seconds}"
			download_installer_macos_phase="DOWNLOADING"
			download_installer_macos_start_error="FALSE"
			download_installer_macos_start_timeout="FALSE"
		elif [[ "${download_installer_macos_phase}" == "DOWNLOADING" ]] && [[ $(echo "${log_line}" | grep -c 'InstallAssistant.pkg') -gt 0 ]]; then
			download_installer_macos_complete_percent=$(echo "${log_line}" | awk -F '(' '{print $2;}' | awk -F '.' '{print $1;}' | tr -d -c 0-9)
			download_installer_macos_complete_percent=${download_installer_macos_complete_percent#0}
			[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_installer_macos_complete_percent is: ${download_installer_macos_complete_percent}"
			if [[ $download_installer_macos_complete_percent -ge 100 ]]; then
				log_echo_replace_line "Install ${installer_macos_title}.app download progress: 100%\n"
				log_super "mist_cli: Install ${installer_macos_title}.app downloaded, now verifying..."
				log_installer "**** TIMESTAMP ****"
				download_installer_macos_phase="DONE"
			elif [[ $download_installer_macos_complete_percent -gt $download_installer_macos_complete_percent_previous ]]; then
				log_echo_replace_line "Install ${installer_macos_title}.app download progress: ${download_installer_macos_complete_percent}%"
				download_installer_macos_complete_percent_previous=$download_installer_macos_complete_percent
			fi
		elif [[ $(echo "${log_line}" | grep -c 'INSTALL') -gt 0 ]]; then
			log_super "mist_cli: Install ${installer_macos_title}.app verified, now preparing..."
			log_installer "**** TIMESTAMP ****"
		elif [[ $(echo "${log_line}" | grep -c 'APPLICATION') -gt 0 ]]; then
			log_super "mist_cli: Install ${installer_macos_title}.app prepared, now moving to /Applications..."
			log_installer "**** TIMESTAMP ****"
			download_installer_macos_phase="APPLICATION"
		elif [[ $(echo "${log_line}" | grep -c 'TEARDOWN') -gt 0 ]]; then
			log_installer "**** TIMESTAMP ****"
			download_installer_macos_start_error="FALSE"
			download_installer_macos_start_timeout="FALSE"
			download_installer_macos_timeout_error="FALSE"
			break
		fi
	done < <(tail -n1 -F "${INSTALLER_WORKFLOW_LOG}")
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_installer_macos_start_error is: ${download_installer_macos_start_error}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_installer_macos_start_timeout is: ${download_installer_macos_start_timeout}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_installer_macos_timeout_error is: ${download_installer_macos_timeout_error}"
	
	# If the mist-cli download workflow completed, then validate the macOS installer application.
	if [[ "${download_installer_macos_start_error}" == "FALSE" ]] && [[ "${download_installer_macos_start_timeout}" == "FALSE" ]] && [[ "${download_installer_macos_timeout_error}" == "FALSE" ]]; then
		local download_installer_macos_app_error="TRUE"
		local download_installer_macos_validation_error="TRUE"
		if [[ -d "/Applications/Install ${installer_macos_title}.app" ]]; then
			download_installer_macos_app_error="FALSE"
			check_installer_macos_download
			[[ "${check_installer_macos_error}" == "FALSE" ]] && download_installer_macos_validation_error="FALSE"
		fi
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_installer_macos_app_error is: ${download_installer_macos_app_error}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_installer_macos_validation_error is: ${download_installer_macos_validation_error}"
	
	# If the macOS installer application is downloaded and valid, then collect information.
	if [[ "${download_installer_macos_start_error}" == "FALSE" ]] || [[ "${download_installer_macos_start_timeout}" == "FALSE" ]] || [[ "${download_installer_macos_timeout_error}" == "FALSE" ]] || [[ "${download_installer_macos_app_error}" == "FALSE" ]] || [[ "${download_installer_macos_validation_error}" == "FALSE" ]]; then
		log_installer "Status: A macOS installer is now available at: /Applications/Install ${installer_macos_title}.app"
		log_installer "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - DOWNLOAD MACOS INSTALLER APP COMPLETE ****"
		log_super_audit "Status: A macOS installer is now available at: /Applications/Install ${installer_macos_title}.app"
		log_metrics "Installer Download Complete: Workflow Elapsed Time" "WorkflowTargetTimestamp"
		download_installer_macos_error="FALSE"
		installer_macos_download_required="FALSE"
		set_pref_main "MacOSInstallerDownloaded" "${installer_macos_title} ${installer_macos_version}-${installer_macos_build}"
	else # Some part of the macOS installer download workflow failed.
		if [[ "${download_installer_macos_start_error}" == "TRUE" ]]; then
			log_installer "Error: macOS installer download failed start or the requested installer could not be found."
			log_super "Error: macOS installer download failed start or the requested installer could not be found."
		elif [[ "${download_installer_macos_start_timeout}" == "TRUE" ]]; then
			log_installer "Error: macOS installer download failed to start after waiting for ${download_installer_macos_timeout_seconds} seconds."
			log_super "Error: macOS installer download failed to start after waiting for ${download_installer_macos_timeout_seconds} seconds."
		elif [[ "${download_installer_macos_timeout_error}" == "TRUE" ]]; then
			log_installer "Error: macOS installer download failed to complete, as indicated by no progress after waiting for ${download_installer_macos_timeout_seconds} seconds."
			log_super "Error: macOS installer download failed to complete, as indicated by no progress after waiting for ${download_installer_macos_timeout_seconds} seconds."
		elif [[ "${download_installer_macos_app_error}" == "TRUE" ]]; then
			log_installer "Error: The target macOS installer could not be found in the /Applications folder."
			log_super "Error: The target macOS installer could not be found in the /Applications folder."
		else # "${download_installer_macos_validation_error}" == "TRUE"
			log_installer "Error: macOS installer failed local validations, removing installer: /Applications/Install ${installer_macos_title}.app."
			log_super "Error: macOS installer failed local validations, removing installer: /Applications/Install ${installer_macos_title}.app."
			rm -Rf "/Applications/Install ${installer_macos_title}.app" > /dev/null 2>&1
		fi
		log_installer "**** S.U.P.E.R.M.A.N. ${SUPER_VERSION} - DOWNLOAD MACOS INSTALLER APP FAILED ****"
		kill -9 "${download_installer_macos_mist_pid}" > /dev/null 2>&1
		download_installer_macos_error="TRUE"
		delete_pref_main "MacOSInstallerDownloaded"
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: download_installer_macos_error is: ${download_installer_macos_error}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: installer_macos_download_required is: ${installer_macos_download_required}"
}

# This function contains logic to determine the correct download behavior based on system condition and specified options.
# This function only runs if there is an active user.
workflow_download_macos() {
	workflow_download_macos_error="FALSE"
	workflow_download_macos_check_user="FALSE"
	download_installer_macos_error="FALSE"
	download_maocs_msu_error="FALSE"
	
	# If downloads are required then check for possible automatic download deferral and available storage.
	if [[ "${installer_macos_download_required}" == "TRUE" ]] || [[ "${msu_macos_download_required}" == "TRUE" ]]; then
		# If a macOS automatic download should be possible then automatically defer.
		if [[ "${msu_macos_setting_automatic_download_deferral}" == "TRUE" ]]; then
			# First check for a variety of reasons why the automatic download deferral should be ignored.
			local ignore_msu_macos_setting_automatic_download_deferral="FALSE"
			[[ "${msu_macos_download_error}" == "TRUE" ]] && ignore_msu_macos_setting_automatic_download_deferral="TRUE" && log_super "Warning: Ignoring automatic macOS minor update download deferral due an error with the previously downloaded macOS update."
			[[ "${workflow_install_now_active}" == "TRUE" ]] && ignore_msu_macos_setting_automatic_download_deferral="TRUE" && log_super "Warning: Ignoring automatic macOS minor update download deferral due to current install now workflow."
			{ [[ -n "${deadline_epoch}" ]] && [[ $((deadline_epoch - workflow_time_epoch)) -le 86400 ]]; } && ignore_msu_macos_setting_automatic_download_deferral="TRUE" && log_super "Warning: Ignoring automatic macOS minor update download deferral because a deadline is within 24 hours."
			{ [[ "${deadline_date_status}" != "FALSE" ]] || [[ "${deadline_days_status}" != "FALSE" ]] || [[ "${deadline_count_status}" != "FALSE" ]]; } && ignore_msu_macos_setting_automatic_download_deferral="TRUE" && log_super "Warning: Ignoring automatic macOS minor update download deferral due to current deadline workflow."
			# Only defer the automatic download if the workflow can wait.
			if [[ "${ignore_msu_macos_setting_automatic_download_deferral}" == "FALSE" ]]; then
				if [[ "${msu_macos_setting_automatic_download_ramped}" != "FALSE" ]]; then
					log_super "Warning: The target macOS minor update has not yet automatically downloaded to the system because it's being delayed by Apple's incremental rollout mechanism, trying again in ${deferral_timer_minutes} minutes."
					log_status "Pending: The target macOS minor update has not yet automatically downloaded to the system because it's being delayed by Apple's incremental rollout mechanism, trying again in ${deferral_timer_minutes} minutes."
				else
					log_super "Warning: The target macOS minor update has not yet automatically downloaded to the system, trying again in ${deferral_timer_minutes} minutes."
					log_status "Pending: The target macOS minor update has not yet automatically downloaded to the system, trying again in ${deferral_timer_minutes} minutes."
				fi
				set_auto_launch_deferral
			fi
		fi
		
		# Check for available storage.
		check_storage_available
		if [[ "${check_storage_available_error}" == "FALSE" ]]; then
			if [[ "${storage_ready}" == "FALSE" ]]; then
				if [[ "${current_user_account_name}" == "FALSE" ]]; then
					log_super "Error: Current available storage is at ${storage_available_gigabytes} GBs which is below the ${storage_required_gigabytes} GBs that is required for download. And no active user is logged in to attempt remediation."
					workflow_download_macos_error="TRUE"
				else # A normal user is currently logged in.
					dialog_insufficient_storage
					[[ "${dialog_insufficient_storage_error}" == "TRUE" ]] && workflow_download_macos_error="TRUE"
				fi
			fi
		else # "${check_storage_available_error}" == "TRUE"
			workflow_download_macos_error="TRUE"
		fi
	else # Downloads not required so log that download is not needed.
		{ [[ "${installer_macos_major_upgrade_target}" != "FALSE" ]] || [[ "${installer_macos_minor_update_target}" != "FALSE" ]]; } && log_super "Status: Previously downloaded ${installer_macos_title} ${installer_macos_version}-${installer_macos_build} installer is available at: /Applications/Install ${installer_macos_title}.app"
		[[ "${msu_macos_major_upgrade_target}" != "FALSE" ]] && log_super "Status: Previously downloaded macOS major upgrade is prepared: ${msu_macos_label_downloaded}"
		[[ "${msu_macos_minor_update_target}" != "FALSE" ]] && log_super "Status: Previously downloaded macOS minor update is prepared: ${msu_macos_label_downloaded}"
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: workflow_download_macos_error is: ${workflow_download_macos_error}"
	
	# If (no errors) and ${test_mode} then simulate dialogs and notifications for potential user authenticated download dialog.
	if [[ "${workflow_download_macos_error}" == "FALSE" ]] && [[ "${test_mode}" == "TRUE" ]] && [[ "${workflow_macos_auth}" == "USER" ]]; then
		if [[ "${current_user_password_policies}" == "TRUE" ]] || [[ "${system_password_policies}" == "TRUE" ]]; then
			workflow_download_macos_auth_required="TRUE"
			set_pref_main "WorkflowDownloadMacOSAuthRequired" "TRUE"
			log_super "Test Mode: Simluating authenticated download requirement because user password policies were found. Under normal curcumstances this dialog would only appear if an earlier download attempt failed because it required authentication."
		fi
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: workflow_download_macos_auth_required is: ${workflow_download_macos_auth_required}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: workflow_install_now_active is: ${workflow_install_now_active}"
	
	# If (no errors) and macOS installer download is needed.
	if [[ "${workflow_download_macos_error}" == "FALSE" ]] && [[ "${installer_macos_download_required}" == "TRUE" ]]; then
		[[ "${workflow_install_now_active}" == "TRUE" ]] && notification_install_now_download & disown
		download_macos_installer
		[[ "${download_installer_macos_error}" == "TRUE" ]] && workflow_download_macos_error="TRUE"
		[[ "${download_installer_macos_error}" == "FALSE" ]] && workflow_download_macos_check_user="TRUE"
	fi
	
	# If (no errors) and macOS update/upgrade via MSU download is needed, attempt an unauthenticated download.
	if [[ "${workflow_download_macos_error}" == "FALSE" ]] && [[ "${msu_macos_download_required}" == "TRUE" ]] && [[ "${workflow_download_macos_auth_required}" != "TRUE" ]]; then
		[[ "${workflow_install_now_active}" == "TRUE" ]] && notification_install_now_download & disown
		download_macos_msu
		if [[ "${download_maocs_msu_error}" == "TRUE" ]]; then
			if [[ "${workflow_download_macos_auth_required}" == "TRUE" ]]; then
				log_super "Warning: Initial attempt of unauthenticated download of macOS update/upgrade via MSU failed, failing over to authenticated download workflow."
			else
				workflow_download_macos_error="TRUE"
			fi
		else
			workflow_download_macos_check_user="TRUE"
		fi
	fi
	
	# If (no errors) and macOS update/upgrade via MSU authenticated download is needed.
	if [[ "${workflow_download_macos_error}" == "FALSE" ]] && [[ "${msu_macos_download_required}" == "TRUE" ]] && [[ "${workflow_download_macos_auth_required}" == "TRUE" ]]; then
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: workflow_macos_auth is: ${workflow_macos_auth}"
		[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: auth_credential_failover_to_user is: ${auth_credential_failover_to_user}"
		
		# If (no errors) then get authentication.
		if [[ "${workflow_download_macos_error}" == "FALSE" ]] && [[ "${workflow_macos_auth}" != "FALSE" ]]; then
			if [[ "${workflow_macos_auth}" == "LOCAL" ]]; then
				get_saved_authentication
				if [[ "${auth_error_saved}" == "TRUE" ]]; then
					if [[ "${auth_credential_failover_to_user}" == "TRUE" ]] || [[ "${auth_ask_user_to_save_password}" == "TRUE" ]]; then
						log_super "Warning: Saved authentication error, failing over to user authenticated download workflow."
						workflow_macos_auth="FAILOVER"
						if [[ "${dialog_user_auth_valid}" != "TRUE" ]]; then
							dialog_user_auth_type="DOWNLOAD"
							dialog_user_auth
							unset dialog_user_auth_type
							[[ "${dialog_user_auth_error}" == "TRUE" ]] && workflow_download_macos_error="TRUE"
						fi
					else
						log_super "Error: Unable to use saved authentication for download and the --auth-credential-failover-to-user option is not enabled."
						workflow_download_macos_error="TRUE"
					fi
				fi
			else # [[ "${workflow_macos_auth}" == "USER" ]] || [[ "${workflow_macos_auth}" == "FAILOVER" ]]
				if [[ "${dialog_user_auth_valid}" != "TRUE" ]]; then
					dialog_user_auth_type="DOWNLOAD"
					dialog_user_auth
					unset dialog_user_auth_type
					[[ "${dialog_user_auth_error}" == "TRUE" ]] && workflow_download_macos_error="TRUE"
				fi
			fi
		fi
			
		# If no errors, then start the appropriate authenticated download workflow.
		if [[ "${workflow_download_macos_error}" == "FALSE" ]]; then
			[[ "${workflow_install_now_active}" == "TRUE" ]] && notification_install_now_download & disown
			download_macos_msu
			[[ "${download_maocs_msu_error}" == "TRUE" ]] && workflow_download_macos_error="TRUE"
			[[ "${download_maocs_msu_error}" == "FALSE" ]] && workflow_download_macos_check_user="TRUE"
		fi
	fi
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: workflow_download_macos_error is: ${workflow_download_macos_error}"
	[[ "${verbose_mode}" == "TRUE" ]] && log_super "Verbose Mode: Function ${FUNCNAME[0]}: Line ${LINENO}: workflow_download_macos_check_user is: ${workflow_download_macos_check_user}"
	
	# Handle download workflow failures.
	if [[ "${workflow_download_macos_error}" == "TRUE" ]]; then
		if [[ "${workflow_install_now_active}" == "TRUE" ]]; then # Install now workflow mode.
			log_super "Error: Download macOS update/upgrade workflow failed, install now workflow can not continue."
			log_status "Inactive Error: Download macOS update/upgrade workflow failed, install now workflow can not continue."
			notification_install_now_failed & disown
			exit_error
		else # Default super workflow.
			deferral_timer_minutes=$deferral_timer_error_minutes
			log_super "Error: Download macOS update/upgrade workflow failed, trying again in ${deferral_timer_minutes} minutes."
			log_status "Pending: Download macOS update/upgrade workflow failed, trying again in ${deferral_timer_minutes} minutes."
			set_auto_launch_deferral
		fi
	fi
}

